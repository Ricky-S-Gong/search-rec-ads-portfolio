---
import { href, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const nodes = lang === 'en'
  ? [
      { label: 'Retrieve', sub: 'Find candidates', x: 17, y: 55, class: 'search' },
      { label: 'Rank', sub: 'Order relevance', x: 50, y: 32, class: 'rec' },
      { label: 'Optimize', sub: 'Balance objectives', x: 83, y: 58, class: 'ads' },
    ]
  : [
      { label: '召回', sub: '找到候选', x: 17, y: 55, class: 'search' },
      { label: '排序', sub: '预测相关性', x: 50, y: 32, class: 'rec' },
      { label: '优化', sub: '平衡多目标', x: 83, y: 58, class: 'ads' },
    ];
---
<div class="star-map" aria-label={lang === 'en' ? 'Retrieval, ranking, and optimization system map' : '召回、排序与优化系统图'}>
  <svg viewBox="0 0 1000 480" aria-hidden="true">
    <path class="orbit orbit-a" d="M 80 295 C 250 60, 690 25, 925 295" />
    <path class="orbit orbit-b" d="M 90 315 C 320 470, 700 455, 915 310" />
    <path class="signal" d="M 170 265 C 325 105, 615 100, 830 278" />
    {Array.from({ length: 34 }, (_, i) => {
      const x = 28 + ((i * 83) % 930);
      const y = 22 + ((i * 137) % 410);
      const r = i % 7 === 0 ? 2.4 : 1.2;
      return <circle cx={x} cy={y} r={r} class="star" />;
    })}
  </svg>
  {nodes.map((node, index) => (
    <a class={`node ${node.class}`} style={`--x:${node.x}%;--y:${node.y}%;--delay:${index * 180}ms`} href={href(`/${lang}/compare/`)}>
      <span class="node-index">0{index + 1}</span>
      <strong>{node.label}</strong>
      <small>{node.sub}</small>
    </a>
  ))}
  <p class="map-note">{lang === 'en' ? 'Signals enter. Decisions leave.' : '信号进入，决策离开。'}</p>
</div>

<style>
  .star-map { position: relative; min-height: 480px; border: 1px solid var(--line); border-radius: 30px; overflow: hidden; background: linear-gradient(145deg, rgba(16,36,61,.72), rgba(7,17,31,.92)); }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orbit { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 5 9; }
  .signal { fill: none; stroke: var(--rec); stroke-width: 2; opacity: .55; stroke-dasharray: 3 12; animation: travel 16s linear infinite; }
  .star { fill: var(--starlight); opacity: .42; }
  .node { position: absolute; left: var(--x); top: var(--y); display: grid; gap: .14rem; min-width: 150px; padding: 1rem; border: 1px solid color-mix(in srgb, var(--node) 55%, var(--line)); border-radius: 14px; background: rgba(7,17,31,.88); text-decoration: none; transform: translate(-50%, -50%); animation: arrive .7s both var(--delay); }
  .node::before { content: ''; position: absolute; inset: -11px; border: 1px solid color-mix(in srgb, var(--node) 30%, transparent); border-radius: 20px; }
  .node:hover { color: white; border-color: var(--node); box-shadow: 0 0 30px color-mix(in srgb, var(--node) 18%, transparent); }
  .node.search { --node: var(--search); } .node.rec { --node: var(--rec); } .node.ads { --node: var(--ads); }
  .node-index { color: var(--node); font: .68rem 'IBM Plex Mono', monospace; }
  .node strong { font: 600 1rem 'Unbounded', sans-serif; }
  .node small { color: var(--muted); }
  .map-note { position: absolute; left: 1rem; bottom: 1rem; color: var(--muted); font: .72rem 'IBM Plex Mono', monospace; }
  @keyframes travel { to { stroke-dashoffset: -150; } }
  @keyframes arrive { from { opacity: 0; transform: translate(-50%, -40%) scale(.94); } }
  @media (max-width: 700px) {
    .star-map { display: grid; min-height: auto; padding: 1rem; gap: 1rem; }
    .star-map svg { opacity: .35; }
    .node { position: relative; left: auto; top: auto; transform: none; min-width: 0; }
    .map-note { position: relative; left: auto; bottom: auto; }
  }
</style>
