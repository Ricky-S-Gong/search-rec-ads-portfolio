---
import { algorithms, href, type Domain, type Lang } from '../data/site';
const { lang, domain } = Astro.props as { lang: Lang; domain: Domain };
const labels = lang === 'en'
  ? { algorithm: 'Method', core: 'Core approach', signals: 'Required data', best: 'Typical business scenario', limitation: 'Main limitation' }
  : { algorithm: '算法', core: '核心方法', signals: '所需数据', best: '典型商业场景', limitation: '主要局限' };
const rows = algorithms.filter((algorithm) => algorithm.domain === domain);
---
<div class="table-wrap" tabindex="0" role="region" aria-label={lang === 'en' ? 'Algorithm comparison table' : '算法对比表'}>
  <table>
    <thead><tr>
      <th>{labels.algorithm}</th><th>{labels.core}</th><th>{labels.signals}</th><th>{labels.best}</th><th>{labels.limitation}</th>
    </tr></thead>
    <tbody>
      {rows.map((algorithm) => (
        <tr>
          <th>
            {algorithm.slug === 'content-based-filtering'
              ? <a href={href(`/${lang}/algorithms/${algorithm.slug}/`)}>{algorithm.name[lang]}</a>
              : algorithm.name[lang]}
            <small>{algorithm.family[lang]}</small>
          </th>
          <td>{algorithm.intuition[lang]}</td><td>{algorithm.requiredSignals[lang]}</td><td>{algorithm.bestFor[lang]}</td><td>{algorithm.limitation[lang]}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 16px; }
  table { width: 100%; min-width: 900px; border-collapse: collapse; background: rgba(12,27,48,.7); }
  th, td { padding: 1.2rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; font-size: clamp(1rem,1.1vw,1.08rem); line-height: 1.55; }
  thead th { color: var(--muted); font: clamp(.78rem,.9vw,.88rem) 'IBM Plex Mono', monospace; text-transform: uppercase; }
  tbody th { width: 230px; font-size: clamp(1.18rem,1.5vw,1.4rem); }
  tbody th a { color: var(--starlight); }
  tbody th small { display: block; margin-top: .4rem; color: var(--muted); font-size: .82rem; font-weight: 400; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
</style>
