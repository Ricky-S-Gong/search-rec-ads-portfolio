---
import KatexMath from './KatexMath.astro';
import FormulaLegend from './FormulaLegend.astro';
import GoodBooksMetricsExplorer from './GoodBooksMetricsExplorer';
import { type Lang } from '../data/site';
import { bestModelsForMetric, formatGoodbooksMetric, goodbooksTableMetrics } from '../lib/goodbooks-metrics';

interface Field { name: string; type: string; range?: [string | number, string | number]; values?: Array<string | boolean>; }
interface Model {
  model: string; model_label: string; model_role: string; owner: string; hyperparameters: Record<string, number>;
  best_validation_rmse: number; rmse: number; mae: number;
  precision_at_5: number; precision_at_10: number; precision_at_20: number;
  recall_at_5: number; recall_at_10: number; recall_at_20: number;
  ndcg_at_5: number; ndcg_at_10: number; ndcg_at_20: number;
  training_seconds: number; inference_seconds: number; evaluated_rating_count: number; evaluated_rating_users: number; evaluated_ranking_users: number;
}
interface Metrics {
  dataset: {
    version: string; seed: number; counts: Record<string, number>; fields: Field[]; explicit_counts: Record<string, number>;
    matrices: Record<string, { shape: number[]; nonzero: number; value_range: number[] }>;
    source: string; license_note: string;
  };
  evaluation: { candidate_policy: string; relevance: string; k_values: number[] };
  models: Model[];
  champion: { model: string; model_label: string; selection_value: number };
}

const { lang, metrics } = Astro.props as { lang: Lang; metrics: Metrics };
const zh = lang === 'zh';
const nav = zh
  ? ['诗歌推荐决策', '数据与切分', '分解原理', '六种算法', '评估口径', '模型结果', '上线实验']
  : ['Decision', 'Data and split', 'MF basics', 'Six models', 'Evaluation', 'Results', 'Experiment'];
const counts = metrics.dataset.counts;
const explicit = metrics.dataset.matrices.explicit;
const implicit = metrics.dataset.matrices.implicit;
const implicitCells = implicit.shape[0] * implicit.shape[1];
const implicitDensity = implicit.nonzero / implicitCells;
const modelDetail = (key: string) => metrics.models.find((model) => model.model === key)!;
const fieldCopy: Record<string, [string, string]> = zh ? {
  user_idx: ['匿名用户的连续下标', '所有模型的用户行'], item_idx: ['图书的连续下标', '所有模型的物品列'],
  rating: ['0 是未评分；1–5 是显式评分', '训练评分预测与 RMSE/MAE'], is_read: ['是否标记为已读', 'SVD++ 隐式历史与相关性'],
  is_reviewed: ['是否写过评论', 'SVD++ 隐式历史'], event_time: ['标准化 UTC 事件时间', '每位用户从过去预测未来'],
  split: ['冻结的数据分区', 'train / validation / test'],
} : {
  user_idx: ['Contiguous anonymous user index', 'User row for every model'], item_idx: ['Contiguous book index', 'Item column for every model'],
  rating: ['0 is unrated; 1–5 are explicit ratings', 'Rating training and RMSE/MAE'], is_read: ['Whether the book was read', 'SVD++ history and relevance'],
  is_reviewed: ['Whether the user wrote a review', 'SVD++ history'], event_time: ['Normalized UTC event time', 'Predict each user’s future from their past'],
  split: ['Frozen data partition', 'train / validation / test'],
};
const pct = (value: number) => `${(value * 100).toFixed(2)}%`;
const modelDetails = [
  {
    key: 'basic_mf', formula: String.raw`\hat r_{ui}=p_u^\top q_i`,
    title: zh ? 'Basic MF：从共同评分中压缩偏好' : 'Basic MF: compress shared rating patterns',
    body: zh ? '在已观测评分上用 SGD 学习用户向量和图书向量。两个向量的点积是预测分数；它是最小的 latent-factor 基线。' : 'SGD learns one vector per user and book from observed ratings only. Their dot product is the predicted score; this is the smallest latent-factor baseline.',
    input: zh ? '输入：仅 train split 中 rating > 0 的显式评分。' : 'Input: explicit train-split ratings only.',
    training: zh ? '训练：逐个 observed triplet 做 SGD 更新。' : 'Training: SGD updates over observed triplets.',
    advantage: zh ? '优势：实现最小，适合作为没有 bias 的可复现基线。' : 'Strength: the smallest reproducible no-bias baseline.',
    serving: zh ? '服务：预计算未见图书分数后直接取 Top-10。' : 'Serving: precompute unseen-book scores and return Top-10.',
    limit: zh ? '没有显式处理用户普遍打高分或图书普遍受欢迎的偏置。' : 'It does not explicitly separate generous raters or broadly liked books from taste.',
  },
  {
    key: 'funksvd', formula: String.raw`\hat r_{ui}=\mu+b_u+b_i+p_u^\top q_i`,
    title: zh ? 'FunkSVD：先解释系统性评分偏置' : 'FunkSVD: explain systematic rating bias first',
    body: zh ? '在 Basic MF 上加入全局、用户和图书 bias。每个 epoch 用 validation RMSE 控制 early stopping，并恢复最佳 checkpoint。' : 'Adds global, user, and book biases to Basic MF. Validation RMSE controls early stopping and the best checkpoint is restored.',
    input: zh ? '输入：与 Basic MF 相同的显式 train ratings。' : 'Input: the same explicit train ratings as Basic MF.',
    training: zh ? '训练：SGD 同时更新 bias 与 latent vectors，并按 validation early stop。' : 'Training: SGD updates biases and latent vectors with validation early stopping.',
    advantage: zh ? '优势：将个人打分习惯与物品总体受欢迎度从偏好中分离。' : 'Strength: separates rating habits and item popularity from taste.',
    serving: zh ? '服务：与 Basic MF 相同的批量打分路径。' : 'Serving: the same batch-scoring path as Basic MF.',
    limit: zh ? '仍然只把显式评分当作训练目标。' : 'It still uses explicit ratings as the training target.',
  },
  {
    key: 'als', formula: String.raw`p_u=(Q_{I_u}^\top Q_{I_u}+\lambda I)^{-1}Q_{I_u}^\top r_u`,
    title: zh ? 'ALS：交替解一系列 ridge regression' : 'ALS: alternate closed-form ridge regressions',
    body: zh ? '固定图书向量时求每位用户的闭式解，再固定用户向量求图书解。只使用 CSR 中存储的显式评分。' : 'Fix item vectors and solve each user’s ridge regression, then reverse the roles. Only stored explicit CSR ratings enter the normal equations.',
    input: zh ? '输入：explicit CSR 的 1–5 非零值。' : 'Input: 1–5 nonzero values from explicit CSR.',
    training: zh ? '训练：交替求解用户与图书的 ridge regression。' : 'Training: alternates user and item ridge-regression solves.',
    advantage: zh ? '优势：每步有确定的线性代数解，训练时间短。' : 'Strength: deterministic linear-algebra updates and short training time.',
    serving: zh ? '服务：完成训练后与其他 MF 一样只需向量打分。' : 'Serving: after training, only vector scoring is needed.',
    limit: zh ? '无 bias 的显式 ALS 可能把评分尺度差异留给 latent factors。' : 'Bias-free explicit ALS can leave rating-scale differences for latent factors to absorb.',
  },
  {
    key: 'nmf', formula: String.raw`\min_{P,Q\ge0}\sum_{(u,i)\in\Omega}(r_{ui}-p_u^\top q_i)^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2)`,
    title: zh ? 'Masked NMF：只允许非负的偏好组合' : 'Masked NMF: non-negative preference components',
    body: zh ? '因子受非负约束，用 multiplicative updates 优化 masked reconstruction loss。未观测 CSR 位置始终是缺失值，不是评分 0。' : 'Factors remain non-negative and multiplicative updates optimize masked reconstruction loss. Unobserved CSR positions always remain missing, never rating zero.',
    input: zh ? '输入：explicit CSR 的 observed ratings 与 mask。' : 'Input: observed explicit-CSR ratings and their mask.',
    training: zh ? '训练：对 masked loss 做 multiplicative updates。' : 'Training: multiplicative updates over masked loss.',
    advantage: zh ? '优势：非负因素更容易作为“贡献”阅读。' : 'Strength: non-negative factors are easier to read as contributions.',
    serving: zh ? '服务：仍采用离线全目录打分，避免在线迭代。' : 'Serving: still uses offline full-catalog scoring, not online iteration.',
    limit: zh ? '非负约束改善可读性，但会限制表达用户对不同因素的相反偏好。' : 'Non-negativity can aid interpretation but restrict opposing latent preferences.',
  },
  {
    key: 'svdpp', formula: String.raw`\hat r_{ui}=\mu+b_u+b_i+q_i^\top\left[p_u+|N(u)|^{-1/2}\sum_{j\in N(u)}y_j\right]`,
    title: zh ? 'SVD++：把已读和评论历史作为隐式信号' : 'SVD++: add read and review history as implicit signal',
    body: zh ? '在 FunkSVD 上加入用户历史向量。N(u) 只由 train 中 is_read、is_reviewed 或 rating > 0 的图书组成，绝不从 validation/test 读取未来行为。' : 'Adds an implicit-history vector to FunkSVD. N(u) contains only train books with is_read, is_reviewed, or rating > 0; validation and test behavior never enters history.',
    input: zh ? '输入：显式评分加 train-only 的已读、评论与评分历史。' : 'Input: explicit ratings plus train-only read, review, and rating history.',
    training: zh ? '训练：SGD 更新 bias、显式因素和历史物品因素。' : 'Training: SGD updates biases, explicit factors, and implicit-history item factors.',
    advantage: zh ? '优势：可利用未评分但已读或评论的行为。' : 'Strength: uses read or review behavior even without a rating.',
    serving: zh ? '服务：用户历史必须先聚合；批量预计算避免在线重复求和。' : 'Serving: aggregate user history before batch scoring to avoid repeated online sums.',
    limit: zh ? '每次更新还要维护历史物品因子，训练成本通常更高。' : 'Updating implicit item factors generally makes training more expensive.',
  },
];
modelDetails.push({
  key: 'bias_aware_als', formula: String.raw`\hat r_{ui}=\mu+b_u+b_i+p_u^\top q_i`,
  title: zh ? 'Bias-aware ALS：先分离评分基线' : 'Bias-aware ALS: factorize rating residuals',
  body: zh ? '额外诊断模型：先从已观测评分估计正则化 bias，再对残差执行 ALS。它展示在表中，但不参加正式冠军选择。' : 'Additional diagnostic: estimate regularized biases from observed ratings, then run ALS on residuals. It is shown in the table but never selects the champion.',
  input: zh ? '输入：explicit CSR 的已观测评分。' : 'Input: observed explicit-CSR ratings.',
  training: zh ? '训练：先交替更新 bias，再交替解残差的用户与图书因子。' : 'Training: alternate bias updates, then alternate residual-factor solves.',
  advantage: zh ? '优势：将评分尺度与 latent interaction 分开诊断。' : 'Strength: separates rating scale from latent interaction for diagnosis.',
  serving: zh ? '服务：恢复 baseline 后对未见图书批量打分。' : 'Serving: restore the baseline, then batch-score unseen books.',
  limit: zh ? '仅作附加诊断，不能改变五个正式模型的选择规则。' : 'It is diagnostic only and cannot alter planned-model selection.',
});
const algorithmSteps: Record<string, { objective: string; update: string; lifecycle: [string, string] }> = {
  basic_mf: { objective: String.raw`\min_{P,Q}\sum_{(u,i)\in\Omega}(r_{ui}-p_u^\top q_i)^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2)`, update: String.raw`e_{ui}=r_{ui}-p_u^\top q_i,\quad p_u\leftarrow p_u+\eta(e_{ui}q_i-\lambda p_u),\quad q_i\leftarrow q_i+\eta(e_{ui}p_u-\lambda q_i)`, lifecycle: [zh ? '初始化：以 seed 生成均值 0、标准差 0.1 的用户/图书因子；无 bias。' : 'Initialize seeded user/item factors from N(0, 0.1); no biases.', zh ? '每个 epoch 随机遍历 observed triplet；validation RMSE 改善至少 min_delta 才保留快照，连续 patience 轮无改善即停。' : 'Shuffle observed triplets each epoch; checkpoint only validation-RMSE gains of min_delta and stop after patience stale epochs.'] },
  funksvd: { objective: String.raw`\min\sum_{(u,i)\in\Omega}(r_{ui}-\mu-b_u-b_i-p_u^\top q_i)^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2+\lVert b_u\rVert_2^2+\lVert b_i\rVert_2^2)`, update: String.raw`e=r_{ui}-\hat r_{ui};\quad b_u,b_i\leftarrow b_u,b_i+\eta(e-\lambda b);\quad p_u,q_i\leftarrow p_u,q_i+\eta(e\,[q_i,p_u]-\lambda[p_u,q_i])`, lifecycle: [zh ? '初始化：训练评分均值为 μ，bias 为 0，因子为 N(0,0.1)。' : 'Initialize μ from train ratings, zero biases, and N(0,0.1) factors.', zh ? '训练/早停与 Basic MF 相同；差别是同一 SGD 步同步更新两个 bias。' : 'Uses Basic-MF training and early stopping, but each SGD step also updates both biases.'] },
  als: { objective: String.raw`\min_{P,Q}\sum_{(u,i)\in\Omega}(r_{ui}-p_u^\top q_i)^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2)`, update: String.raw`p_u=(Q_{I_u}^\top Q_{I_u}+\lambda I)^{-1}Q_{I_u}^\top r_u,\qquad q_i=(P_{U_i}^\top P_{U_i}+\lambda I)^{-1}P_{U_i}^\top r_i`, lifecycle: [zh ? '初始化：seed 控制的 N(0,0.1) 因子；CSR 的稀疏 0 从不当作评分。' : 'Initialize seeded N(0,0.1) factors; sparse zeros are never ratings.', zh ? '每轮先解所有用户、再解所有图书，固定 n_iterations；记录 observed RMSE，不做 validation early stopping。' : 'Each iteration solves all users, then all items, for fixed n_iterations; records observed RMSE without validation early stopping.'] },
  nmf: { objective: String.raw`\min_{P,Q\ge0}\sum_{(u,i)\in\Omega}(r_{ui}-p_u^\top q_i)^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2)`, update: String.raw`P\leftarrow P\odot\frac{RQ}{(M\odot PQ^\top)Q+\lambda P+\epsilon},\qquad Q\leftarrow Q\odot\frac{R^\top P}{(M\odot PQ^\top)^\top P+\lambda Q+\epsilon}`, lifecycle: [zh ? '初始化：seed 控制的 [ε,1] 正数均匀分布，保持 P、Q 非负。' : 'Initialize seeded positive uniform factors in [ε, 1], preserving non-negativity.', zh ? '每轮先更新 P 再更新 Q；每 10 轮或最后一轮检查 observed RMSE，变化小于 tol 或达到 max_iter 即停。' : 'Update P then Q; inspect observed RMSE every ten iterations or last iteration, stopping at tol or max_iter.'] },
  svdpp: { objective: String.raw`\min\sum_{(u,i)\in\Omega}(r_{ui}-\mu-b_u-b_i-q_i^\top[p_u+|N(u)|^{-1/2}\sum_{j\in N(u)}y_j])^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2+\lVert Y\rVert_F^2+\lVert b\rVert_2^2)`, update: String.raw`x_u=p_u+|N(u)|^{-1/2}\sum_{j\in N(u)}y_j;\quad y_j\leftarrow y_j+\eta(e q_i/\sqrt{|N(u)|}-\lambda y_j)`, lifecycle: [zh ? '初始化：μ、零 bias 及 N(0,0.1) 的 p、q、y；N(u) 仅来自 train 的已读、评论或评分图书。' : 'Initialize μ, zero biases, and N(0,0.1) p, q, y; N(u) uses train-only read, review, or rated books.', zh ? '随机 SGD 同时更新 bias、p、q 与每个 y；每 epoch 重建用户表示，按 validation RMSE 早停并恢复最佳快照。' : 'Random SGD updates biases, p, q, and each y; rebuild user representations per epoch and early-stop on validation RMSE.'] },
  bias_aware_als: { objective: String.raw`\min_{\mu,b_u,b_i}\sum_{(u,i)\in\Omega}(r_{ui}-\mu-b_u-b_i)^2+\lambda_b(\lVert b_u\rVert_2^2+\lVert b_i\rVert_2^2)`, update: String.raw`b_u=\frac{\sum_{i\in I_u}(r_{ui}-\mu-b_i)}{|I_u|+\lambda_b},\quad b_i=\frac{\sum_{u\in U_i}(r_{ui}-\mu-b_u)}{|U_i|+\lambda_b},\quad e_{ui}=r_{ui}-\mu-b_u-b_i`, lifecycle: [zh ? '初始化：μ 为观测评分均值，bias 为 0，残差 ALS 因子为 N(0,0.1)。' : 'Initialize μ from observed ratings, zero biases, and residual-ALS factors from N(0,0.1).', zh ? '先交替 bias_iterations 次，再对残差交替 ALS n_iterations 次；冷用户/图书因子置零。' : 'Run bias_iterations alternating bias updates, then n_iterations residual ALS updates; zero cold user/item factors.'] },
};
const population = metrics.models[0];
---

<nav class="goodbooks-nav" aria-label={zh ? '项目章节' : 'Case study sections'}>
  {nav.map((item, index) => <a href={`#gb-${index + 1}`}>{index + 1}. {item}</a>)}
</nav>

<div class="goodbooks-case-study">
  <section id="gb-1" class="goodbooks-step">
    <p class="step-label">01 / {zh ? '产品决策' : 'Product decision'}</p>
    <h2>{zh ? '诗歌推荐决策' : 'Recommendation decision'}</h2>
    <p>{zh ? `设想 Goodreads 的 Poetry discovery shelf：一位已有阅读历史的用户回来后，系统必须从 ${counts.items.toLocaleString()} 本训练目录图书中排除已见项目，再选出十本候选。这里的决策不是“哪种算法最复杂”，而是在相同数据和候选协议下，哪种 latent-factor 模型最值得进入线上实验。` : `Imagine a Goodreads Poetry discovery shelf. When a reader returns with history, the system removes seen books from the ${counts.items.toLocaleString()}-book training catalog and ranks ten candidates. The decision is not which algorithm is most complex; it is which latent-factor model merits an online experiment under one shared protocol.`}</p>
    <div class="observatory" aria-label={zh ? '合成的稀疏矩阵到推荐排序示意图' : 'Synthetic sparse-matrix-to-ranking illustration'}>
      <div><small>{zh ? '观测评分矩阵 R' : 'Observed matrix R'}</small><b class="matrix-grid" aria-hidden="true">{Array.from({ length: 25 }, (_, i) => <i class={i % 4 === 0 || i === 7 || i === 18 ? 'rated' : ''}></i>)}</b></div>
      <span aria-hidden="true">≈</span>
      <div><small>{zh ? '用户因子 P' : 'User factors P'}</small><b class="factor-lines"><i></i><i></i><i></i></b></div>
      <span aria-hidden="true">×</span>
      <div><small>{zh ? '图书因子 Qᵀ' : 'Book factors Qᵀ'}</small><b class="factor-lines wide"><i></i><i></i><i></i></b></div>
      <span aria-hidden="true">→</span>
      <div><small>{zh ? '未见图书 Top-10' : 'Unseen-book Top-10'}</small><b class="rank-lines"><i></i><i></i><i></i></b></div>
    </div>
    <aside><h3>{zh ? '证据边界' : 'Evidence boundary'}</h3><p>{zh ? '离线 NDCG 衡量历史相关项目是否被排在前面；它不等于收藏、阅读、留存或收入。数据没有曝光、点击和当前生产日志，线上影响必须通过未来实验验证。' : 'Offline NDCG measures whether historically relevant books rank near the top. It is not a measure of saves, reading, retention, or revenue; those require future online experimentation.'}</p></aside>
  </section>

  <section id="gb-2" class="goodbooks-step">
    <p class="step-label">02 / {zh ? '冻结数据' : 'Frozen data'}</p>
    <h2>{zh ? '数据与切分' : 'Data and split'}</h2>
    <p>{zh ? `处理后的 ${metrics.dataset.version} 含 ${counts.users.toLocaleString()} 位匿名用户、${counts.items.toLocaleString()} 本图书和 ${counts.interactions.toLocaleString()} 条去重 interaction。原始和处理后的行级记录都不进入网站；只发布以下聚合事实。` : `The processed ${metrics.dataset.version} contains ${counts.users.toLocaleString()} anonymous users, ${counts.items.toLocaleString()} books, and ${counts.interactions.toLocaleString()} deduplicated interactions. Neither raw nor processed rows enter this site; only the aggregate facts below are public.`}</p>
    <div class="data-table"><table><thead><tr><th>{zh ? '字段' : 'Field'}</th><th>{zh ? '类型 / 值域' : 'Type / range'}</th><th>{zh ? '含义' : 'Meaning'}</th><th>{zh ? '用途' : 'Use'}</th></tr></thead><tbody>{metrics.dataset.fields.map((field) => <tr><th><code>{field.name}</code></th><td><code>{field.type}</code><br />{field.range ? field.range.join(' – ') : field.values?.join(' / ')}</td><td>{fieldCopy[field.name][0]}</td><td>{fieldCopy[field.name][1]}</td></tr>)}</tbody></table></div>
    <div class="stat-grid">
      {(['train', 'validation', 'test'] as const).map((split) => <article><span>{split}</span><strong>{counts[split].toLocaleString()}</strong><small>{metrics.dataset.explicit_counts[split].toLocaleString()} {zh ? '条显式评分' : 'explicit ratings'}</small></article>)}
      <article><span>{zh ? '显式 CSR' : 'Explicit CSR'}</span><strong>{explicit.shape.join(' × ')}</strong><small>{explicit.nonzero.toLocaleString()} {zh ? '个非零 1–5 评分' : 'stored 1–5 ratings'}</small></article>
      <article><span>{zh ? '隐式 CSR' : 'Implicit CSR'}</span><strong>{implicit.shape.join(' × ')}</strong><small>{implicit.nonzero.toLocaleString()} {zh ? '个 binary 1' : 'binary ones'}</small></article>
    </div>
    <p>{zh ? <>事件时间按 <KatexMath latex={String.raw`\texttt{date\_updated}\to\texttt{read\_at}\to\texttt{date\_added}\to\texttt{event\_time}`} /> 的顺序取值，优先解析 Goodreads 时间格式、再通用 UTC 解析；无效时间被丢弃。同一用户—图书先按 <KatexMath latex={String.raw`\mathbb{1}[r>0]+\mathbb{1}[\mathrm{read}]+\mathbb{1}[\mathrm{review}]`} /> 取信息最多的记录，同分取较晚时间，仍相同则保留稳定输入顺序。</> : <>Event time follows <KatexMath latex={String.raw`\texttt{date\_updated}\to\texttt{read\_at}\to\texttt{date\_added}\to\texttt{event\_time}`} />: Goodreads parsing first, generic UTC parsing second, and invalid timestamps are dropped. Duplicate user–book rows keep the highest <KatexMath latex={String.raw`\mathbb{1}[r>0]+\mathbb{1}[\mathrm{read}]+\mathbb{1}[\mathrm{review}]`} /> score, then the latest time, then stable input order.</>}</p>
    <p>{zh ? '过滤先重复执行用户（至少 20 条 interaction、10 条评分）和图书（至少 10 条 interaction、3 条评分）k-core，直到行数不变；按固定 seed 最多抽取 5,900 位用户后再执行一次。用户内按事件时间、再按图书下标稳定排序，80/10/10 边界只数显式评分，边界间的隐式行为随时间段进入对应 split；validation/test 的冷图书移除后重新编码。' : 'The pipeline repeatedly applies user (20 interactions, 10 ratings) and item (10 interactions, 3 ratings) k-core rules to a fixed point, samples at most 5,900 users by fixed seed, then repeats k-core. Within each user, it stably sorts by event time then item index; 80/10/10 boundaries count explicit ratings while intervening implicit events stay in their temporal slice. Cold validation/test items are removed before re-encoding.'}</p>
    <p>{zh ? <>矩阵行是匿名用户、列是图书、单元格是用户—图书关系。explicit CSR 只存 train 中 <KatexMath latex={String.raw`r\in[1,5]`} /> 的 117,397 个评分；implicit CSR 在已读、已评论或已评分时存 <KatexMath latex="1" />。后者有 {implicitCells.toLocaleString()} 个位置、{implicit.nonzero.toLocaleString()} 个非零值：密度 {(implicitDensity * 100).toFixed(2)}%，稀疏度 {((1 - implicitDensity) * 100).toFixed(2)}%。</> : <>Rows are anonymous users, columns are books, and cells are user–book relations. Explicit CSR stores only the 117,397 train ratings in <KatexMath latex={String.raw`[1,5]`} />; implicit CSR stores <KatexMath latex="1" /> for read, reviewed, or rated rows. It has {implicitCells.toLocaleString()} possible cells and {implicit.nonzero.toLocaleString()} nonzeros: {(implicitDensity * 100).toFixed(2)}% density and {((1 - implicitDensity) * 100).toFixed(2)}% sparsity.</>}</p>
    <aside><h3>{zh ? '数据限制与许可' : 'Data limitations and license'}</h3><p>{zh ? <>来源为 <a href="https://mengtingwan.github.io/data/goodreads.html" target="_blank" rel="noreferrer">{metrics.dataset.source}</a>，仅限学术使用，不可再分发或商用。公开书架存在曝光偏差，缺失并非随机；纯协同过滤不能解决新用户或新图书冷启动。该结果只覆盖 Poetry 子集及 2007–2017 年行为，不能直接外推到完整 Goodreads 或当前产品。</> : <>Source: <a href="https://mengtingwan.github.io/data/goodreads.html" target="_blank" rel="noreferrer">{metrics.dataset.source}</a>. {metrics.dataset.license_note} Public shelves are exposure-biased, missingness is not random, and pure collaborative filtering cannot solve new-user or new-book cold start. Results cover only the Poetry subset and 2007–2017 behavior, so they do not directly generalize to all Goodreads users or a current product.</>}</p></aside>
  </section>

  <section id="gb-3" class="goodbooks-step">
    <p class="step-label">03 / {zh ? '共同语言' : 'Shared language'}</p>
    <h2>{zh ? '分解原理' : 'MF basics'}</h2>
    <p>{zh ? '评分矩阵极度稀疏，因此不填补所有空格，也不把空格解释为 0 分。模型只在已观测集合 Ω 上最小化误差，学习每位用户的向量 pᵤ 和每本书的向量 qᵢ；点积给出个性化评分预测。' : 'The rating matrix is sparse, so empty cells are neither filled nor interpreted as zero. Models minimize error only on observed set Ω, learn a vector pᵤ per user and qᵢ per book, then use their dot product as a personalized rating prediction.'}</p>
    <div class="formula-grid"><article><KatexMath latex={String.raw`R\approx PQ^\top,\qquad \min_{P,Q}\sum_{(u,i)\in\Omega}(r_{ui}-p_u^\top q_i)^2+\lambda(\lVert P\rVert_F^2+\lVert Q\rVert_F^2)`} display label="Observed-only matrix factorization objective" /><FormulaLegend label={zh ? '符号' : 'Symbols'} entries={[{ latex: String.raw`\Omega`, description: zh ? '已观测评分位置；不包含缺失项。' : 'Observed rating positions; missing cells are excluded.' }, { latex: String.raw`\lambda`, description: zh ? '正则化强度，防止稀疏数据记忆训练集。' : 'Regularization strength against memorizing sparse training data.' }]} /></article><article><h3>{zh ? '二维手算例子' : 'A two-dimensional hand calculation'}</h3><KatexMath latex={String.raw`p_u=[0.6,0.2],\quad q_i=[0.5,0.8],\quad \hat r_{ui}=0.6(0.5)+0.2(0.8)=0.46`} display /><p>{zh ? '这个数字只是合成教学例子。latent dimension 可能捕捉共现模式，但不会自动获得“爱情诗”或“现代主义”等天然语义标签。' : 'This is a synthetic teaching example. Latent dimensions can encode co-occurrence patterns, but do not automatically receive semantic labels such as “love poetry” or “modernism.”'}</p></article></div>
  </section>

  <section id="gb-4" class="goodbooks-step">
    <p class="step-label">04 / {zh ? '六种算法' : 'Six models'}</p>
    <h2>{zh ? '六种算法' : 'Six models'}</h2>
    <p>{zh ? '六个模型共享数据版本、seed、时间切分与评估协议。每项均可用键盘展开；Bias-aware ALS 是完整展示的诊断模型，不参与冠军选择。' : 'All six models share the data version, seed, temporal split, and protocol. Each is keyboard-expandable; Bias-aware ALS is a fully documented diagnostic and never selects the champion.'}</p>
    <div class="model-details">{modelDetails.map((detail, index) => { const model = modelDetail(detail.key); const steps = algorithmSteps[detail.key]; return <details open={index === 0}><summary aria-expanded={index === 0 ? 'true' : 'false'}><span>{detail.title}</span><small>{Object.entries(model.hyperparameters).map(([key, value]) => `${key}=${value}`).join(' · ')} · <b class="detail-state" data-open={zh ? '收起算法' : 'Hide algorithm'} data-closed={zh ? '查看算法' : 'View algorithm'}>{zh ? '查看算法' : 'View algorithm'}</b></small></summary><div><p>{detail.body}</p><h3>{zh ? '预测与目标' : 'Prediction and objective'}</h3><KatexMath latex={detail.formula} display label={`${detail.key} prediction`} /><KatexMath latex={steps.objective} display label={`${detail.key} objective`} /><h3>{zh ? '更新与停止' : 'Updates and stopping'}</h3><KatexMath latex={steps.update} display label={`${detail.key} update`} /><ul class="model-facts"><li>{detail.input}</li><li>{steps.lifecycle[0]}</li><li>{detail.training}</li><li>{steps.lifecycle[1]}</li><li>{zh ? `正则化：artifact 的 reg_lambda=${model.hyperparameters.reg_lambda ?? '—'}。` : `Regularization: artifact reg_lambda=${model.hyperparameters.reg_lambda ?? '—'}.`}</li><li>{detail.advantage}</li><li>{detail.serving}</li></ul><p class="limit"><strong>{zh ? '限制：' : 'Limit: '}</strong>{detail.limit}</p></div></details>; })}</div>
    <p>{zh ? <>共同服务规则：在 train catalog 的未见、可用图书上计算 raw score，分数降序，<KatexMath latex={String.raw`\texttt{item\_idx}`} /> 升序打破同分，返回 Top-10；历史不足或空结果回退 editorial/popularity。</> : <>Shared serving rule: score unseen, available train-catalog books by raw score, break ties by ascending <KatexMath latex={String.raw`\texttt{item\_idx}`} />, return Top-10, and fall back to editorial/popularity for insufficient history or empty results.</>}</p>
  </section>

  <section id="gb-5" class="goodbooks-step">
    <p class="step-label">05 / {zh ? '评估口径' : 'Evaluation'}</p>
    <h2>{zh ? '评估口径' : 'Evaluation'}</h2>
    <div class="formula-grid"><article><h3>{zh ? '评分预测' : 'Rating prediction'}</h3><p>{zh ? '只评估 test 中 rating > 0 的行；预测仅在 RMSE/MAE 计算时截断到 1–5。' : 'Only test rows with rating > 0 are evaluated; predictions are clipped to 1–5 only for RMSE/MAE.'}</p><KatexMath latex={String.raw`\mathrm{RMSE}=\sqrt{\frac1N\sum(\tilde r_{ui}-r_{ui})^2},\qquad \mathrm{MAE}=\frac1N\sum|\tilde r_{ui}-r_{ui}|`} display /></article><article><h3>{zh ? '排序定义' : 'Ranking definitions'}</h3><p>{zh ? '候选是完整 train catalog 去除已见图书，无负采样；相关集合包含 test 中高分或未评分但已读的有效候选。' : 'Candidates are the full train catalog minus seen books, with no negative sampling; relevant items are valid test candidates with high ratings or unread ratings marked read.'}</p><KatexMath latex={String.raw`L_u^N=\mathrm{TopN}(u),\quad G_u=\{i:r_{ui}\ge4\ \lor\ (r_{ui}=0\land\mathrm{read}_{ui})\}`} display /><KatexMath latex={String.raw`\mathrm{P@N}_u=\frac{|L_u^N\cap G_u|}{N},\quad \mathrm{R@N}_u=\frac{|L_u^N\cap G_u|}{|G_u|}`} display /><KatexMath latex={String.raw`\mathrm{DCG@N}_u=\sum_{j=1}^{N}\frac{\mathrm{rel}_{uj}}{\log_2(j+1)},\quad \mathrm{IDCG@N}_u=\sum_{j=1}^{\min(N,|G_u|)}\frac1{\log_2(j+1)},\quad \mathrm{NDCG@N}_u=\frac{\mathrm{DCG@N}_u}{\mathrm{IDCG@N}_u}`} display /></article></div>
    <p>{zh ? 'P@N 衡量前 N 个位置的命中密度，R@N 衡量相关图书被找回的比例，NDCG@N 额外奖励更靠前的命中。P@N 始终除以 N；没有相关图书时 Recall/NDCG 为 0，IDCG=0 时 NDCG 也为 0。只纳入至少有一个有效相关候选的用户，所有模型在该固定人群上做 macro average。' : 'P@N measures hit density, R@N measures relevant-item recovery, and NDCG@N rewards earlier hits. P@N always divides by N; no relevant items or IDCG=0 produces Recall/NDCG of 0. Every model uses the same users with at least one valid relevant candidate and macro-averages user metrics.'}</p>
    <p>{zh ? `指标报告 K=${metrics.evaluation.k_values.join(' / ')}。RMSE/MAE 在 ${population.evaluated_rating_count.toLocaleString()} 条显式 test 评分、${population.evaluated_rating_users.toLocaleString()} 位用户上计算；只纳入至少有一个有效 relevant candidate 的 ${population.evaluated_ranking_users.toLocaleString()} 位 ranking users，因此所有模型在同一群体上比较 macro Precision、Recall 和 NDCG。` : `Metrics report K=${metrics.evaluation.k_values.join(' / ')}. RMSE/MAE use ${population.evaluated_rating_count.toLocaleString()} explicit test ratings from ${population.evaluated_rating_users.toLocaleString()} users; only ${population.evaluated_ranking_users.toLocaleString()} users with a valid relevant candidate enter the macro Precision, Recall, and NDCG population, so every model uses the same users.`}</p>
  </section>

  <section id="gb-6" class="goodbooks-step">
    <p class="step-label">06 / {zh ? '模型结果' : 'Results'}</p>
    <h2>{zh ? '模型结果' : 'Results'}</h2>
    <p>{zh ? `线上候选是五个正式模型中 NDCG@10 最高的 ${metrics.champion.model_label}（${pct(metrics.champion.selection_value)}）。这不是“所有维度绝对最优”的宣言：RMSE、Recall、训练成本和目录分布回答的是不同问题。` : `The online candidate is ${metrics.champion.model_label}, the planned model with the highest NDCG@10 (${pct(metrics.champion.selection_value)}). This is not a claim of universal superiority: RMSE, Recall, training cost, and catalog distribution answer different questions.`}</p>
    <GoodBooksMetricsExplorer client:visible lang={lang} models={metrics.models} champion={metrics.champion.model} />
    <p class="table-scroll-hint">{zh ? '横向滑动查看更多指标；每列绿色 ★ 为该列最佳，允许并列。' : 'Scroll horizontally for more metrics; green ★ marks every tied best value in a column.'}</p>
    <div class="comparison-table" role="region" tabindex="0" aria-label={zh ? '六模型完整指标表' : 'Complete six-model metrics table'}><table><thead><tr><th rowspan="2">{zh ? '模型' : 'Model'}</th><th colspan="2">{zh ? '评分 ↓' : 'Rating ↓'}</th><th colspan="3">Precision ↑</th><th colspan="3">Recall ↑</th><th colspan="3">NDCG ↑</th><th colspan="2">{zh ? '成本 ↓' : 'Cost ↓'}</th></tr><tr>{goodbooksTableMetrics.map((metric, index) => <th class={index > 0 && metric.group !== goodbooksTableMetrics[index - 1].group ? 'group-start' : ''}>{metric.label[zh ? 1 : 0]}</th>)}</tr></thead><tbody>{metrics.models.map((model) => <tr class={model.model_role === 'additional diagnostic' ? 'is-diagnostic' : ''}><th>{model.model_label}{model.model === metrics.champion.model && <small>{zh ? '离线候选' : 'Candidate'}</small>}{model.model_role === 'additional diagnostic' && <small>{zh ? '诊断' : 'Diagnostic'}</small>}</th>{goodbooksTableMetrics.map((metric, index) => { const best = bestModelsForMetric(metrics.models, metric.key).includes(model.model); return <td class:list={[index > 0 && metric.group !== goodbooksTableMetrics[index - 1].group && 'group-start', best && 'is-best']} aria-label={`${metric.label[zh ? 1 : 0]} ${formatGoodbooksMetric(metric.key, model[metric.key], zh)}${best ? (zh ? '，最佳' : ', best') : ''}`}>{best && <span aria-hidden="true">★ </span>}{formatGoodbooksMetric(metric.key, model[metric.key], zh)}{best && <span class="sr-only">{zh ? '最佳' : 'best'}</span>}</td>; })}</tr>)}</tbody></table></div>
  </section>

  <section id="gb-7" class="goodbooks-step">
    <p class="step-label">07 / {zh ? '上线实验' : 'Experiment'}</p>
    <h2>{zh ? '上线实验' : 'Experiment'}</h2>
    <div class="serving-flow" aria-label={zh ? '生产推荐流程示意' : 'Production recommendation flow'}><span>{zh ? '离线训练与批量打分' : 'Offline training and batch scoring'}</span><i aria-hidden="true">→</i><span>{zh ? '过滤已见与不可用图书' : 'Filter seen and unavailable books'}</span><i aria-hidden="true">→</i><span>{zh ? '返回 Top-10' : 'Return Top-10'}</span><i aria-hidden="true">→</i><span>{zh ? '空结果回退 editorial/popularity' : 'Fallback to editorial/popularity'}</span></div>
    <aside><h3>{zh ? '这个仓库的边界' : 'Repository boundary'}</h3><p>{zh ? '这里只展示 production blueprint；仓库没有线上推理服务、实时 Goodreads API、曝光日志或真实 A/B 结果。' : 'This is a production blueprint only: the repository has no online inference service, real-time Goodreads API, exposure logs, or real A/B-test results.'}</p></aside>
    <div class="rollout-grid"><article><span>0</span><h3>{zh ? '离线与 shadow gate' : 'Offline and shadow gate'}</h3><p>{zh ? '校验 checksum、schema、non-finite score、seen-item leakage、空结果和 artifact 新鲜度；在 shadow traffic 中核对延迟、结果数量和日志完整性，只生成不展示。' : 'Validate checksums, schema, non-finite scores, seen-item leakage, empty results, and artifact freshness; use shadow traffic to verify latency, result counts, and log completeness without exposure.'}</p></article><article><span>1</span><h3>5% canary</h3><p>{zh ? '至少 10 次 Poetry interaction 的合格用户按匿名 user ID stable hash 分流：5% champion，95% editorial/popularity control。48 小时只看错误、P95 latency、空列表和负反馈护栏。' : 'Eligible users have at least 10 Poetry interactions and stable-hash assignment: 5% champion and 95% editorial/popularity control. For 48 hours, inspect only errors, P95 latency, empty lists, and negative-feedback guardrails.'}</p></article><article><span>2</span><h3>50/50 A/B test</h3><p>{zh ? '用户级 sticky assignment；对照组使用 editorial/popularity，实验组使用离线冠军。主指标是首次合格曝光后 7 天内至少收藏一本推荐图书的用户比例。' : 'Use user-level sticky assignment: editorial/popularity control versus the offline champion. The primary metric is the share of users who save at least one recommended book within seven days of their first eligible exposure.'}</p></article><article><span>3</span><h3>{zh ? '放量与长期 holdout' : 'Ramp and long-term holdout'}</h3><p>{zh ? '成功后升至 95% treatment、保留 5% holdout 观察 30 日阅读启动；无报警后再升至 100%，同时保留 feature flag 和上一版本回滚。' : 'After success, ramp to 95% treatment and retain a 5% holdout for 30-day reading starts; move to 100% only without alerts, keeping a feature flag and previous artifact for rollback.'}</p></article></div>
    <div class="ab-grid"><article><h3>{zh ? '预注册分析与次级指标' : 'Pre-registered analysis and secondary metrics'}</h3><ul><li>{zh ? '双侧 α=0.05、80% power、5% relative MDE；按 control baseline 先算样本量。' : 'Two-sided α=0.05, 80% power, and a 5% relative MDE; calculate sample size from the control baseline first.'}</li><li>{zh ? '次级指标：详情 CTR、每用户收藏本数、30 日阅读启动、评论/评分率、目录覆盖与长尾曝光。' : 'Secondary metrics: detail CTR, saves per user, 30-day reading starts, review/rating rate, catalog coverage, and long-tail exposure.'}</li><li>{zh ? '至少运行两个完整自然周，停止入组后等待 7 天使主指标成熟；检查 sample-ratio mismatch、事件缺失和组间曝光不平衡。' : 'Run at least two complete calendar weeks, then wait seven days after enrollment closes; check sample-ratio mismatch, event loss, and exposure imbalance.'}</li></ul></article><article><h3>{zh ? '成功、切片与回滚' : 'Success, cohorts, and rollback'}</h3><ul><li>{zh ? '主指标显著提升且 point estimate ≥ +5% relative lift；不显著即为 inconclusive，不能以次级指标替代。' : 'The primary metric must be significantly positive with at least +5% relative lift; otherwise the result is inconclusive and secondary metrics cannot replace it.'}</li><li>{zh ? '10–19、20–49、50+ interaction cohort 仅作描述性切片，不单独判定胜负。' : 'Use 10–19, 20–49, and 50+ interaction cohorts descriptively, not as separate win decisions.'}</li><li>{zh ? 'P95 latency 不恶化超过 10%；空列表 ≤0.5%；seen-item leakage 必须为 0；任一硬护栏失败立即回滚。' : 'P95 latency cannot regress by more than 10%; empty lists must stay at or below 0.5%; seen-item leakage must remain zero; any hard guardrail failure rolls back.'}</li></ul></article></div>
    <div class="experiment-spec"><article><h3>{zh ? '目标与口径' : 'Goal and metric'}</h3><p>{zh ? '主指标为首次合格曝光后 7 天内至少收藏一本推荐书的用户数，除以已完成 7 天窗口的合格曝光用户数；单位是用户。次级指标逐项报告 7 日详情点击用户率、每用户收藏数、30 日阅读启动率、评论/评分率、目录覆盖率和长尾曝光占比。护栏为 P95 延迟、错误率、空列表率、已见泄漏和隐藏/负反馈率。' : 'The primary metric is users who save at least one recommended book within seven days of first eligible exposure divided by eligible exposed users with a mature seven-day window; the unit is user. Secondary metrics are seven-day detail-click user rate, saves per user, 30-day reading starts, review/rating rate, catalog coverage, and long-tail exposure. Guardrails are P95 latency, error rate, empty lists, seen-item leakage, and hide/negative-feedback rate.'}</p></article><article><h3>{zh ? '假设与样本量' : 'Hypothesis and sample size'}</h3><p>{zh ? '这是预注册方案，不是线上结果：H₀ 为 Δ=0，Hₐ 为 Δ≠0，双侧 α=0.05、power=0.80，报告 95% CI。绝对 MDE 为 δabs=p₁−p₀，相对 MDE 为 δrel=(p₁−p₀)/p₀；+5% 是待产品负责人用历史 baseline、机会成本和上线价值确认的初始假设。' : 'This is a pre-registered plan, not an online result: H₀ is Δ=0, Hₐ is Δ≠0, with two-sided α=0.05, power=0.80, and 95% CIs. Absolute MDE is δabs=p₁−p₀ and relative MDE is δrel=(p₁−p₀)/p₀; +5% is an initial assumption to validate against baseline, opportunity cost, and launch value.'}</p><KatexMath latex={String.raw`n\approx\frac{\left[z_{1-\alpha/2}\sqrt{2\bar p(1-\bar p)}+z_{1-\eta}\sqrt{p_0(1-p_0)+p_1(1-p_1)}\right]^2}{(p_1-p_0)^2},\quad \bar p=\frac{p_0+p_1}{2}`} display /><KatexMath latex={String.raw`n_{\mathrm{continuous}}\approx\frac{2(z_{1-\alpha/2}+z_{1-\eta})^2\sigma^2}{\delta^2}`} display /></article><article><h3>{zh ? '设计与判定' : 'Design and decision'}</h3><p>{zh ? '仅纳入至少 10 次 Poetry interaction 且候选非空的用户，排除内部、测试、机器人及无效埋点。匿名用户 ID stable hash 做 50/50 sticky assignment：control 为 editorial/popularity，treatment 为 Basic MF。记录 assignment、eligibility、request、候选、过滤、曝光、点击、收藏、阅读、负反馈、延迟和 fallback。入组量按触发率、数据损耗和成熟窗口调整；运行 ceil(2n/每日成熟触发用户数) 天且至少两个完整自然周，停止入组后再等 7 天，30 日指标单独成熟。' : 'Include only users with at least 10 Poetry interactions and nonempty candidates; exclude internal, test, bot, and invalid-instrumentation traffic. Stable-hash anonymous user IDs into 50/50 sticky control editorial/popularity versus Basic MF treatment. Log assignment, eligibility, request, candidates, filtering, exposure, click, save, reading, negative feedback, latency, and fallback. Adjust enrollment for trigger rate, data loss, and maturity; run ceil(2n/daily mature triggers) days and at least two full weeks, then wait seven days after enrollment closes and mature 30-day metrics separately.'}</p><p>{zh ? '检查 SRM、事件缺失、随机化前属性平衡、重复曝光、极端用户、周内效应与 novelty 衰减；10–19、20–49、50+ 历史长度仅作描述性切片。只有主指标 95% CI 下界大于 0、点估计达到预注册 MDE 且硬护栏通过才放量；不显著是 inconclusive，不是等效。' : 'Check SRM, event loss, pre-randomization balance, repeat exposure, extreme users, weekday effects, and novelty decay; 10–19, 20–49, and 50+ history slices are descriptive only. Ramp only if the primary metric lower 95% CI is above 0, the point estimate reaches pre-registered MDE, and hard guardrails pass; non-significance is inconclusive, not equivalence.'}</p></article></div>
    <aside><h3>{zh ? '持续监控' : 'Continuous monitoring'}</h3><p>{zh ? '数据层看交互量、空值、分布和新鲜度；模型层看 score、coverage、长尾、重复和 fallback；系统层看 P50/P95、错误和产物年龄；产品层看 7 日收藏、详情点击、30 日阅读启动与负反馈。线上事件不回写为离线 test 指标。' : 'Monitor interaction volume, nulls, distributions, and freshness; score, coverage, tail exposure, repeats, and fallback; P50/P95, errors, and artifact age; then seven-day saves, detail clicks, 30-day reading starts, and negative feedback. Online events never become offline test metrics.'}</p></aside>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.model-details details').forEach((details) => {
    const summary = details.querySelector('summary');
    const state = details.querySelector<HTMLElement>('.detail-state');
    const sync = () => {
      summary?.setAttribute('aria-expanded', String(details.open));
      if (state) state.textContent = (details.open ? state.dataset.open : state.dataset.closed) ?? '';
    };
    sync();
    details.addEventListener('toggle', sync);
  });
</script>

