---
import { Code } from 'astro:components';
import KatexMath from './KatexMath.astro';
import FormulaLegend from './FormulaLegend.astro';
import MovieLensFlow from './MovieLensFlow.astro';
import MovieLensExplorer from './MovieLensExplorer';
import { href, type Lang } from '../data/site';
import metrics from '../../public/artifacts/movielens/metrics.json';
import profileArtifact from '../../public/artifacts/movielens/profile.json';
import comparisons from '../../public/artifacts/movielens/comparisons.json';
import samples from '../../public/artifacts/movielens/samples.json';

const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';
const profile = profileArtifact.profile;
const user = metrics.models.find((model) => model.key === 'user-cf')!;
const item = metrics.models.find((model) => model.key === 'item-cf')!;
const popularity = metrics.baselines.bayesianPopularity;
const userValidation = comparisons.validation.find((entry) => entry.mode === 'user')!;
const itemValidation = comparisons.validation.find((entry) => entry.mode === 'item')!;
const userSelected = userValidation.candidates.find((entry) => JSON.stringify(entry.params) === JSON.stringify(userValidation.selected)) ?? userValidation.candidates[0];
const itemSelected = itemValidation.candidates.find((entry) => JSON.stringify(entry.params) === JSON.stringify(itemValidation.selected)) ?? itemValidation.candidates[0];
const selectedValidationRows = [
  { group: userValidation, candidate: userSelected },
  { group: itemValidation, candidate: itemSelected },
];
const legacyUser = comparisons.legacyV3.find((model) => model.key === 'user-cf')!;
const legacyItem = comparisons.legacyV3.find((model) => model.key === 'item-cf')!;
const paired = metrics.diagnostics.pairedUserCfMinusPopularity.ndcgAt10;
const head = metrics.diagnostics.relevantItemHeadConcentration;
const itemTieStats = item.system.rankingTieStats!;
const itemFiveStarOnlyShare = item.system.top10FiveStarOnlyEvidenceShare ?? 0;
const legacyItemTieStats = legacyItem.system.rankingTieStats;
const split = metrics.splitCounts;
const splitTotal = split.trainRatings + split.validationRatings + split.testRatings;
const bayesianExamples = popularity.examples;
const popularityHitUsers = Math.round(popularity.test.hit_rate_at_10 * popularity.test.users);
const userHitUsers = Math.round(user.test.hit_rate_at_10 * user.test.users);
const itemHitUsers = Math.round(item.test.hit_rate_at_10 * item.test.users);
const accuracyWinner = [
  { label: 'Popularity', value: popularity.test.ndcg_at_10 },
  { label: 'User-CF', value: user.test.ndcg_at_10 },
  { label: 'Item-CF', value: item.test.ndcg_at_10 },
].sort((a,b)=>b.value-a.value)[0];
const fieldCopy: Record<string, { meaning: string; use: string }> = zh ? {
  'ratings.user_id': { meaning: '匿名用户标识', use: '构建用户行、按用户时间切分' },
  'ratings.movie_id': { meaning: '被评分电影标识', use: '连接电影表、构建物品列' },
  'ratings.rating': { meaning: '1–5 星显式反馈', use: '拟合相似度；测试时 4 星或 5 星定义相关' },
  'ratings.timestamp': { meaning: '评分发生时间（Unix 秒）', use: '在用户内部按过去预测未来' },
  'movies.movie_id': { meaning: '电影主键', use: '连接评分与元数据' },
  'movies.title': { meaning: '片名与上映年份', use: '展示和解释，不进入分数' },
  'movies.genres': { meaning: '竖线分隔的类型标签', use: '页面解释；当前 CF 不使用' },
} : {
  'ratings.user_id': { meaning: 'Anonymous user identifier', use: 'Build user rows and split within user' },
  'ratings.movie_id': { meaning: 'Rated-movie identifier', use: 'Join metadata and build item columns' },
  'ratings.rating': { meaning: 'Explicit 1–5 star feedback', use: 'Fit similarities; four or five stars define test relevance' },
  'ratings.timestamp': { meaning: 'Rating time in Unix seconds', use: 'Predict future activity from past activity' },
  'movies.movie_id': { meaning: 'Movie primary key', use: 'Join ratings to metadata' },
  'movies.title': { meaning: 'Title and release year', use: 'Display and explanation; not scored' },
  'movies.genres': { meaning: 'Pipe-delimited genre labels', use: 'Page explanation; unused by current CF' },
};
const pct = (value: number, digits = 1) => `${(value * 100).toFixed(digits)}%`;
const signedPoints = (value: number, digits = 2) => `${value >= 0 ? '+' : ''}${(value * 100).toFixed(digits)} pp`;
const year = (timestamp: number) => new Date(timestamp * 1000).getUTCFullYear();
const nav = zh
  ? ['业务问题','数据','探索性数据分析','信号表示与归一化','算法选择','候选方法对比','结果：离线代理与用户结果','评估与下一步','交互实验台']
  : ['Business problem','Data','Exploratory data analysis','Signal representation and normalization','Algorithm selection','Candidate method comparison','Results: offline proxies vs user outcomes','Evaluation and next steps','Interactive experiment lab'];
const copy = zh ? {
  problemTitle:'1. 业务问题：从历史评分生成个性化候选',
  problem:'设想一个电影流媒体平台：当用户已经留下评分时，首页需要从尚未评分的完整目录中选择 10 部候选。热门榜可以服务所有人，却不能利用个人偏好；本项目比较它与两类邻域协同过滤。',
  objective:'离线目标：在每位用户未来给出 4–5 星的电影中，让相关候选尽量靠前，同时审计目录覆盖和长尾曝光。MovieLens 没有曝光、点击或观看日志，因此不能测量 CTR、观看时长、留存、收入或因果增量。',
  dataTitle:'2. 数据：可用信号与边界',
  data:'MovieLens 1M 是 GroupLens 发布的稳定基准。每行表示一位用户在某个时间对一部电影给出的 1–5 星评分；电影表还提供标题与类型。实验只用评分与时间学习协同关系，类型仅用于解释和未来内容模型。',
  edaTitle:'3. 探索性数据分析：稀疏性决定模型与评估',
  eda:'只保留会改变建模决策的证据：评分倾向、用户与电影活跃度、矩阵稀疏性和热门度集中。',
  representationTitle:'4. 信号表示与归一化',
  representation:'评分已经共享 1–5 的量纲，因此不需要 Spotify 项目中的 StandardScaler 或 MinMaxScaler。真正需要校正的是用户打分习惯、低支持度相似度和缺失值的语义。',
  algorithmTitle:'5. 算法选择',
  algorithm:'方法范围由当前显式评分信号与 Top-10 学习目标决定。热门度既是最低成本基线也是兜底；User-CF 和 Item-CF 都使用用户与电影偏置后的评分残差，避免把普遍高分或全五星历史误当成区分候选的证据。',
  comparisonTitle:'6. 候选方法对比',
  comparison:'训练、验证、相关性阈值、完整目录候选和 K=10 保持一致。先正交比较 k、最小支持度与收缩，再为 Validation 前三名比较 min_neighbors；Test 不参与选择。',
  resultTitle:'7. 结果：离线代理指标与用户结果分离',
  result:'下表报告历史评分上的离线排序代理、目录分布指标与工程测量。它们不是线上用户效果。',
  evaluationTitle:'8. 评估、限制与下一步',
  evaluation:'每位用户按时间排序后采用 80/10/10 切分：训练集拟合候选配置，验证集选参，训练加验证重拟合，最终测试只评一次。4 星或 5 星评分视为相关，候选为训练目录中所有未见电影。',
  labTitle:'9. 交互实验台',
  lab:'选择固定的低、中、高活跃用户，对比三种方法的 Top-5；需要时展开 Top-10。所有列表、命中和邻居证据均来自完整实验的预计算产物。',
} : {
  problemTitle:'1. Business problem: generate personalized candidates from ratings',
  problem:'Consider a movie-streaming homepage. Once a viewer has rating history, the system must select ten candidates from the full catalog they have not rated. Popularity can serve everyone, but it cannot use individual taste; this study compares it with two neighborhood collaborative-filtering methods.',
  objective:'Offline objective: rank movies the viewer later rates 4–5 stars near the top, while auditing catalog coverage and long-tail exposure. MovieLens has no impression, click, or watch log, so it cannot measure CTR, watch time, retention, revenue, or causal lift.',
  dataTitle:'2. Data: available signals and boundaries',
  data:'MovieLens 1M is a stable GroupLens benchmark. Each row is a 1–5 star rating from one user for one movie at one timestamp; movie metadata adds titles and genres. The experiment uses ratings and time to learn collaborative relations. Genres support explanation and a future content model, not the current scores.',
  edaTitle:'3. Exploratory data analysis: sparsity shapes modeling and evaluation',
  eda:'The audit keeps only evidence that changes a decision: rating tendency, user and movie activity, matrix sparsity, and popularity concentration.',
  representationTitle:'4. Signal representation and normalization',
  representation:'Ratings already share a 1–5 unit, so the StandardScaler and MinMaxScaler used in the Spotify project are not appropriate here. The required corrections concern rating habits, low-support similarity, and the meaning of missing entries.',
  algorithmTitle:'5. Algorithm selection',
  algorithm:'Method scope follows the explicit-rating signal and Top-10 objective. Popularity is both the lowest-cost baseline and fallback. User-CF and Item-CF operate on user–movie bias residuals so generally high scores and all-five-star histories do not collapse candidate distinctions.',
  comparisonTitle:'6. Candidate method comparison',
  comparison:'Training data, validation data, relevance threshold, full-catalog candidates, and K=10 stay fixed. An orthogonal grid first compares k, minimum support, and shrinkage; min_neighbors is then compared for the top three validation configurations. Test never selects a parameter.',
  resultTitle:'7. Results: offline proxies versus user outcomes',
  result:'The evidence below contains offline ranking proxies, catalog-distribution metrics, and engineering measurements from historical ratings. None is an online user effect.',
  evaluationTitle:'8. Evaluation, limitations, and next steps',
  evaluation:'Ratings are ordered within each user and split 80/10/10: train fits candidate configurations, validation selects them, train plus validation is refit, and final test is evaluated once. Four- or five-star ratings are relevant; candidates are every unseen movie in the fitted catalog.',
  labTitle:'9. Interactive experiment lab',
  lab:'Choose fixed low-, medium-, and high-activity users and compare three Top-5 lists; expand to Top-10 when needed. Every list, hit, and neighbor explanation comes from precomputed full-experiment artifacts.',
};
const inspectCode = `ratings, movies = load_movielens(data_dir)
train, validation, test = per_user_temporal_split(ratings)
# One rating row: user_id, movie_id, rating, timestamp`;
const normalizationCode = `baseline = global_mean + user_bias + movie_bias
residual = rating - baseline
similarity = cosine(residual_vectors)
shrunk = similarity * support / (support + shrinkage)
# Missing ratings stay missing; they are never filled with zero.`;
const evaluationCode = `relevant = test.rating >= 4
candidates = fitted_catalog - seen_movies
validation -> select configuration
train + validation -> refit -> test once`;
const userSimilarityFormula = String.raw`c(u,v)=\frac{\sum_{i\in I_{uv}} e_{ui}e_{vi}}{\sqrt{\sum_{i\in I_u}e_{ui}^2}\sqrt{\sum_{i\in I_v}e_{vi}^2}},\quad s(u,v)=c(u,v)\frac{n_{uv}}{n_{uv}+\lambda}`;
const itemSimilarityFormula = String.raw`c(i,j)=\frac{\sum_{u\in U_{ij}} e_{ui}e_{uj}}{\sqrt{\sum_{u\in U_i}e_{ui}^2}\sqrt{\sum_{u\in U_j}e_{uj}^2}},\quad s(i,j)=c(i,j)\frac{n_{ij}}{n_{ij}+\lambda}`;
const userFormula = String.raw`\hat r_{ui}=b_{ui}+\frac{\sum_{v\in N_k(u,i)}s(u,v)(r_{vi}-b_{vi})}{\sum_{v\in N_k(u,i)}|s(u,v)|}`;
const itemFormula = String.raw`\hat r_{ui}=b_{ui}+\frac{\sum_{j\in N_k(i,u)}s(i,j)(r_{uj}-b_{uj})}{\sum_{j\in N_k(i,u)}|s(i,j)|}`;
const bayesianFormula = String.raw`B_i=\frac{n_i\bar r_i+m\mu}{n_i+m}`;
const hitFormula = String.raw`\mathrm{HitRate@10}=\frac{1}{|U|}\sum_{u\in U}\mathbf{1}[R_u^{10}\cap T_u\neq\varnothing]`;
const recallFormula = String.raw`\mathrm{Recall@10}=\frac{1}{|U|}\sum_{u\in U}\frac{|R_u^{10}\cap T_u|}{|T_u|}`;
const ndcgFormula = String.raw`\mathrm{NDCG@10}=\frac{1}{|U|}\sum_{u\in U}\frac{\sum_{p=1}^{10}\frac{rel_{u,p}}{\log_2(p+1)}}{\mathrm{IDCG}_{u,10}}`;
const commands = `.venv/bin/python research/run_python_tests.py
npm test
MPLCONFIGDIR=/tmp/movielens-mpl .venv/bin/python research/movielens-cf/run_experiment.py --smoke --output /tmp/movielens-smoke
MPLCONFIGDIR=/tmp/movielens-mpl .venv/bin/python research/movielens-cf/run_experiment.py
npm run check
npm run build`;
---

<nav class="case-nav" aria-label={zh ? 'MovieLens 项目章节' : 'MovieLens case-study sections'}>{nav.map((label,index)=><a href={`#ml-${index+1}`}>{index+1}. {label}</a>)}</nav>
<div class="case-study">
  <section id="ml-1" class="case-step">
    <p class="step-label">Step 1</p><h2>{copy.problemTitle}</h2><p>{copy.problem}</p>
    <aside><h3>{zh ? '决策对象' : 'Decision surface'}</h3><p>{zh ? '目标用户是已有评分历史的回访用户；产品输出是首页个性化候选，不是最终播放概率。' : 'The target is a returning viewer with rating history; the output is a personalized homepage candidate set, not a watch probability.'}</p></aside>
    <div class="output"><strong>{zh ? '成功标准与边界' : 'Success criteria and boundary'}</strong><p>{copy.objective}</p></div>
  </section>

  <section id="ml-2" class="case-step">
    <p class="step-label">Step 2</p><h2>{copy.dataTitle}</h2><p>{copy.data}</p>
    <div class="code-block"><Code code={inspectCode} lang="python" theme="github-dark" /></div>
    <div class="output"><strong>{zh ? '数据审计结果' : 'Data audit result'}</strong><p>{profile.ratings.toLocaleString()} {zh ? '条评分，' : 'ratings, '}{profile.users.toLocaleString()} {zh ? '位用户，' : 'users, '}{profile.ratedMovies.toLocaleString()} {zh ? `部有评分电影；时间覆盖 ${year(profile.timestampRange[0])}–${year(profile.timestampRange[1])}。` : `rated movies, spanning ${year(profile.timestampRange[0])}–${year(profile.timestampRange[1])}.`}</p></div>
    <div class="method-table" role="region" tabindex="0" aria-label={zh ? 'MovieLens 数据字典' : 'MovieLens data dictionary'}><table><thead><tr><th>{zh?'表':'Table'}</th><th>{zh?'字段':'Field'}</th><th>dtype</th><th>{zh?'真实示例':'Actual example'}</th><th>{zh?'业务含义':'Meaning'}</th><th>{zh?'算法用途':'Algorithm use'}</th></tr></thead><tbody>{profile.fields.map((field)=><tr><td>{field.table}</td><th>{field.name}</th><td><code>{field.dtype}</code></td><td><code>{String(field.example)}</code></td><td>{fieldCopy[`${field.table}.${field.name}`].meaning}</td><td>{fieldCopy[`${field.table}.${field.name}`].use}</td></tr>)}</tbody></table></div>
    <div class="split-grid">
      <article><span>Train · {pct(split.trainRatings/splitTotal)}</span><strong>{split.trainRatings.toLocaleString()}</strong><p>{zh?'拟合验证候选。':'Fit validation candidates.'}</p></article>
      <article><span>Validation · {pct(split.validationRatings/splitTotal)}</span><strong>{split.validationRatings.toLocaleString()}</strong><p>{zh?'选择成组超参数。':'Select grouped hyperparameters.'}</p></article>
      <article><span>Fit · {pct(split.fittedRatings/splitTotal)}</span><strong>{split.fittedRatings.toLocaleString()}</strong><p>{zh?'训练加验证，重拟合最终模型。':'Train plus validation for final refit.'}</p></article>
      <article><span>Test · {pct(split.testRatings/splitTotal)}</span><strong>{split.testRatings.toLocaleString()}</strong><p>{zh?'只用于一次最终评估。':'Used once for final evaluation.'}</p></article>
    </div>
    <aside><h3>{zh?'Test rating 保持原始星级':'Test ratings stay on the raw star scale'}</h3><p>{zh?<>Test 中的 rating 仍是用户实际给出的 1–5 星，没有归一化，也不会为 relevance 判断做中心化。<KatexMath latex={String.raw`r_{ui}^{\mathrm{test}}\ge 4`} /> 就是原始的 4 或 5 星；它是一个清楚但不完美的离线阈值，因为 3 星对不同用户可能有不同含义。中心化或基线残差只用于训练相似度和预测。</>:<>The test rating remains the original 1–5 stars: it is neither normalized nor centered for relevance. <KatexMath latex={String.raw`r_{ui}^{\mathrm{test}}\ge 4`} /> literally means an observed four or five stars. This is a clear but imperfect offline threshold because three stars can mean different things to different viewers. Centering and baseline residuals are modeling operations used only for similarity and prediction.</>}</p></aside>
    <MovieLensFlow type="evaluation" lang={lang} />
    <aside><h3>{zh?'为什么按用户、按时间切分？':'Why split by user and time?'}</h3><ol class="split-explanation"><li>{zh?<><strong>目的：</strong>测试集模拟“未来才发生”的评分，用于一次最终评估；它不参与选择参数。</>:<><strong>Purpose:</strong> test ratings simulate feedback that happens later and are used once for final evaluation; they never choose parameters.</>}</li><li>{zh?<><strong>操作：</strong>对每位用户按 <KatexMath latex={String.raw`(\mathrm{timestamp},\mathrm{movie\ ID})`} /> 稳定排序；最早约 <KatexMath latex={String.raw`80\%`} /> 进入 Train，随后约 <KatexMath latex={String.raw`10\%`} /> 进入 Validation，最后约 <KatexMath latex={String.raw`10\%`} /> 进入 Test。</>:<><strong>Mechanics:</strong> stably sort each user by <KatexMath latex={String.raw`(\mathrm{timestamp},\mathrm{movie\ ID})`} />; about <KatexMath latex={String.raw`80\%`} /> goes to Train, the next <KatexMath latex={String.raw`10\%`} /> to Validation, and the final <KatexMath latex={String.raw`10\%`} /> to Test.</>}</li><li>{zh?<><strong>调参：</strong>只在 Validation 比较 <KatexMath latex={String.raw`k`} />、最小共同评分支持度和收缩系数 <KatexMath latex={String.raw`\lambda`} />；选定后以 Train + Validation 重拟合。</>:<><strong>Tuning:</strong> compare only <KatexMath latex={String.raw`k`} />, minimum co-rating support, and shrinkage <KatexMath latex={String.raw`\lambda`} /> on Validation; then refit using Train + Validation.</>}</li><li>{zh?'随机切分可能让未来评分帮助模型预测过去；时间切分避免这种泄漏。缺失单元格仍表示未观察，不代表不喜欢，也不填 0。':'A random split could let future ratings help predict the past; the temporal split prevents that leakage. Missing cells remain unobserved—not disliked—and are never filled with zero.'}</li></ol></aside>
  </section>

  <section id="ml-3" class="case-step">
    <p class="step-label">Step 3</p><h2>{copy.edaTitle}</h2><p>{copy.eda}</p>
    <div class="output"><strong>{zh ? '稀疏性如何改变决策' : 'How sparsity changes the decision'}</strong><p>{zh ? `矩阵有 ${pct(profile.sparsity)} 未观察单元格；用户评分中位数为 ${profile.ratingsPerUser.median}，电影评分中位数为 ${profile.ratingsPerMovie.median}。因此不将缺失填为负反馈，为相似度设置共同评分门槛，并在邻域证据不足时回退热门榜。` : `${pct(profile.sparsity)} of the matrix is unobserved; median activity is ${profile.ratingsPerUser.median} ratings per user and ${profile.ratingsPerMovie.median} per movie. Therefore missingness never becomes negative feedback, similarity requires co-rating support, and thin neighborhoods fall back to popularity.`}</p></div>
    <figure><img src={href('/artifacts/movielens/popularity-long-tail.svg')} width="720" height="396" loading="lazy" alt={zh ? '按训练热门度排序的电影评分次数长尾曲线' : 'Long-tail curve of movie interaction counts ordered by fitted popularity'} /><figcaption><strong>{zh ? '观察：' : 'Observation: '}</strong>{zh ? `训练加验证交互数定义热门度；最热门 20% 电影包含测试 cohort 中 ${head.relevantTestRatings.toLocaleString()} 条相关评分的 ${pct(head.top20PercentShare)}。` : `Popularity is defined by train-plus-validation interaction count; the top 20% of movies contain ${pct(head.top20PercentShare)} of ${head.relevantTestRatings.toLocaleString()} relevant test ratings in the ranking cohort.`}<br/><strong>{zh ? '决定：' : 'Decision: '}</strong>{zh ? '保留热门基线，并同时报告覆盖与长尾比例，避免只优化头部命中。' : 'Keep popularity as a baseline and report coverage and long-tail share so head-item hits are not the only objective.'}</figcaption></figure>
  </section>

  <section id="ml-4" class="case-step">
    <p class="step-label">Step 4</p><h2>{copy.representationTitle}</h2><p>{copy.representation}</p>
    <div class="matrix" role="region" aria-label={zh ? '中心化评分示例' : 'Mean-centering example'}><table><thead><tr><th>{zh ? '用户' : 'User'}</th><th>Film A</th><th>Film B</th><th>Film C</th><th>{zh ? '均值' : 'Mean'}</th><th>{zh ? '中心化后' : 'Centered'}</th></tr></thead><tbody><tr><th>Alice</th><td>5</td><td>4</td><td>3</td><td>4</td><td><KatexMath latex={String.raw`(+1,\ 0,\ -1)`} /></td></tr><tr><th>Bob</th><td>4</td><td>3</td><td>2</td><td>3</td><td><KatexMath latex={String.raw`(+1,\ 0,\ -1)`} /></td></tr></tbody></table></div>
    <p class="symbol-guide">{zh ? <>v4 使用基线残差 <KatexMath latex={String.raw`e_{ui}=r_{ui}-b_{ui}`} /> 作为协同过滤信号：先扣除用户一贯打高或打低、以及电影通常得分的影响，再用剩余的“超出基线预期”偏好计算相似度和邻居贡献。</> : <>v4 uses the baseline residual <KatexMath latex={String.raw`e_{ui}=r_{ui}-b_{ui}`} /> as the collaborative-filtering signal: it removes a viewer’s general rating scale and a movie’s usual score before using the remaining “above or below expectation” preference to compute similarities and neighbor contributions.</>}</p>
    <aside><h3>{zh?'为什么两个偏置公式彼此依赖？':'Why do the two bias equations depend on each other?'}</h3><KatexMath latex={String.raw`\min_{\{b_u\},\{b_i\}}\ \sum_{(u,i,r_{ui})\in\Omega}(r_{ui}-\mu-b_u-b_i)^2+\lambda_b\left(\sum_u b_u^2+\sum_i b_i^2\right)`} display /><p>{zh?'用户偏置和电影偏置是在同一个正则化最小二乘目标中联合估计的：一条高评分究竟来自用户一贯打高分，还是电影通常得分高，必须在控制另一项后才能判断。因此两个更新式会引用对方；实现使用交替坐标更新，而不是要求在计算开始前就知道最终答案。':'User and item biases are jointly estimated under one regularized least-squares objective. A high rating cannot be attributed to a generous user or a generally high-rated movie without controlling for the other effect. That is why each update references the other bias family; the implementation uses alternating coordinate updates rather than assuming both final answers are known in advance.'}</p></aside>
    <div class="signal-formulas">
      <article class="formula-card"><h3>{zh?'从原始评分交替计算偏置':'Alternating bias updates from raw ratings'}</h3><KatexMath latex={String.raw`\Omega=\{(u,i,r_{ui})\},\qquad \mu=\frac{1}{|\Omega|}\sum_{(u,i,r_{ui})\in\Omega}r_{ui}`} display /><KatexMath latex={String.raw`b_u^{(0)}=0,\qquad b_i^{(0)}=0`} display /><KatexMath latex={String.raw`b_u^{(t)}=\frac{\sum_{i\in I_u}(r_{ui}-\mu-b_i^{(t-1)})}{|I_u|+\lambda_b}`} display /><KatexMath latex={String.raw`b_i^{(t)}=\frac{\sum_{u\in U_i}(r_{ui}-\mu-b_u^{(t)})}{|U_i|+\lambda_b},\qquad t=1,\ldots,10`} display /><KatexMath latex={String.raw`b_{ui}=\mu+b_u^{(10)}+b_i^{(10)},\qquad e_{ui}=r_{ui}-b_{ui}`} display /><p>{zh?<>两个公式不是互相等待的循环定义：先从 raw data 计算 <KatexMath latex={String.raw`\mu`} /> 并把两类偏置初始化为 <KatexMath latex={String.raw`0`} />；第 <KatexMath latex={String.raw`t`} /> 轮先使用上一轮电影偏置更新全部用户偏置，再使用本轮最新用户偏置更新全部电影偏置。当前代码重复十轮。</>:<>The equations are not a circular one-shot definition. Compute <KatexMath latex={String.raw`\mu`} /> from raw ratings and initialize both bias families to <KatexMath latex={String.raw`0`} />. At iteration <KatexMath latex={String.raw`t`} />, update every user bias from the previous item biases, then update every item bias from the new user biases. The current implementation runs ten iterations.</>}</p><FormulaLegend label={zh?'计算变量':'Calculation variables'} entries={[{latex:String.raw`\Omega`,description:zh?'raw data 中用于拟合的所有已观察三元组。':'all observed raw-data triples used for fitting.'},{latex:String.raw`I_u=\{i:(u,i,r_{ui})\in\Omega\}`,description:zh?'用户 u 在拟合数据中评分过的电影集合。':'movies rated by user u in the fitted data.'},{latex:String.raw`U_i=\{u:(u,i,r_{ui})\in\Omega\}`,description:zh?'在拟合数据中评价过电影 i 的用户集合。':'users who rated movie i in the fitted data.'},{latex:String.raw`\lambda_b=10`,description:zh?'偏置正则化强度；样本越少，偏置越明显地向 0 收缩。':'bias regularization strength; fewer observations produce stronger shrinkage toward zero.'},{latex:String.raw`e_{ui}`,description:zh?'观测评分相对用户—电影基线的残差；缺失评分没有残差，也不会填 0。':'residual of an observed rating from its user–movie baseline; missing ratings have no residual and are not filled with zero.'}]} /></article>
      <article class="formula-card"><h3>{zh?'如何从单个残差聚合成向量':'Aggregating scalar residuals into vectors'}</h3><KatexMath latex={String.raw`\tilde e_{ui}=\begin{cases}e_{ui},&(u,i,r_{ui})\in\Omega\\0,&\text{otherwise}\end{cases}`} display /><KatexMath latex={String.raw`\mathbf e_u=(\tilde e_{ui})_{i\in\mathcal I},\qquad \mathbf e_v=(\tilde e_{vi})_{i\in\mathcal I}`} display /><KatexMath latex={String.raw`\mathbf e_i=(\tilde e_{ui})_{u\in\mathcal U},\qquad \mathbf e_j=(\tilde e_{uj})_{u\in\mathcal U}`} display /><KatexMath latex={String.raw`I_{uv}=I_u\cap I_v,\qquad U_{ij}=U_i\cap U_j`} display /><KatexMath latex={String.raw`c_{uv}=\frac{\sum_{i\in I_{uv}}e_{ui}e_{vi}}{\sqrt{\sum_{i\in I_u}e_{ui}^2}\sqrt{\sum_{i\in I_v}e_{vi}^2}},\qquad c_{ij}=\frac{\sum_{u\in U_{ij}}e_{ui}e_{uj}}{\sqrt{\sum_{u\in U_i}e_{ui}^2}\sqrt{\sum_{u\in U_j}e_{uj}^2}}`} display /><p>{zh?<>每个用户向量把该用户的已观察残差放到完整电影坐标；每个电影向量把该电影的已观察残差放到完整用户坐标。稀疏矩阵中的 <KatexMath latex={String.raw`0`} /> 只是“该坐标未观察”的计算占位，不是零星评分。点积分子自然只剩共同评分项，而两个范数分别使用各自全部已观察残差；共同集合的大小另行作为支持度门槛与收缩依据。</>:<>Each user vector places that user’s observed residuals on the full movie coordinate system; each item vector places that item’s observed residuals on the full user coordinate system. A sparse-matrix <KatexMath latex={String.raw`0`} /> is only a computational placeholder for an unobserved coordinate, not a zero-star rating. The dot-product numerator therefore retains only common observations, while each norm uses all residuals observed for that entity; intersection size separately controls support filtering and shrinkage.</>}</p><KatexMath latex={String.raw`s'_{ab}=c_{ab}\frac{n_{ab}}{n_{ab}+\lambda},\qquad a,b\in\{u,v\}\ \text{or}\ \{i,j\}`} display /><KatexMath latex={String.raw`\hat r_{ui}^{\mathrm{UserCF}}=b_{ui}+\frac{\sum_{v\in N_k(u,i)}s'_{uv}e_{vi}}{\sum_{v\in N_k(u,i)}|s'_{uv}|}`} display /><KatexMath latex={String.raw`\hat r_{ui}^{\mathrm{ItemCF}}=b_{ui}+\frac{\sum_{j\in N_k(i,u)}s'_{ij}e_{uj}}{\sum_{j\in N_k(i,u)}|s'_{ij}|}`} display /><ul class="card-points"><li>{zh?<>User-CF 聚合对候选电影 <KatexMath latex={String.raw`i`} /> 有评分的相似用户残差 <KatexMath latex={String.raw`e_{vi}`} />；Item-CF 聚合用户 <KatexMath latex={String.raw`u`} /> 已评分邻居电影的残差 <KatexMath latex={String.raw`e_{uj}`} />。</>:<>User-CF aggregates <KatexMath latex={String.raw`e_{vi}`} /> from similar users who rated candidate <KatexMath latex={String.raw`i`} />; Item-CF aggregates <KatexMath latex={String.raw`e_{uj}`} /> from neighbor movies rated by user <KatexMath latex={String.raw`u`} />.</>}</li><li>{zh?<>原始相似度先通过 <KatexMath latex={String.raw`\mathrm{min\_support}`} /> 过滤，再收缩为 <KatexMath latex={String.raw`s'`} />，并只保留相似度最高的 <KatexMath latex={String.raw`\mathrm{Top}\text{-}k`} /> 正相似邻居。</>:<>Raw similarity is filtered by <KatexMath latex={String.raw`\mathrm{min\_support}`} />, shrunk to <KatexMath latex={String.raw`s'`} />, and limited to the <KatexMath latex={String.raw`\mathrm{Top}\text{-}k`} /> positive neighbors.</>}</li><li>{zh?<>有效邻居少于 <KatexMath latex={String.raw`\mathrm{min\_neighbors}`} /> 或总绝对相似度权重为 <KatexMath latex={String.raw`0`} /> 时，沿用 Bayesian popularity fallback。</>:<>If valid neighbors are fewer than <KatexMath latex={String.raw`\mathrm{min\_neighbors}`} /> or total absolute similarity weight is <KatexMath latex={String.raw`0`} />, the existing Bayesian popularity fallback is used.</>}</li></ul></article>
    </div>
    <aside><h3>{zh?'为什么这个信号在当前离线结果中更有效？':'Why is this signal more effective in the current offline result?'}</h3><ul class="card-points"><li>{zh?<><KatexMath latex={String.raw`b_u`} /> 消除用户打分尺度差异，<KatexMath latex={String.raw`b_i`} /> 消除电影普遍高分或低分造成的伪相似；<KatexMath latex={String.raw`e_{ui}`} /> 因而更聚焦于相对基线的个性化偏好。</>:<><KatexMath latex={String.raw`b_u`} /> removes user-scale differences, while <KatexMath latex={String.raw`b_i`} /> removes false similarity caused by movies being generally high- or low-rated; <KatexMath latex={String.raw`e_{ui}`} /> therefore focuses more directly on preference relative to expectation.</>}</li><li>{zh?<>预测时恢复候选电影自己的 <KatexMath latex={String.raw`b_i`} />，保留候选之间的系统性分差，减少多个电影得到完全相同主分的机会。</>:<>Restoring each candidate’s own <KatexMath latex={String.raw`b_i`} /> preserves systematic score differences between candidates and reduces the chance that many movies receive the same primary score.</>}</li><li>{zh?'这是与当前 v3→v4 离线结果一致的机制解释，不是因果证明，也不保证在所有数据集上都更好；该方向仍受 post-hoc 限制。':'This mechanism is consistent with the current v3→v4 offline result; it is not causal proof or a guarantee on every dataset, and the direction remains subject to the post-hoc limitation.'}</li></ul></aside>
    <div class="code-block"><Code code={normalizationCode} lang="python" theme="github-dark" /></div>
    <div class="hyperparameter-grid">
      <article class="formula-card"><h3>k · {zh?'邻居保留数':'retained neighbors'}</h3><ul class="card-points"><li>{zh?'作用：每个用户或电影最多保留多少个正相似邻居；它不是推荐列表的 Top-10。':'Purpose: maximum positive neighbors retained per user or movie; it is not the recommendation-list Top-10.'}</li><li>{zh?`候选与最终值：20/40/80；User-CF=${userValidation.selected.k}，Item-CF=${itemValidation.selected.k}。`:`Candidates and selections: 20/40/80; User-CF=${userValidation.selected.k}, Item-CF=${itemValidation.selected.k}.`}</li><li>{zh?'取值影响：太小会丢失有效证据，太大则引入弱邻居、噪声与额外计算。':'Trade-off: too small loses useful evidence; too large admits weak neighbors, noise, and extra computation.'}</li><li>{zh?`示例：通过 min_support 过滤后若仍有 60 个邻居，按相似度降序只保留前 20 个。所选 User-CF Validation NDCG=${pct(userSelected.metrics.ndcg_at_10,2)}。`:`Example: if 60 neighbors remain after min_support filtering, keep only the 20 highest-similarity neighbors. Selected User-CF validation NDCG=${pct(userSelected.metrics.ndcg_at_10,2)}.`}</li></ul></article>
      <article class="formula-card"><h3>min_support · {zh?'共同证据门槛':'co-evidence threshold'}</h3><ul class="card-points"><li>{zh?'作用：计算用户或电影相似度所需的最少共同评分数；低于门槛的关系直接删除。':'Purpose: minimum co-rating count required to compute a user or movie similarity; relations below it are removed.'}</li><li>{zh?`候选与最终值：5/10/20；User-CF=${userValidation.selected.min_support}，Item-CF=${itemValidation.selected.min_support}。`:`Candidates and selections: 5/10/20; User-CF=${userValidation.selected.min_support}, Item-CF=${itemValidation.selected.min_support}.`}</li><li>{zh?'取值影响：太小容易把偶然共现当成相似，太大会让稀疏用户或电影失去邻居。':'Trade-off: too small admits coincidental overlap; too large leaves sparse users or movies without neighbors.'}</li><li>{zh?'示例：min_support=10 时，即使只有 9 个共同评分的原始余弦为 1，该关系仍会被过滤。':'Example: with min_support=10, a raw cosine of 1 based on only nine co-ratings is still filtered.'}</li></ul></article>
      <article class="formula-card"><h3>shrinkage · {zh?'相似度收缩':'similarity shrinkage'}</h3><KatexMath latex={String.raw`s'=s\frac{n}{n+\lambda}`} display /><ul class="card-points"><li>{zh?'作用：共同评分较少时原始相似度不稳定；收缩降低小样本偶然高相似度的影响。':'Purpose: raw similarity is unstable with few co-ratings; shrinkage reduces accidental high similarity from small samples.'}</li><li>{zh?<>变量：<KatexMath latex={String.raw`s`} /> 是原始余弦相似度，<KatexMath latex={String.raw`n`} /> 是共同评分数，<KatexMath latex={String.raw`\lambda`} /> 是控制收缩强度的非负超参数，<KatexMath latex={String.raw`s'`} /> 是用于模型的收缩后相似度。</>:<>Variables: <KatexMath latex={String.raw`s`} /> is raw cosine similarity, <KatexMath latex={String.raw`n`} /> the co-rating count, <KatexMath latex={String.raw`\lambda`} /> the non-negative shrinkage strength, and <KatexMath latex={String.raw`s'`} /> the similarity used by the model.</>}</li><li>{zh?<>候选与最终值：10/25/50；User-CF={userValidation.selected.shrinkage}，Item-CF={itemValidation.selected.shrinkage}。<KatexMath latex={String.raw`\lambda`} /> 越大收缩越强；<KatexMath latex={String.raw`\lambda`} /> 越小越接近原始相似度。</>:<>Candidates and selections: 10/25/50; User-CF={userValidation.selected.shrinkage}, Item-CF={itemValidation.selected.shrinkage}. Larger <KatexMath latex={String.raw`\lambda`} /> shrinks more; smaller <KatexMath latex={String.raw`\lambda`} /> stays closer to the raw similarity.</>}</li><li>{zh?<>示例：<KatexMath latex={String.raw`s=0.90,\ n=10,\ \lambda=50\Rightarrow s'=0.15`} />。所选 Item-CF Validation NDCG={pct(itemSelected.metrics.ndcg_at_10,2)}。</>:<>Example: <KatexMath latex={String.raw`s=0.90,\ n=10,\ \lambda=50\Rightarrow s'=0.15`} />. Selected Item-CF validation NDCG={pct(itemSelected.metrics.ndcg_at_10,2)}.</>}</li></ul></article>
      <article class="formula-card"><h3>min_neighbors · {zh?'最少有效邻居数':'minimum valid neighbors'}</h3><ul class="card-points"><li>{zh?'作用：生成一个协同过滤预测所需的最少有效邻居数；它作用于预测阶段，不是计算相似度的共同评分门槛。':'Purpose: minimum valid neighbors required to produce a CF prediction; it applies during prediction, not similarity construction.'}</li><li>{zh?`候选与最终值：第一阶段固定 2，第二阶段比较 2/5；User-CF=${userValidation.selected.min_neighbors}，Item-CF=${itemValidation.selected.min_neighbors}。`:`Candidates and selections: stage one fixes 2, then stage two compares 2/5; User-CF=${userValidation.selected.min_neighbors}, Item-CF=${itemValidation.selected.min_neighbors}.`}</li><li>{zh?'取值影响：太小会用证据不足的邻域预测，太大会增加回退比例并减少个性化覆盖。':'Trade-off: too small predicts from thin evidence; too large increases fallback use and reduces personalized coverage.'}</li><li>{zh?'处理方式：候选电影的有效邻居少于 5 个或总相似度权重为 0 时，不生成 CF 分数，改用 Bayesian popularity 分数排序。':'Fallback: when a candidate has fewer than five valid neighbors or zero total similarity weight, skip the CF score and rank it with Bayesian popularity.'}</li></ul></article>
    </div>
    <aside><h3>{zh ? '排序分与展示评分' : 'Rank score versus display rating'}</h3><p>{zh ? 'Top-N 使用未截断的原始估计排序；RMSE、MAE 与界面评分限制在 1–5。这样不会让高于 5 的不同分数过早并列。' : 'Top-N uses raw estimates. RMSE, MAE, and displayed ratings use the 1–5 scale, preventing distinct scores above five from collapsing before ranking.'}</p></aside>
  </section>

  <section id="ml-5" class="case-step">
    <p class="step-label">Step 5</p><h2>{copy.algorithmTitle}</h2><p>{copy.algorithm}</p>
    <div class="method-cards">
      <article class="method-card"><div class="method-copy"><h3>Bayesian popularity</h3><KatexMath latex={bayesianFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`B_i`,description:zh?'电影 i 用于排序的 Bayesian 分。':'Bayesian ranking score for movie i.'},{latex:String.raw`i`,description:zh?'电影。':'a movie.'},{latex:String.raw`n_i`,description:zh?'电影 i 在拟合数据中的评分条数。':'fitted rating count for movie i.'},{latex:String.raw`\bar r_i`,description:zh?'电影 i 的拟合评分均值。':'fitted mean rating for movie i.'},{latex:String.raw`\mu`,description:zh?`全局均分 (${popularity.globalMean.toFixed(3)})。`:`global mean (${popularity.globalMean.toFixed(3)}).`},{latex:String.raw`m`,description:zh?`Validation 从 10/25/50/100 选择的先验权重 (${popularity.priorWeight.toFixed(0)})；越大越不相信小样本均分。`:`validation-selected prior weight (${popularity.priorWeight.toFixed(0)}) from 10/25/50/100; larger values trust small-sample means less.`}]} /><ol class="card-points"><li>{zh ? '输入每部电影的评分数与均分；拟合全局均分和 Bayesian 分。' : 'Input movie counts and means; fit the global mean and Bayesian score.'}</li><li>{zh ? '按分数排序；证据少的电影自动收缩到全局均分。' : 'Rank by score; low-support movies shrink toward the global mean.'}</li><li>{zh ? '排除该用户已看电影，再从完整拟合目录取 Top-10。' : 'Remove the user’s seen movies, then take Top-10 from the full fitted catalog.'}</li><li>{zh ? '它也是 User-CF / Item-CF 证据不足时的共享兜底。' : 'It is also the shared fallback when User-CF or Item-CF lacks evidence.'}</li></ol><div class="example-grid">{bayesianExamples.map((example)=><div><span>{example.support==='low'?(zh?'低支持度':'Low support'):(zh?'高支持度':'High support')}</span><strong>{example.title}</strong><KatexMath latex={String.raw`\frac{${example.ratingCount}\times${example.ratingMean.toFixed(3)}+${popularity.priorWeight.toFixed(0)}\times${popularity.globalMean.toFixed(3)}}{${example.ratingCount}+${popularity.priorWeight.toFixed(0)}}=${example.score.toFixed(3)}`} display /></div>)}</div></div></article>
      <article class="method-card"><div class="method-copy"><h3>User-Based Collaborative Filtering</h3><p>{zh ? '先找基线残差走势相近的用户，再聚合他们对候选电影“高于或低于平常”的部分。' : 'Find users with similar baseline-residual patterns, then aggregate how much their candidate ratings differ from usual.'}</p><KatexMath latex={userSimilarityFormula} display /><FormulaLegend label={zh?'相似度变量':'Similarity variables'} entries={[{latex:String.raw`I_{uv}`,description:zh?'用户 u 与 v 都评分过的电影集合。':'movies rated by both u and v.'},{latex:String.raw`e_{ui}`,description:zh?'用户 u 对电影 i 的基线残差。':'u’s baseline residual for movie i.'},{latex:String.raw`n_{uv}=|I_{uv}|`,description:zh?'共同评分支持度。':'co-rating support.'},{latex:String.raw`c(u,v)`,description:zh?'原始残差余弦。':'raw residual cosine.'},{latex:String.raw`s(u,v)`,description:zh?'支持度收缩后的相似度。':'support-shrunk similarity.'}]} /><div class="calculation"><span>{zh?'三部共同电影的教学例子':'Three-co-rated-movie teaching example'}</span><KatexMath latex={String.raw`[1,0,-1]\cdot[1,-1,0]=1,\quad c=\frac{1}{\sqrt2\sqrt2}=0.50,\quad s=0.50\frac{3}{3+10}=0.115`} display /><p>{zh?'生产门槛可能会过滤只有 3 个共同评分的关系；这个例子只用于展示点积、范数和收缩如何计算。':'Production support may filter a pair with only three co-ratings; this example only demonstrates dot product, norms, and shrinkage.'}</p></div><KatexMath latex={userFormula} display /><FormulaLegend label={zh?'预测变量':'Prediction variables'} entries={[{latex:String.raw`\hat r_{ui}`,description:zh?'用户 u 对候选电影 i 的未截断预测评分。':'raw prediction for user u and candidate movie i.'},{latex:String.raw`b_{ui}`,description:zh?'全局均值、用户偏置与电影偏置之和。':'global mean plus user and movie bias.'},{latex:String.raw`v`,description:zh?'评过 i 的相似用户。':'a similar user who rated i.'},{latex:String.raw`N_k(u,i)`,description:zh?'最多 k 个有效用户邻居。':'up to k valid user neighbors.'},{latex:String.raw`r_{vi}-b_{vi}`,description:zh?'邻居 v 对电影 i 的基线残差。':'neighbor v’s baseline residual for i.'}]} /><MovieLensFlow type="user" lang={lang} /><a href={href(`/${lang}/algorithms/user-based-cf/`)}>{zh ? '查看通用算法页 →' : 'Open the general algorithm page →'}</a></div></article>
      <article class="method-card"><div class="method-copy"><h3>Item-Based Collaborative Filtering</h3><p>{zh ? '先用共同用户的基线残差学习电影关系，再聚合目标用户已评分来源电影的残差；这里不是按类型或片名做内容相似。' : 'Learn movie relationships from co-raters’ baseline residuals, then aggregate residuals from source movies the target user rated. This is not genre- or title-based content similarity.'}</p><KatexMath latex={itemSimilarityFormula} display /><FormulaLegend label={zh?'相似度变量':'Similarity variables'} entries={[{latex:String.raw`U_{ij}`,description:zh?'同时评过电影 i 与 j 的用户集合。':'users who rated both movies i and j.'},{latex:String.raw`e_{ui}`,description:zh?'用户 u 对电影 i 的基线残差。':'u’s baseline residual for movie i.'},{latex:String.raw`n_{ij}=|U_{ij}|`,description:zh?'共同评分用户支持度。':'co-rater support.'},{latex:String.raw`c(i,j)`,description:zh?'原始残差余弦。':'raw residual cosine.'},{latex:String.raw`s(i,j)`,description:zh?'支持度收缩后的电影相似度。':'support-shrunk item similarity.'}]} /><div class="calculation"><span>{zh?'三个共同用户的教学例子':'Three-co-rater teaching example'}</span><KatexMath latex={String.raw`[1,0,-1]\cdot[1,-1,0]=1,\quad c(i,j)=0.50,\quad s(i,j)=0.50\frac{3}{3+10}=0.115`} display /><p>{zh?'相似来自共同用户的评分残差，而不是电影元数据；低于生产支持度门槛时仍会被过滤。':'Similarity comes from co-raters’ residual behavior, not movie metadata; production still filters it below minimum support.'}</p></div><KatexMath latex={itemFormula} display /><FormulaLegend label={zh?'预测变量':'Prediction variables'} entries={[{latex:String.raw`\hat r_{ui}`,description:zh?'用户 u 对候选电影 i 的未截断预测评分。':'raw prediction for user u and candidate movie i.'},{latex:String.raw`b_{ui}`,description:zh?'候选电影的用户—电影基线。':'user–movie baseline for the candidate.'},{latex:String.raw`j`,description:zh?'用户 u 已评分的来源电影。':'a source movie already rated by u.'},{latex:String.raw`N_k(i,u)`,description:zh?'最多 k 个有效来源电影。':'up to k valid source movies.'},{latex:String.raw`r_{uj}-b_{uj}`,description:zh?'目标用户对来源电影 j 的基线残差。':'target user’s baseline residual for source movie j.'}]} /><MovieLensFlow type="item" lang={lang} /><a href={href(`/${lang}/algorithms/item-based-cf/`)}>{zh ? '查看通用算法页 →' : 'Open the general algorithm page →'}</a></div></article>
    </div>
    <h3>{zh?'Item-CF 与 Spotify 内容推荐不是一回事':'Item-CF is not Spotify-style content recommendation'}</h3>
    <div class="method-table" role="region" tabindex="0"><table><thead><tr><th>{zh?'维度':'Dimension'}</th><th>MovieLens Item-CF</th><th>{zh?'Spotify 内容推荐':'Spotify content recommender'}</th></tr></thead><tbody><tr><th>{zh?'所需信号':'Required signal'}</th><td>{zh?'共同用户的评分模式':'Shared users’ rating patterns'}</td><td>{zh?'物品自身的音频或元数据属性':'Item audio or metadata attributes'}</td></tr><tr><th>{zh?'新物品':'New item'}</th><td>{zh?'没有共同评分，无法建立相似度':'No co-ratings, so no similarity'}</td><td>{zh?'只要属性齐全即可比较':'Comparable as soon as attributes exist'}</td></tr><tr><th>{zh?'新用户':'New user'}</th><td>{zh?'需要初始评分才能选来源电影':'Needs initial ratings to select source movies'}</td><td>{zh?'种子物品足以进行会话级推荐':'A seed item can support session-level recommendation'}</td></tr><tr><th>{zh?'解释':'Explanation'}</th><td>{zh?'“喜欢它的人也以相似方式评分了这些电影”':'“People rated these movies in similar patterns”'}</td><td>{zh?'“音频/内容属性相似”':'“Audio/content attributes are similar”'}</td></tr></tbody></table></div>
  </section>

  <section id="ml-6" class="case-step">
    <p class="step-label">Step 6</p><h2>{copy.comparisonTitle}</h2><p>{copy.comparison}</p>
    <aside><h3>{zh?'选择规则与分阶段搜索':'Selection rule and staged search'}</h3><p>{zh?<>主指标是 Validation NDCG@10，随后依次比较 Recall、Hit Rate、完全同分率和 Catalog Coverage。第一阶段覆盖 <KatexMath latex={String.raw`k\times\mathrm{min\_support}\times\mathrm{shrinkage}`} /> 的 <KatexMath latex={String.raw`3\times3\times3`} /> 正交网格并固定 <KatexMath latex={String.raw`\mathrm{min\_neighbors}=2`} />；第二阶段只为前三名比较 <KatexMath latex={String.raw`\mathrm{min\_neighbors}\in\{2,5\}`} />。</>:<>Primary metric is validation NDCG@10, followed by Recall, Hit Rate, fully tied share, and Catalog Coverage. Stage one covers the <KatexMath latex={String.raw`3\times3\times3`} /> orthogonal <KatexMath latex={String.raw`k\times\mathrm{min\_support}\times\mathrm{shrinkage}`} /> grid at <KatexMath latex={String.raw`\mathrm{min\_neighbors}=2`} />; stage two compares <KatexMath latex={String.raw`\mathrm{min\_neighbors}\in\{2,5\}`} /> for the top three.</>}</p></aside>
    <div class="validation-grid">{selectedValidationRows.map(({group,candidate})=><article><h3>{group.mode==='user'?'User-CF':'Item-CF'}</h3><div class="method-table" role="region" tabindex="0"><table><thead><tr><th>k</th><th>min_support</th><th>shrinkage</th><th>min_neighbors</th><th>NDCG@10</th><th>Recall@10</th><th>{zh?'覆盖':'Coverage'}</th></tr></thead><tbody><tr class="selected"><td>{candidate.params.k}</td><td>{candidate.params.min_support}</td><td>{candidate.params.shrinkage}</td><td>{candidate.params.min_neighbors}</td><td>{pct(candidate.metrics.ndcg_at_10,2)}</td><td>{pct(candidate.metrics.recall_at_10,2)}</td><td>{pct(candidate.beyondAccuracy.catalog_coverage,2)}</td></tr></tbody></table></div><p class="selection-note">{zh?'仅展示 Validation 最终选择；完整搜索空间与分阶段规则见上方说明。':'Final validation selection only; the complete search space and staged rule are documented above.'}</p></article>)}</div>
    <div class="method-table" role="region" tabindex="0"><table><thead><tr><th>{zh?'维度':'Dimension'}</th><th>User-CF</th><th>Item-CF</th></tr></thead><tbody><tr><th>{zh?'表示':'Representation'}</th><td>{zh?'基线残差用户行':'baseline-residual user rows'}</td><td>{zh?'基线残差电影列':'baseline-residual movie columns'}</td></tr><tr><th>{zh?'最终配置':'Selected configuration'}</th><td>k={user.hyperparameters.k} · support={user.hyperparameters.min_support} · shrinkage={user.hyperparameters.shrinkage} · min neighbors={user.hyperparameters.min_neighbors}</td><td>k={item.hyperparameters.k} · support={item.hyperparameters.min_support} · shrinkage={item.hyperparameters.shrinkage} · min neighbors={item.hyperparameters.min_neighbors}</td></tr><tr><th>{zh?'服务与解释':'Serving / explanation'}</th><td>{zh?'邻域随用户变化；解释为相似用户':'neighborhood changes by user; similar-user evidence'}</td><td>{zh?'电影邻居可离线预计算；解释为来源电影':'movie neighbors can be precomputed; source-movie evidence'}</td></tr><tr><th>{zh?'冷启动':'Cold start'}</th><td>{zh?'新用户和新电影都弱':'weak for new users and movies'}</td><td>{zh?'新电影弱；用户需要初始评分':'new movies weak; users need initial ratings'}</td></tr></tbody></table></div>
    <h3>{zh?'User-CF 与 Item-CF：v3 → v4 修改明细':'User-CF and Item-CF: v3 → v4 change map'}</h3>
    <div class="method-table evolution-table" role="region" tabindex="0"><table><thead><tr><th>{zh?'方法':'Method'}</th><th>{zh?'修改点':'Change'}</th><th>{zh?'修改前':'Before'}</th><th>{zh?'修改后':'After'}</th><th>{zh?'影响环节':'Affected stage'}</th><th>{zh?'改善机制':'Why it helps'}</th></tr></thead><tbody><tr><th>User-CF</th><td>{zh?'评分表示与预测基线':'rating representation and prediction baseline'}</td><td>{zh?'只减用户均值；预测时加回用户均值。':'subtract user mean only; add the user mean back for prediction.'}</td><td>{zh?<>减去 <KatexMath latex={String.raw`\mu+b_u+b_i`} />；预测时加回候选电影对应的 <KatexMath latex={String.raw`b_{ui}`} />。</>:<>subtract <KatexMath latex={String.raw`\mu+b_u+b_i`} />; restore the candidate-specific <KatexMath latex={String.raw`b_{ui}`} /> for prediction.</>}</td><td>{zh?'用户残差矩阵、用户相似度、候选评分':'user residual matrix, user similarity, candidate scoring'}</td><td>{zh?'同时移除评分尺度和电影固有高低分，减少把共同热门电影误当成个人偏好的情况。':'removes both rating-scale and movie-level effects, reducing false similarity driven by commonly high-rated movies.'}</td></tr><tr><th>Item-CF</th><td>{zh?'评分表示、电影关系与同分处理':'rating representation, movie relations, and tie behavior'}</td><td>{zh?<>v3 使用 <KatexMath latex={String.raw`r_{ui}-\bar r_u`} />；当用户历史以相同星级为主，尤其是全五星时，大量残差为 <KatexMath latex={String.raw`0`} /> 或产生相同邻居贡献，多个候选可能得到完全相同的主分。</>:<>v3 uses <KatexMath latex={String.raw`r_{ui}-\bar r_u`} />; when a history contains mostly one rating—especially all five-star ratings—many residuals are <KatexMath latex={String.raw`0`} /> or produce identical neighbor contributions, so multiple candidates can receive the same primary score.</>}</td><td>{zh?'基线残差学习电影关系，并以候选电影基线恢复预测；Bayesian 分与证据强度只用于主分同分时排序。':'learn movie relations from baseline residuals and restore the candidate baseline; use Bayesian score and evidence only to break primary-score ties.'}</td><td>{zh?'电影相似度、评分预测、Top-10 排序':'item similarity, rating prediction, Top-10 ranking'}</td><td>{zh?'中心化并未直接“退化成 ID”；是主分失去区分度后，v3 才以 movie ID 做稳定的最终平局处理。ID 不包含偏好或质量信息。v4 的电影偏置保留候选间的系统性差异，减少这种排序退化。':'Mean-centering does not itself “turn into ID”; only after the primary score loses discrimination does v3 use movie ID as the final deterministic tie-break. The ID carries no preference or quality signal. v4 item bias preserves systematic candidate differences and reduces this ranking collapse.'}</td></tr></tbody></table></div>
    <h3>{zh?'修改前后离线结果':'Before-and-after offline results'}</h3>
    <div class="method-table" role="region" tabindex="0"><table><thead><tr><th>{zh?'方法与版本':'Method and version'}</th><th>Hit Rate@10</th><th>NDCG@10</th><th>Recall@10</th><th>{zh?'覆盖':'Coverage'}</th><th>{zh?'长尾':'Long-tail'}</th><th>{zh?'完全同分列表':'Fully tied lists'}</th></tr></thead><tbody><tr><th>User-CF · v3 mean-centered</th><td>{pct(legacyUser.test.hit_rate_at_10,2)}</td><td>{pct(legacyUser.test.ndcg_at_10,2)}</td><td>{pct(legacyUser.test.recall_at_10,2)}</td><td>{pct(legacyUser.beyondAccuracy.catalog_coverage,2)}</td><td>{pct(legacyUser.beyondAccuracy.long_tail_share,2)}</td><td>{pct(legacyUser.system.rankingTieStats.fullyTiedListShare,2)}</td></tr><tr class="selected"><th>User-CF · v4 bias-aware</th><td>{pct(user.test.hit_rate_at_10,2)}</td><td>{pct(user.test.ndcg_at_10,2)}</td><td>{pct(user.test.recall_at_10,2)}</td><td>{pct(user.beyondAccuracy.catalog_coverage,2)}</td><td>{pct(user.beyondAccuracy.long_tail_share,2)}</td><td>{pct(user.system.rankingTieStats!.fullyTiedListShare,2)}</td></tr><tr><th>Item-CF · v3 mean-centered</th><td>{pct(legacyItem.test.hit_rate_at_10,2)}</td><td>{pct(legacyItem.test.ndcg_at_10,2)}</td><td>{pct(legacyItem.test.recall_at_10,2)}</td><td>{pct(legacyItem.beyondAccuracy.catalog_coverage,2)}</td><td>{pct(legacyItem.beyondAccuracy.long_tail_share,2)}</td><td>{pct(legacyItemTieStats.fullyTiedListShare,2)}</td></tr><tr class="selected"><th>Item-CF · v4 bias-aware</th><td>{pct(item.test.hit_rate_at_10,2)}</td><td>{pct(item.test.ndcg_at_10,2)}</td><td>{pct(item.test.recall_at_10,2)}</td><td>{pct(item.beyondAccuracy.catalog_coverage,2)}</td><td>{pct(item.beyondAccuracy.long_tail_share,2)}</td><td>{pct(itemTieStats.fullyTiedListShare,2)}</td></tr></tbody></table></div>
    <p class="table-note">{zh?<>注：“完全同分列表”是指同一用户推荐列表中，所有非 fallback 条目的原始主排序分数完全相同；<KatexMath latex={String.raw`\mathrm{FullyTiedShare}=\frac{\#\,\mathrm{fully\ tied\ personalized\ lists}}{\#\,\mathrm{personalized\ evaluation\ lists}}`} />。同分表示主模型信号无法区分候选，不表示电影质量相同。v3 在主分相同时用 movie ID 做稳定、可复现的最终排序；ID 本身不携带偏好或质量信息。</>:<>Note: a “fully tied list” is a user recommendation list in which every non-fallback entry has exactly the same raw primary ranking score. <KatexMath latex={String.raw`\mathrm{FullyTiedShare}=\frac{\#\,\mathrm{fully\ tied\ personalized\ lists}}{\#\,\mathrm{personalized\ evaluation\ lists}}`} />. A tie means the primary model signal cannot distinguish candidates—not that the movies have equal quality. When v3 primary scores tie, movie ID provides a stable, reproducible final order; the ID itself carries no preference or quality information.</>}</p>
    <aside><h3>{zh?'如何解释改善':'How to interpret the improvement'}</h3><p>{zh?'v4 在当前离线测试上提高了两种 CF 的排序指标，并修复了 Item-CF 的严重同分退化；Coverage 与 Long-tail 同时下降，说明这是准确性与目录分布的取舍，而不是所有指标都变好。由于改进方向来自已经看过的 v3 Test 同分诊断，这一轮属于 post-hoc 模型迭代，不是完全未触碰测试集的确认性实验。':'v4 improves ranking metrics for both CF methods on this offline test and repairs Item-CF’s severe tie collapse; coverage and long-tail share also fall, so this is an accuracy/distribution trade-off rather than universal improvement. Because the direction came from v3 test tie diagnostics already observed, this is a post-hoc model iteration, not a fully untouched confirmatory experiment.'}</p></aside>
  </section>

  <section id="ml-7" class="case-step wide-step">
    <p class="step-label">Step 7</p><h2>{copy.resultTitle}</h2><p>{copy.result}</p>
    <div class="code-block narrow"><Code code={evaluationCode} lang="python" theme="github-dark" /></div>
    <div class="output"><strong>{zh ? '共同评估框架' : 'Shared evaluation frame'}</strong><p>{metrics.evaluationPopulation.rankingUsers.toLocaleString()} {zh ? `位有未来相关电影的用户；时间切分；K=${metrics.k}；每位用户在完整未见目录上排序。更高的 Hit Rate、NDCG、Recall、覆盖率和长尾比例代表对应问题上的提升，但各指标不能互相替代。` : `users with future relevant movies; temporal split; K=${metrics.k}; full unseen-catalog ranking per user. Higher Hit Rate, NDCG, recall, coverage, and long-tail share improve their respective questions, but the metrics are not interchangeable.`}</p></div>
    <div class="result-cards">
      <article class="metric-evidence"><h3>Hit Rate@10 ↑</h3><KatexMath latex={hitFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`U`,description:zh?`有未来相关电影的 ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} 位评估用户。`:`the ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} evaluated users with future relevant items.`},{latex:String.raw`R_u^{10}`,description:zh?'用户 u 的十个推荐。':'user u’s Top-10 recommendations.'},{latex:String.raw`T_u=\{i:r_{ui}^{test}\ge4\}`,description:zh?'用户 u 在原始测试评分中给出至少 4 星、且属于拟合目录的未来相关电影集合。':'u’s future-relevant fitted-catalog movies with an observed raw test rating of at least 4.'},{latex:String.raw`\mathbf{1}[\cdot]`,description:zh?'条件成立记 1，否则记 0。':'1 when the condition is true, otherwise 0.'}]} /><div class="calculation"><span>{zh?'计算':'Calculation'}</span><KatexMath latex={String.raw`\frac{${popularityHitUsers}}{${metrics.evaluationPopulation.rankingUsers.toLocaleString()}}=${popularity.test.hit_rate_at_10.toFixed(4)}`} display /><p>{zh?`Popularity 对 ${popularityHitUsers.toLocaleString()} 位用户至少找回一部未来相关电影。User-CF 为 ${userHitUsers.toLocaleString()} 位，Item-CF 为 ${itemHitUsers.toLocaleString()} 位。`:`Popularity retrieves at least one future-relevant movie for ${popularityHitUsers.toLocaleString()} users. User-CF does so for ${userHitUsers.toLocaleString()}; Item-CF for ${itemHitUsers.toLocaleString()}.`}</p></div><div class="triplet-values"><div><span>Popularity</span><strong>{pct(popularity.test.hit_rate_at_10,2)}</strong><small>95% CI {pct(popularity.confidence95.hitRateAt10[0],2)}–{pct(popularity.confidence95.hitRateAt10[1],2)}</small></div><div><span>User-CF</span><strong>{pct(user.test.hit_rate_at_10,2)}</strong><small>95% CI {pct(user.confidence95.hitRateAt10[0],2)}–{pct(user.confidence95.hitRateAt10[1],2)}</small></div><div><span>Item-CF</span><strong>{pct(item.test.hit_rate_at_10,2)}</strong><small>95% CI {pct(item.confidence95.hitRateAt10[0],2)}–{pct(item.confidence95.hitRateAt10[1],2)}</small></div></div><ul class="card-points"><li>{zh?<>一次命中：用户 <KatexMath latex={String.raw`u`} /> 的 <KatexMath latex={String.raw`R_u^{10}`} /> 中至少有一部也出现在 <KatexMath latex={String.raw`T_u`} />；命中一部与命中多部都记为 <KatexMath latex={String.raw`1`} />。</> : <>One hit means at least one title in <KatexMath latex={String.raw`R_u^{10}`} /> also appears in <KatexMath latex={String.raw`T_u`} />; one and many retrieved titles both score <KatexMath latex={String.raw`1`} />.</>}</li><li>{zh?'未命中不表示不喜欢，只表示没有找回后来主动评分的电影。':'A miss does not mean dislike; it means no later self-rated movie was retrieved.'}</li></ul></article>
      <article class="metric-evidence"><h3>NDCG@10 <KatexMath latex={String.raw`\uparrow`} /></h3><KatexMath latex={ndcgFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`i_{u,p}`,description:zh?'算法为用户 u 对候选电影打分并排序后，输出在第 p 位的电影。':'movie output at rank p after the algorithm scores and sorts candidates for user u.'},{latex:String.raw`T_u=\{i:r_{ui}^{test}\ge4\}`,description:zh?'与 Hit Rate 和 Recall 相同：用户 u 在原始测试评分中给出至少 4 星、且属于拟合目录的未来相关电影集合。':'the same set used by Hit Rate and Recall: u’s future-relevant fitted-catalog movies with a raw test rating of at least 4.'},{latex:String.raw`rel_{u,p}=\mathbf{1}[i_{u,p}\in T_u]`,description:zh?'二元相关性：第 p 位电影属于相关集合时为 1，否则为 0。':'binary relevance: 1 when the movie at rank p is in the relevant set, otherwise 0.'},{latex:String.raw`p\in\{1,\ldots,10\}`,description:zh?'推荐算法最终输出列表中的排名位置；首项是第一名推荐，末项是第十名。':'positions in the final ranked output, from the first through the tenth recommendation.'},{latex:String.raw`\mathrm{IDCG}_{u,10}=\sum_{p=1}^{\min(10,|T_u|)}\frac{1}{\log_2(p+1)}`,description:zh?'用户 u 的理想 DCG：假设最多 10 部相关电影全部排在列表最前面时可得到的最大 DCG。':'ideal DCG for user u: the maximum DCG when up to ten relevant movies occupy the first ranks.'},{latex:String.raw`\mathrm{DCG@10}_u=\sum_{p=1}^{10}\frac{rel_{u,p}}{\log_2(p+1)}`,description:zh?'用户 u 的折扣累计增益：按推荐位置累加命中，以二为底的排名对数使越靠前的命中权重越高。':'discounted cumulative gain for u: sum ranked hits with a base-two logarithmic position discount, giving earlier hits more weight.'},{latex:String.raw`\mathrm{NDCG@10}_u=\frac{\mathrm{DCG@10}_u}{\mathrm{IDCG}_{u,10}}`,description:zh?'用该用户的理想 DCG 归一化，使相关电影数量不同的用户可以公平比较。':'normalize by that user’s ideal DCG so users with different relevant-set sizes remain comparable.'},{latex:String.raw`U`,description:zh?'评估用户集合。':'evaluation-user set.'}]} /><div class="triplet-values"><div><span>Popularity</span><strong>{pct(popularity.test.ndcg_at_10,2)}</strong></div><div><span>User-CF</span><strong>{pct(user.test.ndcg_at_10,2)}</strong></div><div><span>Item-CF</span><strong>{pct(item.test.ndcg_at_10,2)}</strong></div></div><ul class="card-points"><li>{zh?`User-CF 与 Popularity 相减的配对差为 ${signedPoints(paired.meanDifference)}，95% CI ${signedPoints(paired.confidence95[0])} 至 ${signedPoints(paired.confidence95[1])}。`:`User-CF minus Popularity is ${signedPoints(paired.meanDifference)}; 95% CI ${signedPoints(paired.confidence95[0])} to ${signedPoints(paired.confidence95[1])}.`}</li><li>{zh?'这是离线显式评分代理，不是观看概率。':'This is an offline explicit-rating proxy, not watch probability.'}</li></ul></article>
      <article class="metric-evidence"><h3>Recall@10 <KatexMath latex={String.raw`\uparrow`} /></h3><KatexMath latex={recallFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`R_u^{10}`,description:zh?'用户 u 的十个推荐。':'user u’s Top-10 recommendations.'},{latex:String.raw`T_u=\{i:r_{ui}^{test}\ge4\}`,description:zh?'与 Hit Rate 和 NDCG 相同：用户 u 在原始测试评分中给出至少 4 星、且属于拟合目录的未来相关电影集合。':'the same set used by Hit Rate and NDCG: u’s future-relevant fitted-catalog movies with a raw test rating of at least 4.'},{latex:String.raw`|T_u|`,description:zh?'该用户所有四星或五星未来相关电影的数量，也是 Recall 的分母。':'the number of all future four- or five-star test movies for that user and Recall’s denominator.'},{latex:String.raw`U`,description:zh?'评估用户集合。':'evaluation-user set.'}]} /><div class="calculation"><span>{zh?'计算':'Calculation'}</span><KatexMath latex={String.raw`\frac{1}{|U|}\sum_{u\in U}\frac{|R_u^{10}\cap T_u|}{|T_u|}\Rightarrow ${popularity.test.recall_at_10.toFixed(5)}`} display /><p>{zh?'先按每位用户的未来相关电影数归一化，再取用户宏平均。':'Normalize by each user’s future-relevant count, then take the user macro-average.'}</p></div><div class="triplet-values"><div><span>Popularity</span><strong>{pct(popularity.test.recall_at_10,2)}</strong></div><div><span>User-CF</span><strong>{pct(user.test.recall_at_10,2)}</strong></div><div><span>Item-CF</span><strong>{pct(item.test.recall_at_10,2)}</strong></div></div><ul class="card-points"><li>{zh?<>固定十个位置和完整目录候选使绝对值较低；活跃用户的 <KatexMath latex={String.raw`|T_u|`} /> 通常更大。</>:<>Ten fixed slots and full-catalog candidates keep absolute values low; active users typically have larger <KatexMath latex={String.raw`|T_u|`} />.</>}</li><li>{zh?'未曝光电影的缺失评分不是负例。':'Missing ratings for unexposed movies are not negatives.'}</li></ul></article>
      <article class="engineering-diagnostics"><h3>{zh?'工程与分数诊断':'Engineering and score diagnostics'}</h3><ul class="card-points"><li>User-CF: fit {user.system.fitSeconds.toFixed(2)} s · recommend {user.system.recommendSeconds.toFixed(2)} s · {user.system.usersPerSecond.toFixed(0)} {zh?'用户/秒':'users/s'} · {user.system.neighborArtifactMiB.toFixed(2)} MiB</li><li>Item-CF: fit {item.system.fitSeconds.toFixed(2)} s · recommend {item.system.recommendSeconds.toFixed(2)} s · {item.system.usersPerSecond.toFixed(0)} {zh?'用户/秒':'users/s'} · {item.system.neighborArtifactMiB.toFixed(2)} MiB</li><li>{zh?'fitSeconds 只覆盖相似度与邻居产物构建；recommendSeconds 覆盖全体评估用户的打分、过滤已看和 Top-10 选择。usersPerSecond = rankingUsers / recommendSeconds。':'fitSeconds covers similarity and neighbor-artifact construction only. recommendSeconds covers scoring, seen-item removal, and Top-10 selection for all ranking users. usersPerSecond = rankingUsers / recommendSeconds.'}</li><li>{zh?'neighborArtifactMiB 只计算稀疏相似度 CSR 的 data、indices 与 indptr 数组，不是 Python 进程峰值内存。':'neighborArtifactMiB counts only the sparse-similarity CSR data, indices, and indptr arrays; it is not peak process memory.'}</li><li>{zh?`Item-CF 有 ${pct(itemTieStats.fullyTiedListShare)} 的个性化列表 Top-10 原始分完全并列；${pct(itemFiveStarOnlyShare)} 的条目只由 5 星历史贡献。`:`Item-CF has fully tied raw Top-10 scores in ${pct(itemTieStats.fullyTiedListShare)} of personalized lists; ${pct(itemFiveStarOnlyShare)} of entries receive evidence only from five-star history.`}</li><li>{zh?`上下文：${metrics.runtime.platform}，Python ${metrics.runtime.python}，CPU、单进程离线批处理；没有固定 BLAS 线程数。计时不含数据加载和写产物，不能解释为线上单请求延迟。`:`Context: ${metrics.runtime.platform}, Python ${metrics.runtime.python}, CPU, single-process offline batch; BLAS thread count was not fixed. Timing excludes data load and artifact writes and is not online single-request latency.`}</li></ul></article>
    </div>
    <h3>{zh?'补充指标词典':'Additional metric definitions'}</h3>
    <aside><h3>{zh?'百分比只能在同一指标内比较':'Compare percentages only within the same metric'}</h3><p>{zh?'15% Hit Rate、4% NDCG 与 45% Coverage 回答完全不同的问题，不能因为数字大小不同就直接判断好坏。Hit Rate、Recall、NDCG 越高表示对应离线排序问题更好；RMSE/MAE 越低越好；Coverage、Long-tail、Novelty 是目录分布诊断，不代表用户效果。':'15% Hit Rate, 4% NDCG, and 45% Coverage answer different questions; their magnitudes cannot be compared directly. Higher Hit Rate, Recall, and NDCG improve their specific offline-ranking questions; lower RMSE/MAE is better; Coverage, Long-tail, and Novelty diagnose distribution rather than user impact.'}</p></aside>
    <div class="metric-dictionary">
      <article class="catalog-metric"><h4>{zh?'目录与长尾 ↑':'Catalog and long tail ↑'}</h4><KatexMath latex={String.raw`\mathrm{Coverage}=\frac{|\cup_{u\in U}R_u^{10}|}{|C|}`} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`R_u^{10}`,description:zh?'用户 u 的十个推荐。':'user u’s Top-10.'},{latex:String.raw`U`,description:zh?'评估用户集合。':'evaluation-user set.'},{latex:String.raw`C`,description:zh?`包含 ${metrics.evaluationPopulation.fittedCatalogMovies.toLocaleString()} 部电影的拟合目录。`:`fitted catalog of ${metrics.evaluationPopulation.fittedCatalogMovies.toLocaleString()} movies.`}]} /><p>{zh?'Long-tail Share 是所有推荐条目中不属于拟合热门度前 20% 的比例。两者描述分布，不证明满意度。':'Long-tail Share is the fraction of all recommendation entries outside the top 20% by fitted popularity. Both describe distribution, not satisfaction.'}</p><div class="paired-values"><div><span>User-CF · Coverage</span><strong>{pct(user.beyondAccuracy.catalog_coverage)}</strong><small>{pct(user.beyondAccuracy.long_tail_share)} {zh?'长尾比例':'long-tail share'}</small></div><div><span>Item-CF · Coverage</span><strong>{pct(item.beyondAccuracy.catalog_coverage)}</strong><small>{pct(item.beyondAccuracy.long_tail_share)} {zh?'长尾比例':'long-tail share'}</small></div></div><ul class="card-points"><li>{zh?`热门基线覆盖仅 ${pct(popularity.beyondAccuracy.catalog_coverage)}，长尾比例为 ${pct(popularity.beyondAccuracy.long_tail_share)}；个性化方法把推荐分散到更多电影。`:`Popularity covers only ${pct(popularity.beyondAccuracy.catalog_coverage)} with ${pct(popularity.beyondAccuracy.long_tail_share)} long-tail share; personalized methods distribute recommendations across more movies.`}</li><li>{zh?'Coverage 和 Long-tail Share 越高只表示目录分布更广，不证明用户更满意。':'Higher coverage and long-tail share mean broader catalog distribution, not greater user satisfaction.'}</li></ul></article>
      <article><h4>Novelty · {zh?'分布诊断':'distribution diagnostic'}</h4><KatexMath latex={String.raw`\mathrm{Novelty}=\frac{1}{M}\sum_{x=1}^{M}-\log_2\frac{count(i_x)}{\sum_{j\in C}count(j)}`} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`M`,description:zh?'全部用户推荐条目的总数。':'total recommendation entries across users.'},{latex:String.raw`i_x`,description:zh?'第 x 个被推荐电影。':'movie in recommendation entry x.'},{latex:String.raw`count(i)`,description:zh?'电影 i 在拟合数据中的评分次数。':'fitted rating count for movie i.'},{latex:String.raw`C`,description:zh?'拟合电影目录。':'fitted movie catalog.'}]} /><p>{zh?'越少见的电影自信息越高；它不等于真实惊喜、满意度或发现价值。':'Rarer movies carry more self-information; this is not observed surprise, satisfaction, or discovery value.'}</p></article>
      <article><h4>RMSE / MAE ↓</h4><KatexMath latex={String.raw`\mathrm{RMSE}=\sqrt{\frac{1}{N}\sum(\tilde r_{ui}-r_{ui})^2},\quad \mathrm{MAE}=\frac{1}{N}\sum|\tilde r_{ui}-r_{ui}|`} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`N`,description:zh?'测试评分行数。':'number of test-rating rows.'},{latex:String.raw`\tilde r_{ui}`,description:zh?'截断到 1–5 的预测评分。':'prediction clipped to the 1–5 scale.'},{latex:String.raw`r_{ui}`,description:zh?'用户 u 对电影 i 的真实测试评分。':'observed test rating by u for i.'}]} /><p>{zh?'它们在所有测试评分行上聚合，衡量评分误差；不证明 Top-10 排序或业务效果。':'They aggregate over all test-rating rows and measure rating error; they do not prove Top-10 ranking or business impact.'}</p></article>
    </div>
    <figure><img src={href('/artifacts/movielens/model-ranking.svg')} width="720" height="396" loading="lazy" alt={zh?'三种 MovieLens 方法的 Hit Rate、NDCG 和 Recall 柱状图':'Hit Rate, NDCG, and Recall bars for three MovieLens methods'} /><figcaption>{zh?`同一测试协议下，${accuracyWinner.label} 的 NDCG@10 最高（${pct(accuracyWinner.value,2)}）。Popularity / User-CF / Item-CF 的覆盖分别为 ${pct(popularity.beyondAccuracy.catalog_coverage)} / ${pct(user.beyondAccuracy.catalog_coverage)} / ${pct(item.beyondAccuracy.catalog_coverage)}；准确性与目录分布必须一起判断。`:`Under the same test protocol, ${accuracyWinner.label} leads NDCG@10 at ${pct(accuracyWinner.value,2)}. Popularity / User-CF / Item-CF cover ${pct(popularity.beyondAccuracy.catalog_coverage)} / ${pct(user.beyondAccuracy.catalog_coverage)} / ${pct(item.beyondAccuracy.catalog_coverage)} of the catalog; accuracy and distribution must be judged together.`}</figcaption></figure>
  </section>

  <section id="ml-8" class="case-step">
    <p class="step-label">Step 8</p><h2>{copy.evaluationTitle}</h2><p>{copy.evaluation}</p>
    <h3>{zh?'证据支持的结论':'What the evidence supports'}</h3><ul><li>{zh?`Popularity 仍是强非个性化基线和可靠 fallback：NDCG@10 为 ${pct(popularity.test.ndcg_at_10,2)}，但覆盖只有 ${pct(popularity.beyondAccuracy.catalog_coverage)}。热门头部集中解释了它为何容易命中，不能据此宣布个性化没有价值。`:`Popularity remains a strong non-personalized baseline and fallback: ${pct(popularity.test.ndcg_at_10,2)} NDCG@10 with only ${pct(popularity.beyondAccuracy.catalog_coverage)} coverage. Head concentration explains frequent hits; it does not make personalization valueless.`}</li><li>{zh?`bias-aware User-CF 的 NDCG@10 为 ${pct(user.test.ndcg_at_10,2)}、覆盖 ${pct(user.beyondAccuracy.catalog_coverage)}、长尾 ${pct(user.beyondAccuracy.long_tail_share)}，体现准确性与分布的具体取舍。`:`Bias-aware User-CF reaches ${pct(user.test.ndcg_at_10,2)} NDCG@10, ${pct(user.beyondAccuracy.catalog_coverage)} coverage, and ${pct(user.beyondAccuracy.long_tail_share)} long-tail share—a concrete accuracy/distribution trade-off.`}</li><li>{zh?`bias-aware Item-CF 将 v3 NDCG@10 从 ${pct(legacyItem.test.ndcg_at_10,2)} 提高到 ${pct(item.test.ndcg_at_10,2)}，同时完全同分率从 ${pct(legacyItemTieStats.fullyTiedListShare)} 降到 ${pct(itemTieStats.fullyTiedListShare)}；这证明旧排序退化已修复，但仍只是离线证据。`:`Bias-aware Item-CF moves v3 NDCG@10 from ${pct(legacyItem.test.ndcg_at_10,2)} to ${pct(item.test.ndcg_at_10,2)} while reducing fully tied lists from ${pct(legacyItemTieStats.fullyTiedListShare)} to ${pct(itemTieStats.fullyTiedListShare)}. The ranking defect is repaired, but the evidence remains offline.`}</li></ul>
    <aside><h3>{zh?'Post-hoc 限制':'Post-hoc limitation'}</h3><p>{zh?<>v4 的改进方向来自已经看过的 v3 Test 同分诊断，因此不能描述为完全未触碰测试集的确认性实验。所有新参数仍只由 Train/Validation 选择，Test 只在配置锁定后做最终对照；<KatexMath latex={String.raw`r_{ui}^{\mathrm{test}}\ge5`} /> 结果仅作只读敏感性分析。</>:<>The v4 direction was motivated by tie diagnostics already observed on the v3 test set, so this is not a fully untouched confirmatory experiment. New parameters still use Train/Validation only, Test is evaluated after configuration lock, and <KatexMath latex={String.raw`r_{ui}^{\mathrm{test}}\ge5`} /> is a read-only sensitivity analysis.</>}</p></aside>
    <aside><h3>{zh?'主要限制':'Primary limitations'}</h3><p>{zh?'评分是自选择且受曝光影响；缺失并非随机。纯 CF 无法处理没有交互的新用户或新电影。MovieLens 1M 年代较早、领域单一，并缺少会话和实时上下文。bootstrap 描述当前用户 cohort 的抽样不确定性，不证明因果效果。':'Ratings are self-selected and exposure-dependent, so missingness is not random. Pure CF cannot solve new-user or new-item cold start. MovieLens 1M is old, single-domain, and lacks session or real-time context. Bootstrap intervals describe sampling uncertainty for this cohort, not causal impact.'}</p></aside>
    <h3>{zh?'排序后的下一步':'Ranked next steps'}</h3><ol><li>{zh?'保留当前并列诊断与证据强度展示；若改变 Item-CF 打分，必须重新走验证选择。':'Keep tie diagnostics and evidence strength visible; any Item-CF scoring change must return to validation selection.'}</li><li>{zh?'在同一时间协议下测试明确的类型内容 + CF 混合规则，并预先定义 NDCG/覆盖取舍。':'Test a defined genre-content plus CF hybrid under the same temporal protocol, with a predeclared NDCG/coverage rule.'}</li><li>{zh?'把 SVD 作为单独的模型化 CF 决策实验，而不是当前页面的附加模型。':'Evaluate SVD as a separate model-based CF decision study, not an extra model on this page.'}</li><li>{zh?'线上按用户随机分流，预先定义播放开始、有效观看、留存、延迟和长尾曝光护栏。':'Run a user-randomized online test with predefined play-start, qualified watch, retention, latency, and tail-exposure guardrails.'}</li></ol>
    <div class="bridge"><a href={href(`/${lang}/projects/spotify-content-recommender/`)}>{zh?'对照 Spotify 内容推荐 →':'Compare with Spotify content recommendation →'}</a></div>
    <details class="reproduction"><summary>{zh?'复现实验与测试命令':'Reproduction and test commands'}</summary><pre><code>{commands}</code></pre><p>{zh?'标准发布检查使用 uv run pytest；仓库还提供确定性的 fallback runner，在受限桌面环境无法正常启动 pytest 时执行同一组现有测试函数。':'The standard release check uses uv run pytest. A deterministic fallback runner executes the same existing test functions if a constrained desktop runtime cannot start pytest normally.'}</p></details>
  </section>

  <section id="ml-9" class="case-step wide-step">
    <p class="step-label">Step 9</p><h2>{copy.labTitle}</h2><p>{copy.lab}</p>
    <MovieLensExplorer client:visible lang={lang} samples={samples} />
  </section>
</div>

