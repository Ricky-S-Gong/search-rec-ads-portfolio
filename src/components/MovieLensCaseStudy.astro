---
import KatexMath from './KatexMath.astro';
import MovieLensExplorer from './MovieLensExplorer';
import { href, type Lang } from '../data/site';
import metrics from '../../public/artifacts/movielens/metrics.json';
import profileArtifact from '../../public/artifacts/movielens/profile.json';
import comparisons from '../../public/artifacts/movielens/comparisons.json';
import samples from '../../public/artifacts/movielens/samples.json';

const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';
const profile = profileArtifact.profile;
const user = metrics.models.find((model) => model.key === 'user-cf')!;
const item = metrics.models.find((model) => model.key === 'item-cf')!;
const popularity = metrics.baselines.bayesianPopularity;
const userValidation = comparisons.validation.find((entry) => entry.mode === 'user')!;
const itemValidation = comparisons.validation.find((entry) => entry.mode === 'item')!;
const pct = (value: number, digits = 1) => `${(value * 100).toFixed(digits)}%`;
const nav = zh
  ? ['一分钟总结','两种推荐信号','基础与矩阵','User-CF','Item-CF','实验设计','指标','选择与结果','推荐对比','决策与复现']
  : ['60-second summary','Two recommendation signals','Foundations & matrix','User-CF','Item-CF','Experiment','Metrics','Selection & results','List comparison','Decision & reproduction'];
const interviews = zh ? [
  ['什么是协同过滤？','它不先看物品属性，而是利用许多用户共同的互动模式来推荐。'],
  ['User-CF 与 Item-CF 有什么区别？','User-CF 找兴趣相近的人；Item-CF 找被相同人以相似方式评分的物品。'],
  ['为什么先减用户均值？','有人习惯打高分，有人严格；中心化让相对喜欢程度更可比。'],
  ['余弦、Pearson 与 adjusted cosine？','余弦比较向量方向；中心化后的用户余弦接近 Pearson；Item-CF 对每位用户中心化后再算余弦。'],
  ['为什么需要支持度和收缩？','只有两次共同评分的高相似度可能是巧合；最小支持度过滤它，收缩继续降低小样本相似度。'],
  ['为什么按时间切分？','上线时只能用过去预测未来；随机切分可能把未来兴趣泄漏进训练。'],
  ['RMSE 与 NDCG 的区别？','RMSE 衡量评分数值误差；NDCG 衡量相关物品是否出现在列表前面。低 RMSE 不保证好的 Top-10。'],
  ['为什么热门基线更强？','未来正例高度集中在头部，加上完整目录任务困难；热门方法容易命中，但牺牲覆盖与个性化。'],
  ['如何扩展？','离线分块计算稀疏 Top-K 邻居，增量更新热门物品，并用缓存服务候选；规模更大时再考虑近似检索或模型化 CF。'],
  ['A/B 测试怎么做？','先定义主指标与护栏，按用户随机分流，保持候选位置一致，观察点击、有效观看、留存、长尾曝光与延迟。'],
] : [
  ['What is collaborative filtering?','It recommends from patterns shared across many users rather than starting with item attributes.'],
  ['User-CF versus Item-CF?','User-CF finds people with similar taste; Item-CF finds items rated similarly by many of the same people.'],
  ['Why mean-center ratings?','Some people rate generously and others strictly. Centering makes relative preference comparable.'],
  ['Cosine, Pearson, and adjusted cosine?','Cosine compares vector direction; cosine on centered user vectors resembles Pearson; adjusted cosine centers within each user before comparing items.'],
  ['Why support and shrinkage?','A high similarity from two co-ratings may be luck. Minimum support removes it and shrinkage further discounts small samples.'],
  ['Why a temporal split?','Production uses the past to predict the future; random splitting can leak later taste into training.'],
  ['RMSE versus NDCG?','RMSE measures numeric rating error. NDCG asks whether relevant items appear near the top. Lower RMSE does not guarantee a better Top-10.'],
  ['Why did popularity win?','Future positives are concentrated in popular movies and full-catalog ranking is hard. Popularity hits the head but sacrifices coverage and personalization.'],
  ['How would you scale it?','Precompute sparse Top-K neighbors in blocks, update popular items incrementally, and cache candidates; use approximate or model-based retrieval at larger scale.'],
  ['How would you A/B test it?','Predefine a primary metric and guardrails, randomize by user, keep placement fixed, and measure clicks, qualified viewing, retention, long-tail exposure, and latency.'],
];
const commands = `uv sync --locked
uv run python research/movielens-cf/download_data.py
uv run python research/movielens-cf/run_experiment.py --smoke --output /tmp/movielens-smoke
uv run python research/movielens-cf/run_experiment.py
uv run pytest
npm test
npm run check
npm run dev
npm run build`;
---

<nav class="case-nav" aria-label={zh ? 'MovieLens 项目章节' : 'MovieLens case-study sections'}>{nav.map((label, index) => <a href={`#ml-${index + 1}`}>{index + 1}. {label}</a>)}</nav>
<div class="case-study">
  <section id="ml-1" class="case-step summary-step">
    <p class="step-label">{zh ? '先看结论' : 'Start with the answer'}</p><h2>{zh ? '一分钟理解这个项目' : 'Understand the project in sixty seconds'}</h2>
    <div class="summary-grid"><article><span>{zh ? '问题' : 'Problem'}</span><p>{zh ? '流媒体平台已经有用户的 1–5 星评分。怎样从用户没评过的电影中选出 10 部候选？' : 'A streaming service already has 1–5 star ratings. How can it choose ten candidates from movies each user has not rated?'}</p></article><article><span>{zh ? '比较' : 'Compared'}</span><p>{zh ? '所有人相同的热门榜、寻找相似用户的 User-CF、寻找相似电影的 Item-CF。' : 'One popularity list for everyone, User-CF that finds similar people, and Item-CF that finds similarly rated movies.'}</p></article><article><span>{zh ? '真实结果' : 'Honest result'}</span><p>{zh ? `热门榜的 NDCG@10 最高；User-CF 接近它并覆盖更多目录，Item-CF 排序较弱但覆盖 ${pct(item.beyondAccuracy.catalog_coverage)}。` : `Popularity has the highest NDCG@10. User-CF comes close with broader reach; Item-CF ranks worse but covers ${pct(item.beyondAccuracy.catalog_coverage)} of the catalog.`}</p></article></div>
    <aside><strong>{zh ? '这不是线上效果' : 'This is not online impact'}</strong><p>{zh ? '实验只使用历史显式评分。它没有测量曝光、点击、观看时长、留存或收入。' : 'The experiment uses historical explicit ratings only. It does not measure impressions, clicks, watch time, retention, or revenue.'}</p></aside>
  </section>

  <section id="ml-2" class="case-step">
    <p class="step-label">Content × behavior</p><h2>{zh ? 'Spotify 与 MovieLens 回答不同问题' : 'Spotify and MovieLens answer different questions'}</h2>
    <div class="signal-bridge"><a href={href(`/${lang}/projects/spotify-content-recommender/`)}><span>Spotify · Content-based</span><strong>{zh ? '哪些歌曲的可测属性相似？' : 'Which tracks have similar measurable attributes?'}</strong><small>{zh ? '适合新物品与相似内容入口' : 'Useful for new items and similar-content surfaces'}</small></a><b>+</b><a href="#ml-3"><span>MovieLens · Collaborative</span><strong>{zh ? '相似的人或共同评分的电影偏好什么？' : 'What do similar people or similarly rated movies prefer?'}</strong><small>{zh ? '适合行为个性化' : 'Useful for behavioral personalization'}</small></a><b>→</b><div><span>{zh ? '未来混合系统' : 'Future hybrid'}</span><strong>{zh ? '内容 + 行为 + 场景' : 'content + behavior + context'}</strong><small>{zh ? '这是未测试的下一步，不是本实验结果' : 'An untested next step, not an observed result'}</small></div></div>
    <p>{zh ? '在生产系统里，这些方法通常生成候选；后续排序器再结合新鲜度、业务规则和上下文。' : 'In a production system these methods commonly generate candidates; a later ranker can add freshness, business rules, and context.'}</p>
  </section>

  <section id="ml-3" class="case-step">
    <p class="step-label">Recommendation foundations</p><h2>{zh ? '先读懂评分矩阵' : 'First, learn to read the rating matrix'}</h2>
    <div class="foundation-grid"><article><strong>{zh ? '显式反馈' : 'Explicit feedback'}</strong><p>{zh ? '用户主动给出的 1–5 星评分。本项目拥有这种信号。' : 'A 1–5 star rating a user deliberately gives. This project has this signal.'}</p></article><article><strong>{zh ? '隐式反馈' : 'Implicit feedback'}</strong><p>{zh ? '曝光、点击、播放、停留等行为；这份数据没有这些信号。' : 'Impressions, clicks, plays, or dwell time; this dataset does not contain them.'}</p></article><article><strong>{zh ? '评分预测' : 'Rating prediction'}</strong><p>{zh ? '预测一个分数，使用 RMSE/MAE 诊断。' : 'Predict one numeric rating, diagnosed with RMSE/MAE.'}</p></article><article><strong>Top-N ranking</strong><p>{zh ? '把未看电影排序并返回前 10；这是主要任务。' : 'Order unseen movies and return ten; this is the primary task.'}</p></article></div>
    <div class="toy-matrix" role="region" tabindex="0" aria-label={zh ? '用户电影玩具评分矩阵' : 'Toy user movie rating matrix'}><table><thead><tr><th>{zh ? '用户' : 'User'}</th><th>Toy Story</th><th>Matrix</th><th>Titanic</th><th>Terminator</th></tr></thead><tbody><tr><th>Alice</th><td>5</td><td>5</td><td class="missing">?</td><td>1</td></tr><tr><th>Bob</th><td>5</td><td>4</td><td>2</td><td>1</td></tr><tr><th>Carol</th><td>1</td><td>2</td><td>5</td><td>5</td></tr></tbody></table></div>
    <ul class="matrix-notes"><li>{zh ? '行是一位用户；User-CF 比较行。Alice 与 Bob 很接近。' : 'A row is one user; User-CF compares rows. Alice and Bob look similar.'}</li><li>{zh ? '列是一部电影；Item-CF 比较列。Toy Story 与 Matrix 很接近。' : 'A column is one movie; Item-CF compares columns. Toy Story and Matrix look similar.'}</li><li><strong>?</strong> {zh ? '表示没有观察到评分，不等于不喜欢，也不会被填成 0。' : 'means unobserved—not disliked—and is never replaced with zero.'}</li></ul>
    <div class="data-stats"><article><span>{zh ? '用户' : 'users'}</span><strong>{profile.users.toLocaleString()}</strong></article><article><span>{zh ? '评分' : 'ratings'}</span><strong>{profile.ratings.toLocaleString()}</strong></article><article><span>{zh ? '有评分电影' : 'rated movies'}</span><strong>{profile.ratedMovies.toLocaleString()}</strong></article><article><span>{zh ? '空缺矩阵单元' : 'empty cells'}</span><strong>{pct(profile.sparsity,2)}</strong></article></div>
  </section>

  <section id="ml-4" class="case-step algorithm-step">
    <p class="step-label">User-Based Collaborative Filtering</p><h2>{zh ? 'User-CF：向品味相近的人借证据' : 'User-CF: borrow evidence from similar people'}</h2>
    <p class="plain-intuition">{zh ? '一句话：Alice 和 Bob 对共同看过的电影评价相似，因此 Bob 喜欢而 Alice 没看过的电影可以成为候选。' : 'In one sentence: Alice and Bob rate shared movies similarly, so a movie Bob liked and Alice has not seen becomes a candidate.'}</p>
    <div class="walkthrough"><ol><li>{zh ? '对每位用户减去自己的平均分，消除宽松或严格的打分习惯。' : 'Subtract each user’s mean to remove generous-versus-strict rating habits.'}</li><li>{zh ? '只在共同评分电影上计算正的余弦相似度。' : 'Calculate positive cosine similarity over co-rated movies.'}</li><li>{zh ? '至少需要共同评分支持，并对小样本相似度做收缩。' : 'Require co-rating support and shrink small-sample similarities.'}</li><li>{zh ? '用相似用户的评分残差做加权平均，再加回 Alice 的均值。' : 'Average neighbors’ rating residuals, then add Alice’s mean back.'}</li></ol></div>
    <div class="formula-teach"><KatexMath display latex={String.raw`\hat r_{ui}=\bar r_u+\frac{\sum_{v\in N_k(u,i)}s(u,v)(r_{vi}-\bar r_v)}{\sum_{v\in N_k(u,i)}|s(u,v)|}`} /><p>{zh ? 'u 是目标用户，i 是候选电影，v 是邻居，r 是观察评分，r̄ 是用户均值，s 是收缩后的相似度，Nₖ 是最多 k 个对电影 i 有评分的邻居。' : 'u is the target user, i the candidate movie, v a neighbor, r an observed rating, r̄ a user mean, s the shrunk similarity, and Nₖ up to k neighbors who rated movie i.'}</p></div>
    <div class="toy-calc"><strong>{zh ? '玩具计算' : 'Toy calculation'}</strong><p>{zh ? 'Alice 均值 3.0。Bob 的相似度 0.8，Bob 对候选的评分比自己均值高 1.5；Dan 的相似度 0.4，残差为 0.5。预测 = 3.0 + (0.8×1.5 + 0.4×0.5)/(0.8+0.4) = 4.17。' : 'Alice’s mean is 3.0. Bob has similarity 0.8 and rated the candidate 1.5 above his mean; Dan has similarity 0.4 and residual 0.5. Prediction = 3.0 + (0.8×1.5 + 0.4×0.5)/(0.8+0.4) = 4.17.'}</p></div>
    <p>{zh ? `验证集选择 k=${user.hyperparameters.k}、最小共同评分 ${user.hyperparameters.min_support}、收缩 ${user.hyperparameters.shrinkage}、至少 ${user.hyperparameters.min_neighbors} 个评分邻居。证据不足时回退到 Bayesian popularity；最终 Top-10 中回退占 ${pct(user.system.fallbackShare)}。` : `Validation selected k=${user.hyperparameters.k}, minimum co-rating support ${user.hyperparameters.min_support}, shrinkage ${user.hyperparameters.shrinkage}, and at least ${user.hyperparameters.min_neighbors} raters. Insufficient evidence falls back to Bayesian popularity; fallback is ${pct(user.system.fallbackShare)} of final Top-10 entries.`}</p>
    <div class="algorithm-footer"><a href={href(`/${lang}/algorithms/user-based-cf/`)}>{zh ? '学习通用 User-CF →' : 'Learn the general User-CF method →'}</a><span>{zh ? '优势：直观的人群解释' : 'Strength: intuitive people-based evidence'}</span><span>{zh ? '限制：用户邻居会变化，在线计算较重' : 'Limit: user neighborhoods drift and cost more online'}</span></div>
  </section>

  <section id="ml-5" class="case-step algorithm-step">
    <p class="step-label">Item-Based Collaborative Filtering</p><h2>{zh ? 'Item-CF：从你喜欢的电影走向相似电影' : 'Item-CF: move from liked movies to related movies'}</h2>
    <p class="plain-intuition">{zh ? '一句话：如果大量用户对 Toy Story 与 Toy Story 2 的相对评价相近，两部电影就形成一条行为关系。' : 'In one sentence: if many users rate Toy Story and Toy Story 2 similarly relative to their own scales, the movies form a behavioral relationship.'}</p>
    <div class="formula-teach"><KatexMath display latex={String.raw`s(i,j)=\frac{\sum_{u\in U_{ij}}(r_{ui}-\bar r_u)(r_{uj}-\bar r_u)}{\sqrt{\sum_{u\in U_{ij}}(r_{ui}-\bar r_u)^2}\sqrt{\sum_{u\in U_{ij}}(r_{uj}-\bar r_u)^2}}`} /><p>{zh ? 'i、j 是两部电影，Uᵢⱼ 是同时评价过它们的用户。减去每位用户自己的均值后再算余弦，这就是 adjusted cosine。' : 'i and j are movies and Uᵢⱼ contains users who rated both. Subtracting each user’s own mean before cosine gives adjusted cosine.'}</p></div>
    <div class="toy-calc"><strong>{zh ? '为什么更适合相关电影入口？' : 'Why does this fit related-movie surfaces?'}</strong><p>{zh ? '电影—电影邻居可以离线预计算。请求到达时，只需从用户已经喜欢的电影出发合并少量邻居，并给出“因为你喜欢 X”的解释。' : 'Movie-to-movie neighbors can be precomputed offline. At request time the service merges a few neighbors of movies the user liked and can say “because you liked X.”'}</p></div>
    <p>{zh ? `验证集选择 k=${item.hyperparameters.k}、最小共同评分 ${item.hyperparameters.min_support}、收缩 ${item.hyperparameters.shrinkage}、至少 ${item.hyperparameters.min_neighbors} 个已看邻居。CPU 批量速度约 ${Math.round(item.system.usersPerSecond).toLocaleString()} 用户/秒；新电影没有评分时仍然冷启动。` : `Validation selected k=${item.hyperparameters.k}, minimum co-rating support ${item.hyperparameters.min_support}, shrinkage ${item.hyperparameters.shrinkage}, and at least ${item.hyperparameters.min_neighbors} seen neighbors. CPU batch throughput is about ${Math.round(item.system.usersPerSecond).toLocaleString()} users/second; a new movie with no ratings still has cold start.`}</p>
    <div class="algorithm-footer"><a href={href(`/${lang}/algorithms/item-based-cf/`)}>{zh ? '学习通用 Item-CF →' : 'Learn the general Item-CF method →'}</a><span>{zh ? '优势：稳定、可缓存、解释直接' : 'Strength: stable, cacheable, direct explanation'}</span><span>{zh ? '限制：热门共现偏差与新物品冷启动' : 'Limit: popular co-occurrence bias and item cold start'}</span></div>
  </section>

  <section id="ml-6" class="case-step">
    <p class="step-label">Past → future</p><h2>{zh ? '实验设计：模型不能偷看未来' : 'Experiment design: the model cannot peek into the future'}</h2>
    <div class="timeline"><b>80% <small>{zh ? '训练相似度' : 'fit similarities'}</small></b><b>10% <small>{zh ? '选择参数' : 'select parameters'}</small></b><b>10% <small>{zh ? '只测一次' : 'test once'}</small></b></div>
    <ol class="protocol"><li>{zh ? '每位用户内部先按时间排序，而不是随机切分。' : 'Sort within each user by time instead of randomly splitting.'}</li><li>{zh ? '只有评分 ≥ 4 的未来电影算相关；未评分不当作负例。' : 'Only future ratings ≥ 4 count as relevant; missing ratings are not negatives.'}</li><li>{zh ? '从训练目录里删除用户已看电影，然后对剩余完整目录排序，不抽样“容易的负例”。' : 'Remove seen movies and rank the entire remaining fitted catalog—no easy sampled negatives.'}</li><li>{zh ? `验证完成后用训练+验证重新拟合，最终对 ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} 位有相关测试电影的用户计算 K=10。` : `After validation, refit on train+validation and evaluate K=10 for ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} users with relevant test movies.`}</li></ol>
  </section>

  <section id="ml-7" class="case-step">
    <p class="step-label">What each number asks</p><h2>{zh ? '指标不是“推荐准确率百分比”' : 'The metrics are not “percent recommendation accuracy”'}</h2>
    <div class="metric-lessons"><article><h3>NDCG@10 ↑</h3><p>{zh ? '相关电影越靠前，得分越高；还会按该用户相关电影数量归一化。完整目录中正例很少，所以数值可能很小。' : 'Rewards relevant movies more when they appear near the top and normalizes by each user’s ideal list. With few positives in a full catalog, values can be small.'}</p><small>{zh ? '问题：好电影排得够靠前吗？' : 'Question: are good movies near the top?'}</small></article><article><h3>Recall@10 ↑</h3><p>{zh ? '未来相关电影中，有多少进入 Top-10。例：4 部相关电影命中 1 部，Recall=25%。' : 'The share of future relevant movies recovered in ten slots. One hit among four relevant movies gives 25% recall.'}</p><small>{zh ? '问题：十个位置找回多少正例？' : 'Question: how many positives fit in ten slots?'}</small></article><article><h3>{zh ? '目录覆盖率 ↑' : 'Catalog coverage ↑'}</h3><p>{zh ? '所有用户的推荐合起来触达多少目录。它可能与准确性冲突：热门榜容易命中，却反复展示少数电影。' : 'How much of the catalog appears across all lists. It can conflict with accuracy: popularity may hit while repeating very few movies.'}</p><small>{zh ? '问题：系统只展示头部吗？' : 'Question: does the system expose only the head?'}</small></article><article><h3>{zh ? '长尾占比 / 新颖度 ↑' : 'Long-tail share / novelty ↑'}</h3><p>{zh ? '长尾定义为训练流行度后 80%；新颖度用训练概率的负对数。更高不一定更好，偏离兴趣也会升高。' : 'Long tail means the bottom 80% by training popularity; novelty is negative log training probability. Higher can also mean less relevant.'}</p><small>{zh ? '问题：推荐有多少不热门内容？' : 'Question: how much less-popular content appears?'}</small></article><article><h3>RMSE / MAE ↓</h3><p>{zh ? `评分误差诊断使用截断到 1–5 的预测。Bias baseline RMSE=${metrics.baselines.biasRating.rmse.toFixed(3)}，但低 RMSE 不保证 Top-10 顺序更好。` : `Rating-error diagnostics clip estimates to 1–5. Bias baseline RMSE is ${metrics.baselines.biasRating.rmse.toFixed(3)}, but low RMSE does not guarantee a better Top-10 order.`}</p><small>{zh ? '问题：数字评分预测得多接近？' : 'Question: how close are numeric rating estimates?'}</small></article><article><h3>95% bootstrap interval</h3><p>{zh ? '重复抽取用户并计算平均指标，描述这批用户上的抽样不确定性；它不证明因果效果，也不替代线上实验。' : 'Resamples users and recomputes the mean to describe sampling uncertainty for this cohort. It proves neither causality nor online lift.'}</p><small>User-CF NDCG: {pct(user.confidence95.ndcgAt10[0],2)}–{pct(user.confidence95.ndcgAt10[1],2)}</small></article></div>
  </section>

  <section id="ml-8" class="case-step wide-step">
    <p class="step-label">Validation first, test once</p><h2>{zh ? '参数选择与真实结果' : 'Parameter selection and honest results'}</h2>
    <h3>{zh ? '验证集候选' : 'Validation candidates'}</h3><div class="validation-grid">{[userValidation,itemValidation].map((group) => <article><h4>{group.mode === 'user' ? 'User-CF' : 'Item-CF'}</h4><div class="table-wrap" role="region" tabindex="0"><table><thead><tr><th>k</th><th>{zh ? '支持度' : 'support'}</th><th>{zh ? '收缩' : 'shrink'}</th><th>NDCG@10</th><th>Recall@10</th></tr></thead><tbody>{group.candidates.map((candidate) => <tr class:list={{selected: candidate.params.k === group.selected.k && candidate.params.min_support === group.selected.min_support}}><td>{candidate.params.k}</td><td>{candidate.params.min_support}</td><td>{candidate.params.shrinkage}</td><td>{pct(candidate.metrics.ndcg_at_10,2)}</td><td>{pct(candidate.metrics.recall_at_10,2)}</td></tr>)}</tbody></table></div></article>)}</div>
    <h3>{zh ? '最终测试' : 'Final test'}</h3><div class="table-wrap results-table" role="region" tabindex="0"><table><thead><tr><th>{zh ? '方法' : 'Method'}</th><th>NDCG@10 ↑</th><th>Recall@10 ↑</th><th>{zh ? '覆盖率 ↑' : 'Coverage ↑'}</th><th>{zh ? '长尾 ↑' : 'Long tail ↑'}</th></tr></thead><tbody><tr><th>Bayesian popularity</th><td>{pct(popularity.test.ndcg_at_10,2)}</td><td>{pct(popularity.test.recall_at_10,2)}</td><td>{pct(popularity.beyondAccuracy.catalog_coverage)}</td><td>{pct(popularity.beyondAccuracy.long_tail_share)}</td></tr><tr><th>User-CF</th><td>{pct(user.test.ndcg_at_10,2)}</td><td>{pct(user.test.recall_at_10,2)}</td><td>{pct(user.beyondAccuracy.catalog_coverage)}</td><td>{pct(user.beyondAccuracy.long_tail_share)}</td></tr><tr><th>Item-CF</th><td>{pct(item.test.ndcg_at_10,2)}</td><td>{pct(item.test.recall_at_10,2)}</td><td>{pct(item.beyondAccuracy.catalog_coverage)}</td><td>{pct(item.beyondAccuracy.long_tail_share)}</td></tr></tbody></table></div>
    <div class="finding-grid"><article><span>{zh ? '预期假设' : 'Expected hypotheses'}</span><p>{zh ? '个性化 CF 应提高排序；Item-CF 应更稳定、更适合服务；热门榜应覆盖很窄。' : 'Personalized CF should improve ranking; Item-CF should be stable and serviceable; popularity should have narrow reach.'}</p></article><article><span>{zh ? '观察结果' : 'Observed findings'}</span><p>{zh ? `热门榜排序最高。User-CF 接近且覆盖 ${pct(user.beyondAccuracy.catalog_coverage)}；Item-CF 覆盖 ${pct(item.beyondAccuracy.catalog_coverage)} 但排序较弱。` : `Popularity ranks highest. User-CF comes close and covers ${pct(user.beyondAccuracy.catalog_coverage)}; Item-CF reaches ${pct(item.beyondAccuracy.catalog_coverage)} but ranks worse.`}</p></article><article><span>{zh ? '解释' : 'Interpretation'}</span><p>{zh ? `未来相关电影有 ${pct(metrics.diagnostics.relevantItemHeadConcentration.top20PercentShare)} 来自最热门 20%。完整目录、稀疏邻居和评分饱和共同限制 CF。` : `${pct(metrics.diagnostics.relevantItemHeadConcentration.top20PercentShare)} of future relevant movies lie in the top 20% by popularity. Full-catalog difficulty, sparse support, and score saturation constrain CF.`}</p></article><article><span>{zh ? '未验证' : 'Not yet validated'}</span><p>{zh ? '混合加权、CTR、观看时长、留存、收入与因果增量都没有被本实验测量。' : 'Hybrid weighting, CTR, watch time, retention, revenue, and causal lift remain unmeasured.'}</p></article></div>
    <aside><strong>{zh ? '评分饱和修正' : 'Score-saturation correction'}</strong><p>{zh ? `旧版本先把分数截断再排序，使不同原始估计都变成 5.00。现在 Top-N 用未截断分数排序，评分误差仍使用 1–5 截断值。${pct(user.system.top10RawAboveRatingMaxShare)} 的个性化 User-CF Top-10 原始分数高于 5，所以界面同时标出“排序分”和“展示评分”。` : `The old version clipped before sorting, collapsing distinct raw estimates to 5.00. Top-N now uses raw scores while rating error still uses 1–5 clipped estimates. ${pct(user.system.top10RawAboveRatingMaxShare)} of personalized User-CF Top-10 raw scores exceed 5, so the explorer labels both rank score and display rating.`}</p></aside>
  </section>

  <section id="ml-9" class="case-step wide-step"><p class="step-label">Audit the lists</p><h2>{zh ? '同一个用户，三种方法直接对比' : 'Three methods, the same user, side by side'}</h2><p>{zh ? '固定用户覆盖低、中、高活动量，并且至少有一种方法命中未来相关电影。展开“为什么推荐”可以看到真实邻居贡献；相似电影模式展示 adjusted cosine 与共同评分支持度。' : 'Deterministic users cover low, medium, and high activity and have at least one held-out hit across methods. Expand “Why this movie?” for real neighbor contributions; related-movie mode exposes adjusted cosine and co-rating support.'}</p><MovieLensExplorer client:visible lang={lang} samples={samples} /></section>

  <section id="ml-10" class="case-step">
    <p class="step-label">Measured decision ≠ future hypothesis</p><h2>{zh ? '产品决策、系统设计与复现' : 'Product decision, system design, and reproduction'}</h2>
    <div class="decision-table"><div><strong>{zh ? '稀疏/新用户' : 'Sparse/new user'}</strong><p>Bayesian popularity</p><small>{zh ? '已测 fallback；没有个性化' : 'Measured fallback; not personalized'}</small></div><div><strong>{zh ? '首页候选' : 'Homepage candidates'}</strong><p>User-CF + popularity guardrail</p><small>{zh ? 'User-CF 是已测候选；混合权重尚未测' : 'User-CF measured; blend weight untested'}</small></div><div><strong>{zh ? '电影详情页' : 'Movie detail'}</strong><p>Item-CF</p><small>{zh ? '共同评分关系与直接解释已测' : 'Measured co-rating relation and explanation'}</small></div><div><strong>{zh ? '新电影' : 'New movie'}</strong><p>{zh ? '内容/编辑兜底' : 'Content/editorial fallback'}</p><small>{zh ? '本实验未实现；纯 CF 无法处理' : 'Not implemented here; pure CF cannot handle it'}</small></div><div><strong>{zh ? '长尾探索' : 'Long-tail exploration'}</strong><p>Item-CF candidates</p><small>{zh ? '覆盖已测，满意度未测' : 'Coverage measured; satisfaction unmeasured'}</small></div><div><strong>{zh ? '下一次实验' : 'Next experiment'}</strong><p>{zh ? '内容 + CF 混合 A/B' : 'Content + CF hybrid A/B'}</p><small>{zh ? '需要实际实现和线上随机实验' : 'Requires implementation and randomized online test'}</small></div></div>
    <div class="architecture" role="img" aria-label={zh ? '推荐系统生产架构' : 'Recommendation production architecture'}><span>{zh ? '评分事件' : 'rating events'}</span><b>→</b><span>{zh ? '数据校验与时间切分' : 'validation & temporal split'}</span><b>→</b><span>{zh ? '离线稀疏 Top-K 邻居' : 'offline sparse Top-K neighbors'}</span><b>→</b><span>{zh ? '候选服务 + 缓存 + 兜底' : 'candidate API + cache + fallback'}</span><b>→</b><span>{zh ? '排序与线上实验' : 'ranking & online experiment'}</span></div>
    <h3>{zh ? '必须记住的限制' : 'Limitations to remember'}</h3><ul><li>{zh ? '评分是主动选择，存在曝光偏差和 missing-not-at-random；没评分不代表不喜欢。' : 'Ratings are self-selected, exposed, and missing-not-at-random; no rating does not mean dislike.'}</li><li>{zh ? 'MovieLens 1M 发布于 2003 年，电影与产品场景有限，缺少会话、设备和实时上下文。' : 'MovieLens 1M was released in 2003, covers one domain, and lacks session, device, and real-time context.'}</li><li>{zh ? '用户兴趣会变化；当前相似度没有时间衰减，也没有增量更新实验。' : 'Taste changes; these similarities have no time decay and no measured incremental update strategy.'}</li></ul>
    <h3>{zh ? '面试快答' : 'Interview-ready answers'}</h3><div class="interview-grid">{interviews.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    <h3>{zh ? '复现命令' : 'Reproduction commands'}</h3><pre><code>{commands}</code></pre><p class="fine">{zh ? '原始数据保存在 gitignored 的 research/movielens-cf/data/。网页只读取轻量 JSON/SVG 产物。矩阵分解被保留为下一阶段的 model-based CF 对照；ALS/BPR/LightFM 会改变当前显式评分任务，因此没有为了“更多算法”而加入。' : 'Raw data stays in gitignored research/movielens-cf/data/. The site reads compact JSON/SVG artifacts only. Matrix factorization remains the next model-based CF comparison; ALS/BPR/LightFM would change the explicit-rating task and were not added merely for breadth.'}</p>
  </section>
</div>

