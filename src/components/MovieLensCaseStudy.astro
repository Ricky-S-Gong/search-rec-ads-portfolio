---
import { Code } from 'astro:components';
import KatexMath from './KatexMath.astro';
import FormulaLegend from './FormulaLegend.astro';
import MovieLensFlow from './MovieLensFlow.astro';
import MovieLensExplorer from './MovieLensExplorer';
import { href, type Lang } from '../data/site';
import metrics from '../../public/artifacts/movielens/metrics.json';
import profileArtifact from '../../public/artifacts/movielens/profile.json';
import comparisons from '../../public/artifacts/movielens/comparisons.json';
import samples from '../../public/artifacts/movielens/samples.json';

const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';
const profile = profileArtifact.profile;
const user = metrics.models.find((model) => model.key === 'user-cf')!;
const item = metrics.models.find((model) => model.key === 'item-cf')!;
const popularity = metrics.baselines.bayesianPopularity;
const userValidation = comparisons.validation.find((entry) => entry.mode === 'user')!;
const itemValidation = comparisons.validation.find((entry) => entry.mode === 'item')!;
const paired = metrics.diagnostics.pairedUserCfMinusPopularity.ndcgAt10;
const head = metrics.diagnostics.relevantItemHeadConcentration;
const itemTieStats = item.system.rankingTieStats!;
const itemFiveStarOnlyShare = item.system.top10FiveStarOnlyEvidenceShare ?? 0;
const split = metrics.splitCounts;
const splitTotal = split.trainRatings + split.validationRatings + split.testRatings;
const averageRelevant = head.relevantTestRatings / metrics.evaluationPopulation.rankingUsers;
const bayesianExamples = popularity.examples;
const popularityHitUsers = Math.round(popularity.test.hit_rate_at_10 * popularity.test.users);
const userHitUsers = Math.round(user.test.hit_rate_at_10 * user.test.users);
const itemHitUsers = Math.round(item.test.hit_rate_at_10 * item.test.users);
const fieldCopy: Record<string, { meaning: string; use: string }> = zh ? {
  'ratings.user_id': { meaning: '匿名用户标识', use: '构建用户行、按用户时间切分' },
  'ratings.movie_id': { meaning: '被评分电影标识', use: '连接电影表、构建物品列' },
  'ratings.rating': { meaning: '1–5 星显式反馈', use: '拟合相似度；测试时 ≥4 定义相关' },
  'ratings.timestamp': { meaning: '评分发生时间（Unix 秒）', use: '在用户内部按过去预测未来' },
  'movies.movie_id': { meaning: '电影主键', use: '连接评分与元数据' },
  'movies.title': { meaning: '片名与上映年份', use: '展示和解释，不进入分数' },
  'movies.genres': { meaning: '竖线分隔的类型标签', use: '页面解释；当前 CF 不使用' },
} : {
  'ratings.user_id': { meaning: 'Anonymous user identifier', use: 'Build user rows and split within user' },
  'ratings.movie_id': { meaning: 'Rated-movie identifier', use: 'Join metadata and build item columns' },
  'ratings.rating': { meaning: 'Explicit 1–5 star feedback', use: 'Fit similarities; ≥4 defines test relevance' },
  'ratings.timestamp': { meaning: 'Rating time in Unix seconds', use: 'Predict future activity from past activity' },
  'movies.movie_id': { meaning: 'Movie primary key', use: 'Join ratings to metadata' },
  'movies.title': { meaning: 'Title and release year', use: 'Display and explanation; not scored' },
  'movies.genres': { meaning: 'Pipe-delimited genre labels', use: 'Page explanation; unused by current CF' },
};
const pct = (value: number, digits = 1) => `${(value * 100).toFixed(digits)}%`;
const signedPoints = (value: number, digits = 2) => `${value >= 0 ? '+' : ''}${(value * 100).toFixed(digits)} pp`;
const year = (timestamp: number) => new Date(timestamp * 1000).getUTCFullYear();
const nav = zh
  ? ['业务问题','数据','探索性数据分析','信号表示与归一化','算法选择','候选方法对比','结果：离线代理与用户结果','评估与下一步','交互实验台']
  : ['Business problem','Data','Exploratory data analysis','Signal representation and normalization','Algorithm selection','Candidate method comparison','Results: offline proxies vs user outcomes','Evaluation and next steps','Interactive experiment lab'];
const copy = zh ? {
  problemTitle:'1. 业务问题：从历史评分生成个性化候选',
  problem:'设想一个电影流媒体平台：当用户已经留下评分时，首页需要从尚未评分的完整目录中选择 10 部候选。热门榜可以服务所有人，却不能利用个人偏好；本项目比较它与两类邻域协同过滤。',
  objective:'离线目标：在每位用户未来给出 4–5 星的电影中，让相关候选尽量靠前，同时审计目录覆盖和长尾曝光。MovieLens 没有曝光、点击或观看日志，因此不能测量 CTR、观看时长、留存、收入或因果增量。',
  dataTitle:'2. 数据：可用信号与边界',
  data:'MovieLens 1M 是 GroupLens 发布的稳定基准。每行表示一位用户在某个时间对一部电影给出的 1–5 星评分；电影表还提供标题与类型。实验只用评分与时间学习协同关系，类型仅用于解释和未来内容模型。',
  edaTitle:'3. 探索性数据分析：稀疏性决定模型与评估',
  eda:'只保留会改变建模决策的证据：评分倾向、用户与电影活跃度、矩阵稀疏性和热门度集中。',
  representationTitle:'4. 信号表示与归一化',
  representation:'评分已经共享 1–5 的量纲，因此不需要 Spotify 项目中的 StandardScaler 或 MinMaxScaler。真正需要校正的是用户打分习惯、低支持度相似度和缺失值的语义。',
  algorithmTitle:'5. 算法选择',
  algorithm:'方法范围由当前显式评分信号与 Top-10 学习目标决定。热门度用于最低成本基线与兜底；User-CF 和 Item-CF 分别比较矩阵的行与列；偏置模型只诊断评分误差。',
  comparisonTitle:'6. 候选方法对比',
  comparison:'训练、验证、相关性阈值、完整目录候选和 K=10 保持一致。k、最小支持度和收缩系数以成组候选配置比较，因此表格不能解释单个参数的因果作用。',
  resultTitle:'7. 结果：离线代理指标与用户结果分离',
  result:'下表报告历史评分上的离线排序代理、目录分布指标与工程测量。它们不是线上用户效果。',
  evaluationTitle:'8. 评估、限制与下一步',
  evaluation:'每位用户按时间排序后采用 80/10/10 切分：训练集拟合候选配置，验证集选参，训练加验证重拟合，最终测试只评一次。评分 ≥4 视为相关，候选为训练目录中所有未见电影。',
  labTitle:'9. 交互实验台',
  lab:'选择固定的低、中、高活跃用户，对比三种方法的 Top-5；需要时展开 Top-10。所有列表、命中和邻居证据均来自完整实验的预计算产物。',
} : {
  problemTitle:'1. Business problem: generate personalized candidates from ratings',
  problem:'Consider a movie-streaming homepage. Once a viewer has rating history, the system must select ten candidates from the full catalog they have not rated. Popularity can serve everyone, but it cannot use individual taste; this study compares it with two neighborhood collaborative-filtering methods.',
  objective:'Offline objective: rank movies the viewer later rates 4–5 stars near the top, while auditing catalog coverage and long-tail exposure. MovieLens has no impression, click, or watch log, so it cannot measure CTR, watch time, retention, revenue, or causal lift.',
  dataTitle:'2. Data: available signals and boundaries',
  data:'MovieLens 1M is a stable GroupLens benchmark. Each row is a 1–5 star rating from one user for one movie at one timestamp; movie metadata adds titles and genres. The experiment uses ratings and time to learn collaborative relations. Genres support explanation and a future content model, not the current scores.',
  edaTitle:'3. Exploratory data analysis: sparsity shapes modeling and evaluation',
  eda:'The audit keeps only evidence that changes a decision: rating tendency, user and movie activity, matrix sparsity, and popularity concentration.',
  representationTitle:'4. Signal representation and normalization',
  representation:'Ratings already share a 1–5 unit, so the StandardScaler and MinMaxScaler used in the Spotify project are not appropriate here. The required corrections concern rating habits, low-support similarity, and the meaning of missing entries.',
  algorithmTitle:'5. Algorithm selection',
  algorithm:'Method scope follows the explicit-rating signal and the Top-10 learning objective. Popularity is the lowest-cost baseline and fallback; User-CF and Item-CF compare matrix rows and columns; the bias model diagnoses rating error only.',
  comparisonTitle:'6. Candidate method comparison',
  comparison:'Training data, validation data, relevance threshold, full-catalog candidates, and K=10 stay fixed. Because k, minimum support, and shrinkage move together, these are candidate configurations—not isolated causal parameter tests.',
  resultTitle:'7. Results: offline proxies versus user outcomes',
  result:'The evidence below contains offline ranking proxies, catalog-distribution metrics, and engineering measurements from historical ratings. None is an online user effect.',
  evaluationTitle:'8. Evaluation, limitations, and next steps',
  evaluation:'Ratings are ordered within each user and split 80/10/10: train fits candidate configurations, validation selects them, train plus validation is refit, and final test is evaluated once. Ratings ≥4 are relevant; candidates are every unseen movie in the fitted catalog.',
  labTitle:'9. Interactive experiment lab',
  lab:'Choose fixed low-, medium-, and high-activity users and compare three Top-5 lists; expand to Top-10 when needed. Every list, hit, and neighbor explanation comes from precomputed full-experiment artifacts.',
};
const inspectCode = `ratings, movies = load_movielens(data_dir)
train, validation, test = per_user_temporal_split(ratings)
# One rating row: user_id, movie_id, rating, timestamp`;
const normalizationCode = `centered = rating - user_mean
similarity = cosine(centered_vectors)
shrunk = similarity * support / (support + shrinkage)
# Missing ratings stay missing; they are never filled with zero.`;
const evaluationCode = `relevant = test.rating >= 4
candidates = fitted_catalog - seen_movies
validation -> select configuration
train + validation -> refit -> test once`;
const userFormula = String.raw`\hat r_{ui}=\bar r_u+\frac{\sum_{v\in N_k(u,i)}s(u,v)(r_{vi}-\bar r_v)}{\sum_{v\in N_k(u,i)}|s(u,v)|}`;
const itemFormula = String.raw`\hat r_{ui}=\bar r_u+\frac{\sum_{j\in N_k(i,u)}s(i,j)(r_{uj}-\bar r_u)}{\sum_{j\in N_k(i,u)}|s(i,j)|}`;
const bayesianFormula = String.raw`B_i=\frac{n_i\bar r_i+m\mu}{n_i+m}`;
const hitFormula = String.raw`\mathrm{HitRate@10}=\frac{1}{|U|}\sum_{u\in U}\mathbf{1}[R_u^{10}\cap T_u\neq\varnothing]`;
const recallFormula = String.raw`\mathrm{Recall@10}=\frac{1}{|U|}\sum_{u\in U}\frac{|R_u^{10}\cap T_u|}{|T_u|}`;
const ndcgFormula = String.raw`\mathrm{NDCG@10}=\frac{1}{|U|}\sum_{u\in U}\frac{\sum_{p=1}^{10}\frac{rel_{u,p}}{\log_2(p+1)}}{\mathrm{IDCG}_{u,10}}`;
const commands = `.venv/bin/python research/run_python_tests.py
npm test
MPLCONFIGDIR=/tmp/movielens-mpl .venv/bin/python research/movielens-cf/run_experiment.py --smoke --output /tmp/movielens-smoke
MPLCONFIGDIR=/tmp/movielens-mpl .venv/bin/python research/movielens-cf/run_experiment.py
npm run check
npm run build`;
---

<nav class="case-nav" aria-label={zh ? 'MovieLens 项目章节' : 'MovieLens case-study sections'}>{nav.map((label,index)=><a href={`#ml-${index+1}`}>{index+1}. {label}</a>)}</nav>
<div class="case-study">
  <section id="ml-1" class="case-step">
    <p class="step-label">Step 1</p><h2>{copy.problemTitle}</h2><p>{copy.problem}</p>
    <aside><h3>{zh ? '决策对象' : 'Decision surface'}</h3><p>{zh ? '目标用户是已有评分历史的回访用户；产品输出是首页个性化候选，不是最终播放概率。' : 'The target is a returning viewer with rating history; the output is a personalized homepage candidate set, not a watch probability.'}</p></aside>
    <div class="output"><strong>{zh ? '成功标准与边界' : 'Success criteria and boundary'}</strong><p>{copy.objective}</p></div>
  </section>

  <section id="ml-2" class="case-step">
    <p class="step-label">Step 2</p><h2>{copy.dataTitle}</h2><p>{copy.data}</p>
    <div class="code-block"><Code code={inspectCode} lang="python" theme="github-dark" /></div>
    <div class="output"><strong>{zh ? '数据审计结果' : 'Data audit result'}</strong><p>{profile.ratings.toLocaleString()} {zh ? '条评分，' : 'ratings, '}{profile.users.toLocaleString()} {zh ? '位用户，' : 'users, '}{profile.ratedMovies.toLocaleString()} {zh ? `部有评分电影；时间覆盖 ${year(profile.timestampRange[0])}–${year(profile.timestampRange[1])}。` : `rated movies, spanning ${year(profile.timestampRange[0])}–${year(profile.timestampRange[1])}.`}</p></div>
    <div class="method-table" role="region" tabindex="0" aria-label={zh ? 'MovieLens 数据字典' : 'MovieLens data dictionary'}><table><thead><tr><th>{zh?'表':'Table'}</th><th>{zh?'字段':'Field'}</th><th>dtype</th><th>{zh?'真实示例':'Actual example'}</th><th>{zh?'业务含义':'Meaning'}</th><th>{zh?'算法用途':'Algorithm use'}</th></tr></thead><tbody>{profile.fields.map((field)=><tr><td>{field.table}</td><th>{field.name}</th><td><code>{field.dtype}</code></td><td><code>{String(field.example)}</code></td><td>{fieldCopy[`${field.table}.${field.name}`].meaning}</td><td>{fieldCopy[`${field.table}.${field.name}`].use}</td></tr>)}</tbody></table></div>
    <div class="split-grid">
      <article><span>Train · {pct(split.trainRatings/splitTotal)}</span><strong>{split.trainRatings.toLocaleString()}</strong><p>{zh?'拟合验证候选。':'Fit validation candidates.'}</p></article>
      <article><span>Validation · {pct(split.validationRatings/splitTotal)}</span><strong>{split.validationRatings.toLocaleString()}</strong><p>{zh?'选择成组超参数。':'Select grouped hyperparameters.'}</p></article>
      <article><span>Fit · {pct(split.fittedRatings/splitTotal)}</span><strong>{split.fittedRatings.toLocaleString()}</strong><p>{zh?'训练加验证，重拟合最终模型。':'Train plus validation for final refit.'}</p></article>
      <article><span>Test · {pct(split.testRatings/splitTotal)}</span><strong>{split.testRatings.toLocaleString()}</strong><p>{zh?'只用于一次最终评估。':'Used once for final evaluation.'}</p></article>
    </div>
    <MovieLensFlow type="evaluation" lang={lang} />
    <aside><h3>{zh?'为什么按用户、按时间切分？':'Why split by user and time?'}</h3><ol class="split-explanation"><li>{zh?<><strong>目的：</strong>测试集模拟“未来才发生”的评分，用于一次最终评估；它不参与选择参数。</>:<><strong>Purpose:</strong> test ratings simulate feedback that happens later and are used once for final evaluation; they never choose parameters.</>}</li><li>{zh?<><strong>操作：</strong>对每位用户按 <KatexMath latex={String.raw`(\mathrm{timestamp},\mathrm{movie\ ID})`} /> 稳定排序；最早约 <KatexMath latex={String.raw`80\%`} /> 进入 Train，随后约 <KatexMath latex={String.raw`10\%`} /> 进入 Validation，最后约 <KatexMath latex={String.raw`10\%`} /> 进入 Test。</>:<><strong>Mechanics:</strong> stably sort each user by <KatexMath latex={String.raw`(\mathrm{timestamp},\mathrm{movie\ ID})`} />; the earliest ≈<KatexMath latex={String.raw`80\%`} /> goes to Train, next ≈<KatexMath latex={String.raw`10\%`} /> to Validation, and final ≈<KatexMath latex={String.raw`10\%`} /> to Test.</>}</li><li>{zh?<><strong>调参：</strong>只在 Validation 比较 <KatexMath latex={String.raw`k`} />、最小共同评分支持度和收缩系数 <KatexMath latex={String.raw`\lambda`} />；选定后以 Train + Validation 重拟合。</>:<><strong>Tuning:</strong> compare only <KatexMath latex={String.raw`k`} />, minimum co-rating support, and shrinkage <KatexMath latex={String.raw`\lambda`} /> on Validation; then refit using Train + Validation.</>}</li><li>{zh?'随机切分可能让未来评分帮助模型预测过去；时间切分避免这种泄漏。缺失单元格仍表示未观察，不代表不喜欢，也不填 0。':'A random split could let future ratings help predict the past; the temporal split prevents that leakage. Missing cells remain unobserved—not disliked—and are never filled with zero.'}</li></ol></aside>
  </section>

  <section id="ml-3" class="case-step">
    <p class="step-label">Step 3</p><h2>{copy.edaTitle}</h2><p>{copy.eda}</p>
    <div class="output"><strong>{zh ? '保留的 EDA 证据' : 'EDA evidence retained'}</strong><p>{zh ? `矩阵有 ${pct(profile.sparsity)} 未观察单元格；用户评分中位数为 ${profile.ratingsPerUser.median}，电影评分中位数为 ${profile.ratingsPerMovie.median}。这直接决定三件事：不将缺失填为负反馈、为相似度设置共同评分门槛、并在邻域证据不足时回退热门榜。` : `${pct(profile.sparsity)} of the matrix is unobserved; median activity is ${profile.ratingsPerUser.median} ratings per user and ${profile.ratingsPerMovie.median} per movie. This directly determines three choices: do not turn missingness into negative feedback, require co-rating support for similarity, and fall back to popularity when neighborhood evidence is thin.`}</p></div>
    <figure><img src={href('/artifacts/movielens/popularity-long-tail.svg')} width="720" height="396" loading="lazy" alt={zh ? '按训练热门度排序的电影评分次数长尾曲线' : 'Long-tail curve of movie interaction counts ordered by fitted popularity'} /><figcaption><strong>{zh ? '观察：' : 'Observation: '}</strong>{zh ? `训练加验证交互数定义热门度；最热门 20% 电影包含测试 cohort 中 ${head.relevantTestRatings.toLocaleString()} 条相关评分的 ${pct(head.top20PercentShare)}。` : `Popularity is defined by train-plus-validation interaction count; the top 20% of movies contain ${pct(head.top20PercentShare)} of ${head.relevantTestRatings.toLocaleString()} relevant test ratings in the ranking cohort.`}<br/><strong>{zh ? '决定：' : 'Decision: '}</strong>{zh ? '保留热门基线，并同时报告覆盖与长尾比例，避免只优化头部命中。' : 'Keep popularity as a baseline and report coverage and long-tail share so head-item hits are not the only objective.'}</figcaption></figure>
  </section>

  <section id="ml-4" class="case-step">
    <p class="step-label">Step 4</p><h2>{copy.representationTitle}</h2><p>{copy.representation}</p>
    <div class="matrix" role="region" aria-label={zh ? '中心化评分示例' : 'Mean-centering example'}><table><thead><tr><th>{zh ? '用户' : 'User'}</th><th>Film A</th><th>Film B</th><th>Film C</th><th>{zh ? '均值' : 'Mean'}</th><th>{zh ? '中心化后' : 'Centered'}</th></tr></thead><tbody><tr><th>Alice</th><td>5</td><td>4</td><td>3</td><td>4</td><td>+1, 0, −1</td></tr><tr><th>Bob</th><td>4</td><td>3</td><td>2</td><td>3</td><td>+1, 0, −1</td></tr></tbody></table></div>
    <p class="symbol-guide">{zh ? <>中心化写成 <KatexMath latex={String.raw`r_{ui}-\bar r_u`} />：<KatexMath latex={String.raw`+1`} /> 表示比个人平均分高一星，<KatexMath latex={String.raw`0`} /> 表示恰好等于个人均值，<KatexMath latex={String.raw`-1`} /> 表示低一星。两人的绝对评分不同，但相对偏好相同。User-CF 比较中心化后的用户行；Item-CF 在共同评分用户内减去各自均值后比较电影列。</> : <>Centering is <KatexMath latex={String.raw`r_{ui}-\bar r_u`} />: <KatexMath latex={String.raw`+1`} /> is one star above a viewer’s mean, <KatexMath latex={String.raw`0`} /> equals it, and <KatexMath latex={String.raw`-1`} /> is one star below it. Absolute ratings can differ while relative preference agrees. User-CF compares centered user rows; Item-CF compares movie columns after removing each co-rater’s mean.</>}</p>
    <div class="code-block"><Code code={normalizationCode} lang="python" theme="github-dark" /></div>
    <div class="scaling-formulas"><div class="formula-card"><h3>{zh ? '支持度门槛' : 'Minimum support'}</h3><p>{zh ? <>共同评分不足的相似关系直接过滤。最终 User-CF 的门槛为 <KatexMath latex={String.raw`n\ge ${userValidation.selected.min_support}`} />：只有 <KatexMath latex={String.raw`n=2`} /> 个共同评分即使走势完全相同也会被丢弃；数十个共同评分更能抵抗巧合。</> : <>Similarities below the co-rating threshold are discarded. The selected User-CF threshold is <KatexMath latex={String.raw`n\ge ${userValidation.selected.min_support}`} />: even a perfect-looking match with <KatexMath latex={String.raw`n=2`} /> shared ratings is filtered, while dozens give more credible evidence.</>}</p></div><div class="formula-card"><h3>{zh ? '相似度收缩' : 'Similarity shrinkage'}</h3><KatexMath latex={String.raw`s'=s\frac{n}{n+\lambda}`} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`s`,description:zh?'原始余弦相似度。':'raw cosine similarity.'},{latex:String.raw`n`,description:zh?'共同评分数。':'number of co-ratings.'},{latex:String.raw`\lambda`,description:zh?'收缩强度。':'shrinkage strength.'},{latex:String.raw`s'`,description:zh?'用于排序的收缩后相似度。':'shrunk similarity used for ranking.'}]} /><p>{zh ? <>以 <KatexMath latex={String.raw`s=0.90`} />、<KatexMath latex={String.raw`\lambda=${userValidation.selected.shrinkage}`} /> 为例：<KatexMath latex={String.raw`n=10`} /> 时 <KatexMath latex={String.raw`s'=0.15`} />，<KatexMath latex={String.raw`n=50`} /> 时 <KatexMath latex={String.raw`s'=0.45`} />；证据越少，越靠近 <KatexMath latex={String.raw`0`} />。</> : <>With <KatexMath latex={String.raw`s=0.90`} /> and <KatexMath latex={String.raw`\lambda=${userValidation.selected.shrinkage}`} />: <KatexMath latex={String.raw`n=10`} /> gives <KatexMath latex={String.raw`s'=0.15`} />, while <KatexMath latex={String.raw`n=50`} /> gives <KatexMath latex={String.raw`s'=0.45`} />; less evidence moves toward <KatexMath latex={String.raw`0`} />.</>}</p></div></div>
    <aside><h3>{zh ? '排序分与展示评分' : 'Rank score versus display rating'}</h3><p>{zh ? 'Top-N 使用未截断的原始估计排序；RMSE、MAE 与界面评分限制在 1–5。这样不会让高于 5 的不同分数过早并列。' : 'Top-N uses raw estimates. RMSE, MAE, and displayed ratings use the 1–5 scale, preventing distinct scores above five from collapsing before ranking.'}</p></aside>
  </section>

  <section id="ml-5" class="case-step">
    <p class="step-label">Step 5</p><h2>{copy.algorithmTitle}</h2><p>{copy.algorithm}</p>
    <div class="method-cards">
      <article class="method-card"><div class="method-copy"><h3>Bayesian popularity</h3><KatexMath latex={bayesianFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`i`,description:zh?'电影。':'a movie.'},{latex:String.raw`n_i`,description:zh?'电影 i 的拟合评分数。':'fitted rating count for movie i.'},{latex:String.raw`\bar r_i`,description:zh?'电影 i 的平均评分。':'mean rating for movie i.'},{latex:String.raw`\mu`,description:zh?`全局均分 (${popularity.globalMean.toFixed(3)})。`:`global mean (${popularity.globalMean.toFixed(3)}).`},{latex:String.raw`m`,description:zh?`先验权重 (${popularity.priorWeight.toFixed(0)})。`:`prior weight (${popularity.priorWeight.toFixed(0)}).`}]} /><ol class="card-points"><li>{zh ? '输入每部电影的评分数与均分；拟合全局均分和贝叶斯分。' : 'Input movie counts and means; fit the global mean and Bayesian score.'}</li><li>{zh ? '按分数排序；证据少的电影自动收缩到全局均分。' : 'Rank by score; low-support movies shrink toward the global mean.'}</li><li>{zh ? '排除该用户已看电影，再从完整拟合目录取 Top-10。' : 'Remove the user’s seen movies, then take Top-10 from the full fitted catalog.'}</li><li>{zh ? '它也是 User-CF / Item-CF 证据不足时的共享兜底。' : 'It is also the shared fallback when User-CF or Item-CF lacks evidence.'}</li></ol><div class="example-grid">{bayesianExamples.map((example)=><div><span>{example.support==='low'?(zh?'低支持度':'Low support'):(zh?'高支持度':'High support')}</span><strong>{example.title}</strong><KatexMath latex={String.raw`\frac{${example.ratingCount}\times${example.ratingMean.toFixed(3)}+${popularity.priorWeight.toFixed(0)}\times${popularity.globalMean.toFixed(3)}}{${example.ratingCount}+${popularity.priorWeight.toFixed(0)}}=${example.score.toFixed(3)}`} display /></div>)}</div></div></article>
      <article class="method-card"><div class="method-copy"><h3>User-Based Collaborative Filtering</h3><p>{zh ? '先找中心化评分走势相近的用户，再聚合他们对候选电影的评分残差。' : 'Find users with similar centered rating patterns, then aggregate their residual ratings for a candidate.'}</p><KatexMath latex={userFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`\hat r_{ui}`,description:zh?'用户 u 对候选电影 i 的未截断预测评分。':'raw prediction for user u and candidate movie i.'},{latex:String.raw`\bar r_u`,description:zh?'用户 u 的训练评分均值。':'user u’s mean training rating.'},{latex:String.raw`v`,description:zh?'评过 i 的相似用户。':'a similar user who rated i.'},{latex:String.raw`s(u,v)`,description:zh?'收缩后的用户相似度。':'shrunk similarity between u and v.'},{latex:String.raw`N_k(u,i)`,description:zh?'最多 k 个有效用户邻居。':'up to k valid user neighbors.'},{latex:String.raw`r_{vi}-\bar r_v`,description:zh?'邻居 v 对电影 i 的中心化评分残差。':'neighbor v’s centered residual for i.'}]} /><MovieLensFlow type="user" lang={lang} /><ol class="card-points"><li>{zh?'输入中心化用户—电影矩阵；拟合经过门槛与收缩的用户相似度。':'Input the centered user–movie matrix; fit thresholded, shrunk user similarities.'}</li><li>{zh?'对每个候选聚合评过它的相似用户残差。':'Aggregate residuals from similar users who rated each candidate.'}</li><li>{zh?'有效邻居不足时回退 Bayesian 分数。':'Fall back to the Bayesian score when too few valid neighbors exist.'}</li><li>{zh?'排除已看电影，在完整未见目录上取 Top-10。':'Exclude seen movies and take Top-10 over the full unseen catalog.'}</li></ol><a href={href(`/${lang}/algorithms/user-based-cf/`)}>{zh ? '查看通用算法页 →' : 'Open the general algorithm page →'}</a></div></article>
      <article class="method-card"><div class="method-copy"><h3>Item-Based Collaborative Filtering</h3><p>{zh ? '先学习共同用户以相似方式评分的电影关系，再聚合用户已评分电影的残差。' : 'Learn movie relationships from shared rating patterns, then aggregate residuals from movies the user rated.'}</p><KatexMath latex={itemFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`\hat r_{ui}`,description:zh?'用户 u 对候选电影 i 的未截断预测评分。':'raw prediction for user u and candidate movie i.'},{latex:String.raw`\bar r_u`,description:zh?'用户 u 的训练评分均值。':'user u’s mean training rating.'},{latex:String.raw`j`,description:zh?'用户 u 已评分的来源电影。':'a source movie already rated by u.'},{latex:String.raw`s(i,j)`,description:zh?'电影 i 与 j 的收缩后 adjusted-cosine 相似度。':'shrunk adjusted-cosine similarity of i and j.'},{latex:String.raw`N_k(i,u)`,description:zh?'最多 k 个有效来源电影。':'up to k valid source movies.'},{latex:String.raw`r_{uj}-\bar r_u`,description:zh?'用户 u 对来源电影 j 的中心化残差。':'u’s centered residual for source movie j.'}]} /><MovieLensFlow type="item" lang={lang} /><ol class="card-points"><li>{zh?'输入用户中心化后的电影列；拟合经过门槛与收缩的电影相似度。':'Input movie columns centered by user; fit thresholded, shrunk movie similarities.'}</li><li>{zh?'对候选聚合目标用户已评分的相似电影残差。':'Aggregate residuals from similar movies the target user rated.'}</li><li>{zh?'有效来源不足时回退 Bayesian 分数。':'Fall back to the Bayesian score when evidence is insufficient.'}</li><li>{zh?'排除已看电影，在完整未见目录上取 Top-10。':'Exclude seen movies and take Top-10 over the full unseen catalog.'}</li></ol><a href={href(`/${lang}/algorithms/item-based-cf/`)}>{zh ? '查看通用算法页 →' : 'Open the general algorithm page →'}</a></div></article>
    </div>
    <h3>{zh?'Item-CF 与 Spotify 内容推荐不是一回事':'Item-CF is not Spotify-style content recommendation'}</h3>
    <div class="method-table" role="region" tabindex="0"><table><thead><tr><th>{zh?'维度':'Dimension'}</th><th>MovieLens Item-CF</th><th>{zh?'Spotify 内容推荐':'Spotify content recommender'}</th></tr></thead><tbody><tr><th>{zh?'所需信号':'Required signal'}</th><td>{zh?'共同用户的评分模式':'Shared users’ rating patterns'}</td><td>{zh?'物品自身的音频或元数据属性':'Item audio or metadata attributes'}</td></tr><tr><th>{zh?'新物品':'New item'}</th><td>{zh?'没有共同评分，无法建立相似度':'No co-ratings, so no similarity'}</td><td>{zh?'只要属性齐全即可比较':'Comparable as soon as attributes exist'}</td></tr><tr><th>{zh?'新用户':'New user'}</th><td>{zh?'需要初始评分才能选来源电影':'Needs initial ratings to select source movies'}</td><td>{zh?'种子物品足以进行会话级推荐':'A seed item can support session-level recommendation'}</td></tr><tr><th>{zh?'解释':'Explanation'}</th><td>{zh?'“喜欢它的人也以相似方式评分了这些电影”':'“People rated these movies in similar patterns”'}</td><td>{zh?'“音频/内容属性相似”':'“Audio/content attributes are similar”'}</td></tr></tbody></table></div>
    <aside><h3>{zh ? '未加入的方法' : 'Methods not added'}</h3><p>{zh ? '偏置模型仅报告评分误差。矩阵分解需要独立的模型化 CF 决策问题；类型内容模型与混合模型需要新的公平协议。ALS、BPR、LightFM 面向不同的隐式反馈目标。' : 'The bias model reports rating error only. Matrix factorization needs a separate model-based CF decision question; genre content and hybrid methods need a new fair protocol. ALS, BPR, and LightFM target a different implicit-feedback objective.'}</p></aside>
  </section>

  <section id="ml-6" class="case-step">
    <p class="step-label">Step 6</p><h2>{copy.comparisonTitle}</h2><p>{copy.comparison}</p>
    <div class="validation-grid">{[userValidation,itemValidation].map((group)=><article><h3>{group.mode==='user'?'User-CF':'Item-CF'}</h3><div class="method-table" role="region" tabindex="0"><table><thead><tr><th>k</th><th>{zh?'支持度':'support'}</th><th>{zh?'收缩':'shrinkage'}</th><th>Hit Rate@10</th><th>NDCG@10</th><th>Recall@10</th></tr></thead><tbody>{group.candidates.map((candidate)=><tr class:list={{selected:candidate.params.k===group.selected.k&&candidate.params.min_support===group.selected.min_support}}><td>{candidate.params.k}</td><td>{candidate.params.min_support}</td><td>{candidate.params.shrinkage}</td><td>{pct(candidate.metrics.hit_rate_at_10,2)}</td><td>{pct(candidate.metrics.ndcg_at_10,2)}</td><td>{pct(candidate.metrics.recall_at_10,2)}</td></tr>)}</tbody></table></div></article>)}</div>
    <div class="method-table" role="region" tabindex="0"><table><thead><tr><th>{zh?'维度':'Dimension'}</th><th>User-CF</th><th>Item-CF</th></tr></thead><tbody><tr><th>{zh?'表示':'Representation'}</th><td>{zh?'中心化用户行':'centered user rows'}</td><td>{zh?'adjusted-cosine 电影列':'adjusted-cosine movie columns'}</td></tr><tr><th>{zh?'最终配置':'Selected configuration'}</th><td>k=80 · support=10 · shrinkage=50 · min neighbors=5</td><td>k=20 · support=5 · shrinkage=10 · min neighbors=2</td></tr><tr><th>{zh?'服务与解释':'Serving / explanation'}</th><td>{zh?'邻域随用户变化；解释为相似用户':'neighborhood changes by user; similar-user evidence'}</td><td>{zh?'电影邻居可离线预计算；解释为来源电影':'movie neighbors can be precomputed; source-movie evidence'}</td></tr><tr><th>{zh?'冷启动':'Cold start'}</th><td>{zh?'新用户和新电影都弱':'weak for new users and movies'}</td><td>{zh?'新电影弱；用户需要初始评分':'new movies weak; users need initial ratings'}</td></tr></tbody></table></div>
  </section>

  <section id="ml-7" class="case-step wide-step">
    <p class="step-label">Step 7</p><h2>{copy.resultTitle}</h2><p>{copy.result}</p>
    <div class="code-block narrow"><Code code={evaluationCode} lang="python" theme="github-dark" /></div>
    <div class="output"><strong>{zh ? '共同评估框架' : 'Shared evaluation frame'}</strong><p>{metrics.evaluationPopulation.rankingUsers.toLocaleString()} {zh ? `位有未来相关电影的用户；时间切分；K=${metrics.k}；每位用户在完整未见目录上排序。更高的 Hit Rate、NDCG、Recall、覆盖率和长尾比例代表对应问题上的提升，但各指标不能互相替代。` : `users with future relevant movies; temporal split; K=${metrics.k}; full unseen-catalog ranking per user. Higher Hit Rate, NDCG, recall, coverage, and long-tail share improve their respective questions, but the metrics are not interchangeable.`}</p></div>
    <div class="result-cards">
      <article class="metric-evidence"><h3>Hit Rate@10 ↑</h3><KatexMath latex={hitFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`U`,description:zh?`有未来相关电影的 ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} 位评估用户。`:`the ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} evaluated users with future relevant items.`},{latex:String.raw`R_u^{10}`,description:zh?'用户 u 的十个推荐。':'user u’s Top-10 recommendations.'},{latex:String.raw`T_u`,description:zh?'用户 u 在测试集中评分 ≥4 的未来电影。':'u’s future test movies rated ≥4.'},{latex:String.raw`\mathbf{1}[\cdot]`,description:zh?'条件成立记 1，否则记 0。':'1 when the condition is true, otherwise 0.'}]} /><div class="calculation"><span>{zh?'计算':'Calculation'}</span><KatexMath latex={String.raw`\frac{${popularityHitUsers}}{${metrics.evaluationPopulation.rankingUsers.toLocaleString()}}=${popularity.test.hit_rate_at_10.toFixed(4)}`} display /><p>{zh?`Popularity 对 ${popularityHitUsers.toLocaleString()} 位用户至少找回一部未来相关电影。User-CF 为 ${userHitUsers.toLocaleString()} 位，Item-CF 为 ${itemHitUsers.toLocaleString()} 位。`:`Popularity retrieves at least one future-relevant movie for ${popularityHitUsers.toLocaleString()} users. User-CF does so for ${userHitUsers.toLocaleString()}; Item-CF for ${itemHitUsers.toLocaleString()}.`}</p></div><div class="triplet-values"><div><span>Popularity</span><strong>{pct(popularity.test.hit_rate_at_10,2)}</strong><small>95% CI {pct(popularity.confidence95.hitRateAt10[0],2)}–{pct(popularity.confidence95.hitRateAt10[1],2)}</small></div><div><span>User-CF</span><strong>{pct(user.test.hit_rate_at_10,2)}</strong><small>95% CI {pct(user.confidence95.hitRateAt10[0],2)}–{pct(user.confidence95.hitRateAt10[1],2)}</small></div><div><span>Item-CF</span><strong>{pct(item.test.hit_rate_at_10,2)}</strong><small>95% CI {pct(item.confidence95.hitRateAt10[0],2)}–{pct(item.confidence95.hitRateAt10[1],2)}</small></div></div><ul class="card-points"><li>{zh?<>一次命中：用户 <KatexMath latex={String.raw`u`} /> 的 <KatexMath latex={String.raw`R_u^{10}`} /> 中至少有一部也出现在 <KatexMath latex={String.raw`T_u`} />；命中一部与命中多部都记为 <KatexMath latex={String.raw`1`} />。</> : <>One hit means at least one title in <KatexMath latex={String.raw`R_u^{10}`} /> also appears in <KatexMath latex={String.raw`T_u`} />; one and many retrieved titles both score <KatexMath latex={String.raw`1`} />.</>}</li><li>{zh?'未命中不表示不喜欢，只表示没有找回后来主动评分的电影。':'A miss does not mean dislike; it means no later self-rated movie was retrieved.'}</li></ul></article>
      <article class="metric-evidence"><h3>NDCG@10 ↑</h3><KatexMath latex={ndcgFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`rel_{u,p}`,description:zh?'用户 u 在位置 p 的二元相关性。':'binary relevance for u at rank p.'},{latex:String.raw`p`,description:zh?'推荐位置，范围为 1 到 10。':'rank position from 1 to 10.'},{latex:String.raw`\mathrm{IDCG}_{u,10}`,description:zh?'用户 u 的理想折扣累计增益，用于归一化。':'u’s ideal discounted gain for normalization.'},{latex:String.raw`U`,description:zh?'评估用户集合。':'evaluation-user set.'}]} /><div class="calculation"><span>{zh?'计算':'Calculation'}</span><KatexMath latex={String.raw`\frac{1}{|U|}\sum_{u\in U}\mathrm{NDCG}_{u,10}\Rightarrow 0.02676`} display /><p>{zh?'先对每位用户的前排命中给予更高折扣收益，再按用户平均。':'Give earlier hits more discounted gain for each user, then average across users.'}</p></div><div class="triplet-values"><div><span>Popularity</span><strong>{pct(popularity.test.ndcg_at_10,2)}</strong></div><div><span>User-CF</span><strong>{pct(user.test.ndcg_at_10,2)}</strong></div><div><span>Item-CF</span><strong>{pct(item.test.ndcg_at_10,2)}</strong></div></div><ul class="card-points"><li>{zh?`Popularity − User-CF 的配对差为 ${signedPoints(-paired.meanDifference)}，95% CI ${signedPoints(-paired.confidence95[1])} 至 ${signedPoints(-paired.confidence95[0])}。`:`Popularity exceeds User-CF by ${signedPoints(-paired.meanDifference)}; 95% CI ${signedPoints(-paired.confidence95[1])} to ${signedPoints(-paired.confidence95[0])}.`}</li><li>{zh?'这是离线显式评分代理，不是观看概率。':'This is an offline explicit-rating proxy, not watch probability.'}</li></ul></article>
      <article class="metric-evidence"><h3>Recall@10 ↑</h3><KatexMath latex={recallFormula} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`R_u^{10}`,description:zh?'用户 u 的十个推荐。':'user u’s Top-10 recommendations.'},{latex:String.raw`T_u`,description:zh?'用户 u 的未来相关测试电影集合。':'u’s future-relevant test-movie set.'},{latex:String.raw`|T_u|`,description:zh?'该用户的 Recall 分母。':'that user’s Recall denominator.'},{latex:String.raw`U`,description:zh?'评估用户集合。':'evaluation-user set.'}]} /><div class="calculation"><span>{zh?'计算':'Calculation'}</span><KatexMath latex={String.raw`\frac{1}{|U|}\sum_{u\in U}\frac{|R_u^{10}\cap T_u|}{|T_u|}\Rightarrow 0.02247`} display /><p>{zh?'先按每位用户的未来相关电影数归一化，再取用户宏平均。':'Normalize by each user’s future-relevant count, then take the user macro-average.'}</p></div><div class="triplet-values"><div><span>Popularity</span><strong>{pct(popularity.test.recall_at_10,2)}</strong></div><div><span>User-CF</span><strong>{pct(user.test.recall_at_10,2)}</strong></div><div><span>Item-CF</span><strong>{pct(item.test.recall_at_10,2)}</strong></div></div><ul class="card-points"><li>{zh?'固定十个位置和完整目录候选使绝对值较低；活跃用户的 |Tᵤ| 通常更大。':'Ten fixed slots and full-catalog candidates keep absolute values low; active users typically have larger |Tᵤ|.'}</li><li>{zh?'未曝光电影的缺失评分不是负例。':'Missing ratings for unexposed movies are not negatives.'}</li></ul></article>
      <article><h3>{zh?'目录分布 ↑':'Catalog distribution ↑'}</h3><div class="paired-values"><div><span>User-CF</span><strong>{pct(user.beyondAccuracy.catalog_coverage)}</strong><small>{pct(user.beyondAccuracy.long_tail_share)} {zh?'长尾':'tail'}</small></div><div><span>Item-CF</span><strong>{pct(item.beyondAccuracy.catalog_coverage)}</strong><small>{pct(item.beyondAccuracy.long_tail_share)} {zh?'长尾':'tail'}</small></div></div><ul class="card-points"><li>{zh?`热门基线覆盖仅 ${pct(popularity.beyondAccuracy.catalog_coverage)}。个性化方法分散更多目录曝光。`:`Popularity covers only ${pct(popularity.beyondAccuracy.catalog_coverage)}. Personalized methods distribute candidates across more of the catalog.`}</li><li>{zh?'限制：更多覆盖或长尾不证明用户更满意。':'Limit: more coverage or tail exposure does not prove satisfaction.'}</li></ul></article>
      <article><h3>{zh?'工程与分数诊断':'Engineering and score diagnostics'}</h3><ul class="card-points"><li>User-CF: fit {user.system.fitSeconds.toFixed(2)} s · recommend {user.system.recommendSeconds.toFixed(2)} s · {user.system.usersPerSecond.toFixed(0)} {zh?'用户/秒':'users/s'} · {user.system.neighborArtifactMiB.toFixed(2)} MiB</li><li>Item-CF: fit {item.system.fitSeconds.toFixed(2)} s · recommend {item.system.recommendSeconds.toFixed(2)} s · {item.system.usersPerSecond.toFixed(0)} {zh?'用户/秒':'users/s'} · {item.system.neighborArtifactMiB.toFixed(2)} MiB</li><li>{zh?'fitSeconds 只覆盖相似度与邻居产物构建；recommendSeconds 覆盖全体评估用户的打分、过滤已看和 Top-10 选择。usersPerSecond = rankingUsers / recommendSeconds。':'fitSeconds covers similarity and neighbor-artifact construction only. recommendSeconds covers scoring, seen-item removal, and Top-10 selection for all ranking users. usersPerSecond = rankingUsers / recommendSeconds.'}</li><li>{zh?'neighborArtifactMiB 只计算稀疏相似度 CSR 的 data、indices 与 indptr 数组，不是 Python 进程峰值内存。':'neighborArtifactMiB counts only the sparse-similarity CSR data, indices, and indptr arrays; it is not peak process memory.'}</li><li>{zh?`Item-CF 有 ${pct(itemTieStats.fullyTiedListShare)} 的个性化列表 Top-10 原始分完全并列；${pct(itemFiveStarOnlyShare)} 的条目只由 5 星历史贡献。`:`Item-CF has fully tied raw Top-10 scores in ${pct(itemTieStats.fullyTiedListShare)} of personalized lists; ${pct(itemFiveStarOnlyShare)} of entries receive evidence only from five-star history.`}</li><li>{zh?`上下文：${metrics.runtime.platform}，Python ${metrics.runtime.python}，CPU、单进程离线批处理；没有固定 BLAS 线程数。计时不含数据加载和写产物，不能解释为线上单请求延迟。`:`Context: ${metrics.runtime.platform}, Python ${metrics.runtime.python}, CPU, single-process offline batch; BLAS thread count was not fixed. Timing excludes data load and artifact writes and is not online single-request latency.`}</li></ul></article>
    </div>
    <h3>{zh?'补充指标词典':'Additional metric definitions'}</h3>
    <div class="metric-dictionary">
      <article><h4>{zh?'目录与长尾 ↑':'Catalog and long tail ↑'}</h4><KatexMath latex={String.raw`\mathrm{Coverage}=\frac{|\cup_{u\in U}R_u^{10}|}{|C|}`} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`R_u^{10}`,description:zh?'用户 u 的十个推荐。':'user u’s Top-10.'},{latex:String.raw`U`,description:zh?'评估用户集合。':'evaluation-user set.'},{latex:String.raw`C`,description:zh?`包含 ${metrics.evaluationPopulation.fittedCatalogMovies.toLocaleString()} 部电影的拟合目录。`:`fitted catalog of ${metrics.evaluationPopulation.fittedCatalogMovies.toLocaleString()} movies.`}]} /><p>{zh?'Long-tail Share 是所有推荐条目中不属于拟合热门度前 20% 的比例。两者描述分布，不证明满意度。':'Long-tail Share is the fraction of all recommendation entries outside the top 20% by fitted popularity. Both describe distribution, not satisfaction.'}</p></article>
      <article><h4>RMSE / MAE ↓</h4><KatexMath latex={String.raw`\mathrm{RMSE}=\sqrt{\frac{1}{N}\sum(\tilde r_{ui}-r_{ui})^2},\quad \mathrm{MAE}=\frac{1}{N}\sum|\tilde r_{ui}-r_{ui}|`} display /><FormulaLegend label={zh?'公式变量':'Formula variables'} entries={[{latex:String.raw`N`,description:zh?'测试评分行数。':'number of test-rating rows.'},{latex:String.raw`\tilde r_{ui}`,description:zh?'截断到 1–5 的预测评分。':'prediction clipped to the 1–5 scale.'},{latex:String.raw`r_{ui}`,description:zh?'用户 u 对电影 i 的真实测试评分。':'observed test rating by u for i.'}]} /><p>{zh?'它们在所有测试评分行上聚合，衡量评分误差；不证明 Top-10 排序或业务效果。':'They aggregate over all test-rating rows and measure rating error; they do not prove Top-10 ranking or business impact.'}</p></article>
    </div>
    <div class="low-hit"><h3>{zh?'为什么当前命中率低？':'Why is the current hit rate low?'}</h3><div class="diagnosis-grid">
      <article><span>{zh?'评估难度':'Evaluation difficulty'}</span><p>{zh?`每位用户先排除已看电影，再从约 ${metrics.evaluationPopulation.fittedCatalogMovies.toLocaleString()} 部拟合目录电影中只选 10 部。测试按时间隐藏未来评分，模型不能偷看后续交互；这比随机拆分更接近部署，也更难。`:`After removing seen movies, each user receives only ten choices from roughly ${metrics.evaluationPopulation.fittedCatalogMovies.toLocaleString()} fitted-catalog movies. The temporal test hides future ratings, so the model cannot use later interactions; this is more deployment-like and harder than a random split.`}</p></article>
      <article><span>{zh?'数据限制':'Data limitation'}</span><p>{zh?`评分矩阵 ${pct(profile.sparsity)} 为空，共同评分证据有限。${metrics.evaluationPopulation.rankingUsers.toLocaleString()} 位用户共有 ${head.relevantTestRatings.toLocaleString()} 条未来相关评分，平均每人 ${averageRelevant.toFixed(1)} 条；固定十个位置让活跃用户的 Recall 分母更大。User-CF 的 power 用户 Hit Rate 达 ${pct(user.segments.find((s)=>s.segment==='power')!.hitRateAt10)}，但 Recall 仅 ${pct(user.segments.find((s)=>s.segment==='power')!.recallAt10)}，正体现两者不可互换。`:`The matrix is ${pct(profile.sparsity)} empty, leaving limited co-rating support. ${metrics.evaluationPopulation.rankingUsers.toLocaleString()} users have ${head.relevantTestRatings.toLocaleString()} future-relevant ratings, or ${averageRelevant.toFixed(1)} each; ten fixed slots make Recall’s denominator larger for active users. User-CF power users reach ${pct(user.segments.find((s)=>s.segment==='power')!.hitRateAt10)} Hit Rate but only ${pct(user.segments.find((s)=>s.segment==='power')!.recallAt10)} Recall, showing why the metrics are not interchangeable.`}</p></article>
      <article><span>{zh?'模型限制':'Model limitation'}</span><p>{zh?`${pct(head.top20PercentShare)} 的相关测试评分集中在热门度前 20% 的电影，因此 Popularity 排序指标最高，却只覆盖 ${pct(popularity.beyondAccuracy.catalog_coverage)} 的目录。User-CF 与 Item-CF 用准确性换取更高覆盖和长尾曝光。Item-CF 更有具体缺陷：${pct(itemTieStats.fullyTiedListShare)} 的个性化 Top-10 原始分完全并列，${pct(itemFiveStarOnlyShare)} 的条目只由五星历史贡献；并列按 movie ID 排序，而 ID 不包含相关性信息。`:`${pct(head.top20PercentShare)} of relevant test ratings concentrate in the top 20% by popularity, so Popularity leads ranking metrics while covering only ${pct(popularity.beyondAccuracy.catalog_coverage)} of the catalog. User-CF and Item-CF trade accuracy for coverage and tail exposure. Item-CF also has a concrete ranking defect: ${pct(itemTieStats.fullyTiedListShare)} of personalized Top-10 lists have fully tied raw scores and ${pct(itemFiveStarOnlyShare)} of entries use five-star-only evidence; movie-ID tie-breaking contains no relevance signal.`}</p></article>
      <article><span>{zh?'解释边界':'Interpretation boundary'}</span><p>{zh?'MovieLens 没有曝光日志。未命中只表示“Top-10 没有找回用户后来主动评分 ≥4 的电影”，可能还推荐了用户会喜欢但从未接触或评分的电影；因此不能把未命中解释为不喜欢，也不能把 Hit Rate 当作 CTR、观看概率或线上收益。':'MovieLens has no impression log. A miss only means the Top-10 did not retrieve a movie the user later self-rated ≥4; the list may contain unseen movies they would have liked. A miss is not dislike, and Hit Rate is not CTR, watch probability, or online value.'}</p></article>
    </div></div>
    <figure><img src={href('/artifacts/movielens/model-ranking.svg')} width="720" height="396" loading="lazy" alt={zh?'三种 MovieLens 方法的 Hit Rate、NDCG 和 Recall 柱状图':'Hit Rate, NDCG, and Recall bars for three MovieLens methods'} /><figcaption>{zh?'观察：热门基线的三项排序代理最高；User-CF 以较低排序指标换取更高覆盖，Item-CF 覆盖最高但排序代理最低。该结果支持多目标取舍，不支持宣布个性化模型获胜。':'Observation: popularity leads all three ranking proxies; User-CF trades lower ranking metrics for broader coverage, while Item-CF reaches the most catalog with the weakest ranking proxies. This supports a multi-objective trade-off, not a claim that personalization won.'}</figcaption></figure>
  </section>

  <section id="ml-8" class="case-step">
    <p class="step-label">Step 8</p><h2>{copy.evaluationTitle}</h2><p>{copy.evaluation}</p>
    <h3>{zh?'证据支持的结论':'What the evidence supports'}</h3><ul><li>{zh?'热门度是当前协议中最强的排序基线，也是稀疏历史的合理兜底。':'Popularity is the strongest ranking baseline under this protocol and a reasonable sparse-history fallback.'}</li><li>{zh?'User-CF 的 NDCG 较低，但目录覆盖明显更高；是否值得部署需要预先定义多目标规则。':'User-CF has lower NDCG and substantially higher coverage; deployment needs a predefined multi-objective rule.'}</li><li>{zh?'Item-CF 可离线预计算并提供来源电影解释，因此是相关电影候选的工程方案；本实验没有验证该产品页面的用户效果。':'Item-CF can be precomputed and explained through source movies, making it an engineering candidate for related items; this experiment did not validate user impact on that surface.'}</li></ul>
    <aside><h3>{zh?'主要限制':'Primary limitations'}</h3><p>{zh?'评分是自选择且受曝光影响；缺失并非随机。纯 CF 无法处理没有交互的新用户或新电影。MovieLens 1M 年代较早、领域单一，并缺少会话和实时上下文。bootstrap 描述当前用户 cohort 的抽样不确定性，不证明因果效果。':'Ratings are self-selected and exposure-dependent, so missingness is not random. Pure CF cannot solve new-user or new-item cold start. MovieLens 1M is old, single-domain, and lacks session or real-time context. Bootstrap intervals describe sampling uncertainty for this cohort, not causal impact.'}</p></aside>
    <h3>{zh?'排序后的下一步':'Ranked next steps'}</h3><ol><li>{zh?'保留当前并列诊断与证据强度展示；若改变 Item-CF 打分，必须重新走验证选择。':'Keep tie diagnostics and evidence strength visible; any Item-CF scoring change must return to validation selection.'}</li><li>{zh?'在同一时间协议下测试明确的类型内容 + CF 混合规则，并预先定义 NDCG/覆盖取舍。':'Test a defined genre-content plus CF hybrid under the same temporal protocol, with a predeclared NDCG/coverage rule.'}</li><li>{zh?'把 SVD 作为单独的模型化 CF 决策实验，而不是当前页面的附加模型。':'Evaluate SVD as a separate model-based CF decision study, not an extra model on this page.'}</li><li>{zh?'线上按用户随机分流，预先定义播放开始、有效观看、留存、延迟和长尾曝光护栏。':'Run a user-randomized online test with predefined play-start, qualified watch, retention, latency, and tail-exposure guardrails.'}</li></ol>
    <div class="bridge"><a href={href(`/${lang}/projects/spotify-content-recommender/`)}>{zh?'对照 Spotify 内容推荐 →':'Compare with Spotify content recommendation →'}</a></div>
    <details class="reproduction"><summary>{zh?'复现实验与测试命令':'Reproduction and test commands'}</summary><pre><code>{commands}</code></pre><p>{zh?'标准发布检查使用 uv run pytest；仓库还提供确定性的 fallback runner，在受限桌面环境无法正常启动 pytest 时执行同一组现有测试函数。':'The standard release check uses uv run pytest. A deterministic fallback runner executes the same existing test functions if a constrained desktop runtime cannot start pytest normally.'}</p></details>
  </section>

  <section id="ml-9" class="case-step wide-step">
    <p class="step-label">Step 9</p><h2>{copy.labTitle}</h2><p>{copy.lab}</p>
    <MovieLensExplorer client:visible lang={lang} samples={samples} />
  </section>
</div>

