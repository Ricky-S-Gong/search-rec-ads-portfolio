---
import { copy, href, type Lang, type ProjectMeta } from '../data/site';
const { project, lang } = Astro.props as { project: ProjectMeta; lang: Lang };
const t = copy[lang];
const projectHref = project.status === 'complete' ? href(`/${lang}/projects/${project.slug}/`) : href(`/${lang}/roadmap/`);
---
<article class={`project domain-${project.domain}`}>
  <div class="project-top">
    <span class="status"><i></i>{project.status === 'complete' ? t.complete : t.planned}</span>
    <span class="tag">{project.compute}</span>
  </div>
  <div class="project-body">
    <p class="eyebrow">{project.domain}</p>
    <h3><a href={projectHref}>{project.title[lang]}</a></h3>
    <p class="muted">{project.summary[lang]}</p>
  </div>
  <div class="project-meta">
    <p><span>{t.dataset}</span>{project.dataset}</p>
    <div>{project.algorithms.slice(0, 4).map((algorithm) => <span class="tag">{algorithm}</span>)}</div>
  </div>
</article>

<style>
  .project { display: grid; grid-template-columns: 1.1fr 2fr 1.3fr; gap: 1.4rem; padding: 1.35rem 0; border-top: 1px solid var(--line); position: relative; }
  .project::before { content: ''; position: absolute; top: -1px; left: 0; width: 100px; height: 1px; background: var(--domain); }
  .project-top { display: flex; align-items: flex-start; gap: .6rem; }
  .status { display: inline-flex; align-items: center; gap: .4rem; font: .7rem 'IBM Plex Mono', monospace; text-transform: uppercase; color: var(--muted); }
  .status i { width: 7px; aspect-ratio: 1; border-radius: 50%; background: var(--domain); box-shadow: 0 0 12px var(--domain); }
  .project-body { display: grid; gap: .8rem; }
  h3 { font-size: clamp(1.35rem, 2.5vw, 2rem); }
  h3 a { text-decoration: none; }
  .project-meta { display: grid; gap: .8rem; color: var(--muted); font-size: .82rem; }
  .project-meta p span { display: block; color: var(--starlight); font: .68rem 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .project-meta div { display: flex; flex-wrap: wrap; gap: .35rem; }
  @media (max-width: 760px) { .project { grid-template-columns: 1fr; } }
</style>
