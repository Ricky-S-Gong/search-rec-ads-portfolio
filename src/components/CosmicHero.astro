---
import SpaceHeroScene from './cosmos/SpaceHeroScene.astro';
---
<div class="cosmic-hero" data-cosmic-hero aria-hidden="true">
  <SpaceHeroScene />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cosmic-hero]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const host = root.closest<HTMLElement>('.hero') ?? root;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const precisePointer = matchMedia('(pointer: fine)');
    let frame = 0;
    let targetX = 0;
    let targetY = 0;
    const layers = [...root.querySelectorAll<HTMLElement>('[data-depth]')];
    const render = () => {
      layers.forEach((layer) => {
        const depth = Number(layer.dataset.depth || 1);
        const strength = depth === 3 ? 20 : depth === 2 ? 12 : 6;
        layer.style.setProperty('--px', `${targetX * strength}px`);
        layer.style.setProperty('--py', `${targetY * strength}px`);
      });
      frame = 0;
    };
    const onPointerMove = (event: PointerEvent) => {
      if (reduceMotion.matches || !precisePointer.matches) return;
      const bounds = host.getBoundingClientRect();
      targetX = (event.clientX - bounds.left) / bounds.width - .5;
      targetY = (event.clientY - bounds.top) / bounds.height - .5;
      if (!frame) frame = requestAnimationFrame(render);
    };
    const reset = () => { targetX = 0; targetY = 0; if (!frame) frame = requestAnimationFrame(render); };
    const cleanup = () => {
      if (frame) cancelAnimationFrame(frame);
      host.removeEventListener('pointermove', onPointerMove);
      host.removeEventListener('pointerleave', reset);
      reduceMotion.removeEventListener('change', reset);
    };
    host.addEventListener('pointermove', onPointerMove, { passive: true });
    host.addEventListener('pointerleave', reset);
    reduceMotion.addEventListener('change', reset);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>

<style>
  .cosmic-hero{position:absolute;z-index:-3;inset:0;overflow:hidden;pointer-events:none}
</style>
