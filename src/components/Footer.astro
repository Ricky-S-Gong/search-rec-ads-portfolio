---
import { href, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<footer>
  <div class="container footer-grid">
    <p>{lang === 'en' ? 'Search · Ads · Recommendation' : '搜索 · 广告 · 推荐'}</p>
    <p>Ricky Gong · Ziqi Xu · 2026</p>
    <a href="https://github.com/Ricky-S-Gong/search-rec-ads-portfolio">GitHub ↗</a>
    <a href={href(`/${lang}/about/`)}>{lang === 'en' ? 'Credits & licenses' : '署名与许可'}</a>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); padding: 2.5rem 0; color: var(--muted); font: .8rem 'IBM Plex Mono', monospace; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr auto auto; gap: 1rem; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
