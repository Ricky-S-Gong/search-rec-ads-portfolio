<script>
  import { formatKuaiRandMetric } from '../../lib/kuairand-metrics';
  document.querySelectorAll<HTMLElement>('[data-kr-comparison]').forEach(dashboard => {
    const controls = dashboard.querySelector<HTMLElement>('[data-kr-controls]')!;
    const view = dashboard.querySelector<HTMLSelectElement>('[data-kr-view]')!;
    const metric = dashboard.querySelector<HTMLSelectElement>('[data-kr-metric]')!;
    const groups = [...dashboard.querySelectorAll<HTMLElement>('[data-kr-group]')];
    const summary = dashboard.querySelector<HTMLElement>('[data-kr-summary]')!;
    const lang = dashboard.dataset.lang === 'zh' ? 'zh' : 'en';
    const update = () => {
      groups.forEach(group => {
        group.hidden = group.dataset.krGroup !== view.value;
        const rows = [...group.querySelectorAll<HTMLElement>('[data-recall]')];
        const values = rows.map(row => Number(metric.value === 'recall_at_100' ? row.dataset.recall : row.dataset.ndcg));
        rows.forEach((row, i) => {
          row.querySelector<HTMLElement>('.bar-fill')!.style.width = `${values[i] / Math.max(...values) * 100}%`;
          row.querySelector<HTMLElement>('[data-kr-value]')!.textContent = formatKuaiRandMetric(values[i], metric.value, lang);
        });
        group.querySelector('[data-kr-bars]')!.setAttribute('aria-label', `${group.querySelector('h4')!.textContent} ${metric.value === 'recall_at_100' ? 'Recall@100 (%)' : 'NDCG@100'}`);
        if (!group.hidden) {
          const reference = values[0];
          const candidate = values[values.length - 1];
          const fold = (candidate / reference).toFixed(2);
          const delta = metric.value === 'recall_at_100' ? ((candidate - reference) * 100).toFixed(6) : (candidate - reference).toFixed(9);
          const comparison = view.value === 'matched' ? (lang === 'zh' ? '同为第 7 轮，有 logQ 对无 logQ' : 'Matched epoch 7, with vs without logQ') : (lang === 'zh' ? '最佳 logQ 对热门' : 'Best logQ vs popularity');
          summary.textContent = `${comparison}: ${fold}× · +${delta}${metric.value === 'recall_at_100' ? (lang === 'zh' ? ' 个百分点' : ' percentage points') : ' NDCG'}`;
        }
      });
    };
    controls.hidden = false;
    view.addEventListener('change', update);
    metric.addEventListener('change', update);
    update();
  });
</script>
