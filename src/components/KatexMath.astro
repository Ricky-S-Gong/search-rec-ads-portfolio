---
import katex from 'katex';

interface Props {
  latex: string;
  display?: boolean;
  label?: string;
}

const { latex, display = false, label } = Astro.props;
const rendered = katex.renderToString(latex, { displayMode: display, throwOnError: true, output: 'html' });
---
{display
  ? <div class="katex-math-block" role={label ? 'img' : undefined} aria-label={label} set:html={rendered}></div>
  : <span class="katex-math-inline" role={label ? 'img' : undefined} aria-label={label} set:html={rendered}></span>}
