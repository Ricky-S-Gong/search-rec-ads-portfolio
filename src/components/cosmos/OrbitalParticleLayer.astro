---
const clusters = [
  {
    name: 'earth', x: 78, y: 55, tilt: -10, squash: .38,
    particles: [
      { radius: 205, size: 3.2, duration: 24, delay: -3, phase: 18 },
      { radius: 232, size: 2.1, duration: 31, delay: -19, phase: 126 },
      { radius: 264, size: 1.6, duration: 38, delay: -8, phase: 238 },
      { radius: 284, size: 2.5, duration: 43, delay: -31, phase: 304 },
      { radius: 220, size: 1.3, duration: 29, delay: -13, phase: 205 },
    ],
  },
  {
    name: 'saturn', x: 91, y: 6, tilt: 8, squash: .28,
    particles: [
      { radius: 232, size: 2.3, duration: 36, delay: -20, phase: 44 },
      { radius: 276, size: 1.4, duration: 46, delay: -7, phase: 172 },
      { radius: 314, size: 2.8, duration: 52, delay: -39, phase: 286 },
    ],
  },
  {
    name: 'mars', x: 62, y: 29, tilt: -18, squash: .46,
    particles: [
      { radius: 84, size: 2.2, duration: 18, delay: -5, phase: 62 },
      { radius: 108, size: 1.4, duration: 26, delay: -17, phase: 214 },
      { radius: 126, size: 1.8, duration: 32, delay: -9, phase: 318 },
    ],
  },
];
---

<div class="orbital-particle-layer" aria-hidden="true">
  {clusters.map((cluster) => (
    <div
      class={`particle-cluster cluster-${cluster.name}`}
      style={`--cluster-x:${cluster.x}%;--cluster-y:${cluster.y}%;--tilt:${cluster.tilt}deg;--squash:${cluster.squash};`}
    >
      {cluster.particles.map((particle, index) => (
        <span
          class="orbital-particle"
          data-orbital-particle
          data-mobile={index < 2 ? 'keep' : 'hide'}
          style={`--radius:${particle.radius}px;--particle-size:${particle.size}px;--orbit-duration:${particle.duration}s;--orbit-delay:${particle.delay}s;--phase:${particle.phase}deg;`}
        ></span>
      ))}
    </div>
  ))}
</div>

<style>
  .orbital-particle-layer{position:absolute;inset:0;z-index:6;pointer-events:none;mix-blend-mode:screen}
  .particle-cluster{position:absolute;left:var(--cluster-x);top:var(--cluster-y);width:0;height:0;transform:rotate(var(--tilt)) scaleY(var(--squash))}
  .orbital-particle{position:absolute;left:0;top:0;width:var(--particle-size);height:var(--particle-size);margin:calc(var(--particle-size) / -2);border-radius:50%;background:rgba(226,243,255,.86);box-shadow:0 0 5px rgba(150,210,255,.88),0 0 12px rgba(109,94,252,.34);opacity:.48;animation:particle-orbit var(--orbit-duration) linear var(--orbit-delay) infinite;will-change:transform}
  .orbital-particle:nth-child(3n+2){background:rgba(158,218,255,.78);opacity:.34}
  .orbital-particle:nth-child(3n){background:rgba(247,185,85,.72);box-shadow:0 0 6px rgba(247,185,85,.42);opacity:.3}
  @keyframes particle-orbit{from{transform:rotate(var(--phase)) translateX(var(--radius))}to{transform:rotate(calc(var(--phase) + 1turn)) translateX(var(--radius))}}
  @media(max-width:1023px){.particle-cluster{scale:.82}.cluster-saturn{opacity:.7}}
  @media(max-width:767px){.particle-cluster{scale:.56}.cluster-earth{--cluster-x:83%;--cluster-y:23%}.cluster-saturn{--cluster-x:91%;--cluster-y:3%;opacity:.44}.cluster-mars{--cluster-x:67%;--cluster-y:43%;opacity:.42}.orbital-particle[data-mobile="hide"]{display:none}.orbital-particle{opacity:.32}}
  @media(prefers-reduced-motion:reduce){.orbital-particle{animation:none}}
</style>
