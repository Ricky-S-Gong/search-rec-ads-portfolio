---
import { Code } from 'astro:components';
import SpotifyLab from './SpotifyLab';
import KatexMath from './KatexMath.astro';
import { href, type Lang } from '../data/site';
import spotifyMetrics from '../../public/artifacts/spotify/metrics.json';

const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';

const inspectCode = `raw = pd.read_csv(data_path)
tracks = raw.drop_duplicates("id", keep="first").copy()

for column in AUDIO_FEATURES:
    tracks[column] = pd.to_numeric(tracks[column], errors="coerce")
    tracks[column] = tracks[column].fillna(tracks[column].median())`;

const edaCode = `tracks["decade"] = (tracks["year"] // 10 * 10).astype(int)
decade_means = tracks.groupby("decade")[[
    "danceability", "energy", "valence", "acousticness"
]].mean()

decade_means.plot(marker="o")`;

const featureCode = `audio_features = [
    "acousticness", "danceability", "energy",
    "instrumentalness", "liveness", "loudness",
    "speechiness", "tempo", "valence",
]

scaled = MinMaxScaler().fit_transform(tracks[audio_features])
vectors = normalize(scaled)`;

const cosineCode = `def exact_top_k(vectors, query_index, k=10):
    # Normalized vectors: dot product equals cosine similarity.
    scores = vectors @ vectors[query_index]
    scores[query_index] = -np.inf  # never recommend the seed itself

    candidates = np.argpartition(-scores, k)[:k]
    order = np.argsort(-scores[candidates])
    return candidates[order], scores[candidates][order]`;

const popularityCode = `popular = tracks.sort_values(
    ["popularity", "id"], ascending=[False, True]
)
fallback = popular.loc[popular["id"] != seed_id].head(10)`;

const knnCode = `standard = StandardScaler().fit_transform(tracks[audio_features])
knn = NearestNeighbors(metric="euclidean", n_neighbors=11)
knn.fit(standard)

_, indices = knn.kneighbors(standard[[query_index]])
neighbors = indices[0][indices[0] != query_index][:10]`;

const weightedCode = `# W rescales dimensions before cosine similarity.
weighted_seed = weights * seed_vector
weighted_tracks = weights * track_vectors
scores = cosine_similarity(
    weighted_tracks, weighted_seed.reshape(1, -1)
).ravel()`;

const clusterCode = `# Stage 1: assign every song to a coarse region.
kmeans = MiniBatchKMeans(n_clusters=64, random_state=42)
cluster_id = kmeans.fit_predict(scaled)

# Stage 2: calculate cosine similarity only inside the seed cluster.
candidates = np.flatnonzero(cluster_id == cluster_id[query_index])
scores = vectors[candidates] @ vectors[query_index]`;

const evaluateCode = `for query_index in sampled_queries:
    exact, _ = exact_top_k(vectors, query_index)
    approximate, _ = cluster_top_k(vectors, labels, query_index)

    recall_at_10.append(len(set(exact) & set(approximate)) / 10)
    diversity_at_10.append(intra_list_diversity(vectors, exact))
    recommended_items.update(exact)`;

const exactCosineLatex = String.raw`\cos(x,y)=\frac{x^\top y}{\lVert x\rVert_2\lVert y\rVert_2}`;
const weightedCosineLatex = String.raw`\cos_w(x,y)=\frac{(Wx)^\top(Wy)}{\lVert Wx\rVert_2\lVert Wy\rVert_2},\qquad W=\operatorname{diag}(w_1,\ldots,w_d)`;
const standardScalerLatex = String.raw`z_{ij}=\frac{x_{ij}-\mu_j}{\sigma_j}`;
const minMaxLatex = String.raw`m_{ij}=\frac{x_{ij}-x_j^{\min}}{x_j^{\max}-x_j^{\min}}`;
const l2Latex = String.raw`\widehat{x}_i=\frac{m_i}{\lVert m_i\rVert_2},\qquad \lVert m_i\rVert_2=\sqrt{\sum_{j=1}^{d}m_{ij}^2}`;
const euclideanLatex = String.raw`d(x,y)=\sqrt{\sum_{j=1}^{d}(x_j-y_j)^2}`;
const knnLatex = String.raw`N_K(q)=\operatorname{arg\,sort}_{i\ne q}\ d(q,x_i)\ [1{:}K]`;
const clusterRecallLatex = String.raw`\operatorname{Recall@10}=\frac{|A_{10}\cap E_{10}|}{10}`;
const knnOverlapLatex = String.raw`\operatorname{Overlap@10}=\frac{|K_{10}\cap E_{10}|}{10}`;
const diversityLatex = String.raw`\operatorname{Diversity@K}=\frac{2}{K(K-1)}\sum_{i<j}\left(1-\cos(v_i,v_j)\right)`;
const popularityLatex = String.raw`\Delta_{pop}=\overline{p}_{recommended}-\overline{p}_{catalog}`;
const popularityDelta = spotifyMetrics.evaluation.recommendedPopularityMean - spotifyMetrics.evaluation.catalogPopularityMean;

const copy = zh ? {
  nav: ['业务问题', '数据', 'EDA', '特征', '算法', '召回', '结果', '评估与下一步', '交互实验台'],
  problemTitle: '1. 业务问题：在没有行为记录时帮助用户发现音乐',
  problemBody: '音乐目录很大，但新用户没有收听、点赞或跳过记录，系统还不能建立稳定画像。本项目把问题收窄为一个可验证的会话级目标：给定一首种子歌曲，目录中哪些歌曲在可测量的音频属性上最接近，并且为什么相似？',
  conceptTitle: '概念：基于内容的推荐',
  conceptBody: '它根据物品本身的属性进行匹配。在这里，属性是歌曲的 energy、danceability、tempo 等音频特征。它不需要其他用户的点击或收藏记录，因此适合新歌曲冷启动；但它无法仅凭这些属性了解一位新用户的个人口味。',
  coldStartTitle: '新用户如何开始？',
  coldStartBody: '新用户没有收听、点赞或跳过记录，系统无法建立稳定画像。本项目要求用户主动选择一首种子歌，也可以用滑块提供临时的特征偏好。这只是一次会话级起点，只能缓解冷启动，不能替代长期个性化。',
  objective: '输入一首种子歌曲，输出 10 首不同歌曲，并解释相似来自哪些音频特征。',
  dataTitle: '2. 数据：可用信号与缺口',
  dataBody: 'Kaggle 数据包含歌曲属性，但没有用户、曝光、点击、跳过或收藏。这个缺口直接决定了我们只能评价内容相似度与系统效率，不能声称推荐符合用户偏好。',
  dataResult: '读取结果',
  dataResultBody: '170,653 行歌曲记录，年份覆盖 1921–2020；按 Spotify track ID 去重后仍为 170,653 首。九个音频特征的缺失或无效值在缩放前使用各列中位数处理。',
  fieldTitle: '九个模型输入分别表示什么？',
  edaTitle: '3. EDA：检查特征分布与年代变化',
  edaBody: '探索性数据分析（EDA）是在建模前检查数据范围、偏差与异常的过程。这里按年代聚合四个直观特征，判断目录是否存在明显的时间结构。',
  edaAnalysis: '图表说明不同年代的平均音频属性并不稳定。年代本身会影响相似性，因此我们没有把 year 混入主音频向量，而是把它保留为可单独对比的上下文特征。',
  featureTitle: '4. 特征：统一不同量纲',
  featureBody: 'tempo 通常是几十到两百左右，energy 则位于 0–1。如果直接计算距离，tempo 会因为数值范围大而主导结果。MinMaxScaler 把每列映射到 0–1，再把每首歌表示成一个九维向量。',
  vectorTitle: '概念：向量与缩放',
  vectorBody: '向量只是按固定顺序排列的一组数字。例如一首歌可以写成 [danceability, energy, …, valence]。缩放不改变歌曲顺序，只让九个维度拥有可比较的数值范围。',
  normalizeTitle: 'L2 normalization 做什么？',
  normalizeBody: 'MinMaxScaler 先统一每个特征的范围；L2 normalization 再把每首歌的向量长度缩放为 1。完成后，两个向量的点积就等于余弦相似度，因此可以用一次矩阵乘法搜索全部歌曲。',
  scaleSymbols: 'StandardScaler 让每列以 0 为中心、标准差为 1，因此特征不会只因单位较大而支配欧氏距离。MinMaxScaler 保留列内顺序并映射到 0–1，但会受极端值影响。',
  l2Symbols: 'L2 normalization 不再逐列缩放，而是逐首歌曲消除向量总长度，让点积可以直接表示余弦相似度。',
  knnFormulaTitle: '欧氏距离与 KNN 如何选邻居',
