    title: '5. K-Means + cosine：更快但会漏掉近邻',
    body: 'K-Means 先把歌曲分到 64 个粗粒度区域。查询时只保留与种子歌曲同一 cluster 的候选，再用余弦相似度精排。',
    tradeoff: '优点：减少需要打分的歌曲数。限制：硬边界可能把非常接近的歌曲分到不同 cluster，因此速度提升会带来可测量的召回损失。',
    result: `CPU 中位查询延迟从 ${spotifyMetrics.evaluation.exactLatencyMs.toFixed(2)} ms 降至 ${spotifyMetrics.evaluation.clusterLatencyMs.toFixed(2)} ms，同时保留 ${(spotifyMetrics.evaluation.clusterRecallAt10 * 100).toFixed(1)}% 的 Exact Top-10。`,
    complexity: '查询约 O(|C|d)，|C| 为 cluster 大小', code: clusterCode,
  },
] : [
  {
    title: '1. Popularity: fallback with no input',
    body: 'Sorting by popularity returns something when there is no seed track, profile, or behavior. It sits at the system fallback layer rather than inside similarity retrieval.',
    tradeoff: 'Strength: no training, stable, immediately serviceable. Limitation: everyone receives the same list and already-popular tracks gain more exposure.',
    result: 'The experiment treats this as a zero-personalization baseline; its output is not directly compared with cosine “similarity.”',
    complexity: 'O(K) query after pre-sorting', code: popularityCode,
  },
  {
    title: '2. StandardScaler + Euclidean KNN: distance comparison',
    body: 'Euclidean distance measures the straight-line gap between points. StandardScaler first gives every column mean zero and unit variance so tempo or loudness cannot dominate only because of numerical scale.',
    tradeoff: 'Strength: intuitive for absolute feature differences. Limitation: sensitive to outliers and scaling, and still scans the catalog.',
    result: `Median query latency is ${spotifyMetrics.evaluation.euclideanKnnLatencyMs.toFixed(2)} ms. Its Top-10 overlaps exact cosine by ${(spotifyMetrics.evaluation.euclideanOverlapWithCosineAt10 * 100).toFixed(1)}% on average, showing that the distance function materially changes “similar.”`,
    complexity: 'O(Nd) query', code: knnCode,
  },
  {
    title: '3. MinMaxScaler + exact cosine: exact content baseline',
    body: 'After MinMax scaling and L2 normalization, a vector dot product equals cosine similarity. The query scores every catalog track, then keeps the highest ten.',
    tradeoff: 'Strength: deterministic, simple, and explainable. Limitation: full-scan latency and memory bandwidth grow linearly with catalog size.',
    result: `Median CPU query latency is ${spotifyMetrics.evaluation.exactLatencyMs.toFixed(2)} ms over 170,653 tracks. It is the reference for measuring approximate retrieval loss, not ground-truth listener preference.`,
    complexity: 'O(Nd) query', code: cosineCode,
  },
  {
    title: '4. Weighted cosine: let the reader redefine similarity',
    body: 'Sliders enlarge or shrink selected dimensions before cosine is calculated. Raising energy, for example, makes an energy mismatch matter more.',
    tradeoff: 'Strength: makes product preferences visible. Limitation: weights are manually chosen and must not be presented as learned personalization.',
    result: `The browser lab scores a stratified set of ${spotifyMetrics.dataset.demoRows.toLocaleString()} tracks locally and never calls the Spotify API.`,
    complexity: 'O(Nd) demo query', code: weightedCode,
  },
  {
    title: '5. K-Means + cosine: faster, with missed neighbors',
    body: 'K-Means first assigns tracks to 64 coarse regions. A query keeps only tracks in the seed’s cluster, then reranks those candidates with cosine similarity.',
    tradeoff: 'Strength: fewer tracks need scoring. Limitation: hard boundaries can split very close tracks, so speed creates measurable retrieval loss.',
    result: `Median CPU latency falls from ${spotifyMetrics.evaluation.exactLatencyMs.toFixed(2)} ms to ${spotifyMetrics.evaluation.clusterLatencyMs.toFixed(2)} ms while preserving ${(spotifyMetrics.evaluation.clusterRecallAt10 * 100).toFixed(1)}% of the exact Top-10.`,
    complexity: 'About O(|C|d), where |C| is cluster size', code: clusterCode,
  },
];

const metricDefinitions: MetricDefinition[] = [
  {
    key: 'latency', label: { en: 'Median query latency', zh: '查询延迟中位数' },
    variables: { en: 'Measured milliseconds per sampled query on the recorded CPU environment.', zh: '在记录的 CPU 环境中，对抽样查询测量每次计算的毫秒数。' },
    intuition: { en: 'Half of measured queries are faster and half are slower.', zh: '一半查询更快，另一半更慢；中位数不容易被极端值带偏。' },
    businessMeaning: { en: 'A systems-cost comparison only. Production still needs P95/P99 latency, concurrency, and index-memory measurements.', zh: '它只比较系统计算成本。生产环境仍需测量 P95/P99、并发与索引内存。' },
  },
  {
    key: 'clusterRecall', label: { en: 'Cluster Recall@10', zh: 'Cluster Recall@10' }, latex: String.raw`\operatorname{Recall@10}=\frac{|A_{10}\cap E_{10}|}{10}`,
    variables: { en: 'A₁₀ is the K-Means candidate Top-10; E₁₀ is the exact-cosine Top-10.', zh: 'A₁₀ 是 K-Means 候选 Top-10，E₁₀ 是精确余弦 Top-10。' },
    intuition: { en: 'It counts how many exact neighbors survive approximate retrieval.', zh: '它计算精确近邻中有多少仍被近似召回保留。' },
    businessMeaning: { en: 'Useful for choosing a speed–fidelity operating point. It is not relevance recall and says nothing about listener enjoyment.', zh: '用于选择速度—保真度平衡点；它不是相关性召回，也不能说明用户是否喜欢。' },
  },
  {
    key: 'knnOverlap', label: { en: 'KNN overlap@10', zh: 'KNN 重合率@10' }, latex: String.raw`\operatorname{Overlap@10}=\frac{|K_{10}\cap E_{10}|}{10}`,
    variables: { en: 'K₁₀ is Euclidean KNN; E₁₀ is exact cosine.', zh: 'K₁₀ 是欧氏 KNN 结果，E₁₀ 是精确余弦结果。' },
    intuition: { en: 'Low overlap means the distance choice changes which tracks count as similar.', zh: '重合率低说明距离函数会明显改变哪些歌曲被认为相似。' },
    businessMeaning: { en: 'A sensitivity check for modeling choices, not a winner-versus-loser quality score.', zh: '它用于检查模型选择敏感性，不是判断推荐质量输赢的分数。' },
  },
  {
    key: 'diversity', label: { en: 'Diversity@10', zh: 'Diversity@10' }, latex: String.raw`\operatorname{Diversity@K}=\frac{2}{K(K-1)}\sum_{i<j}\left(1-\cos(v_i,v_j)\right)`,
    variables: { en: 'vᵢ and vⱼ are recommended-track vectors; K is list length.', zh: 'vᵢ 与 vⱼ 是推荐歌曲向量，K 是列表长度。' },
    intuition: { en: 'Average pairwise cosine distance: larger means the list spans more varied audio profiles.', zh: '它是列表内两两余弦距离的平均值；越大表示音频特征越多样。' },
    businessMeaning: { en: 'Flags overly narrow lists, but more diversity is not automatically more relevant.', zh: '用于发现过窄列表，但多样性更高并不自动代表更相关。' },
  },
  {
    key: 'popularity', label: { en: 'Popularity bias', zh: '热门度偏差' }, latex: String.raw`\Delta_{pop}=\overline{p}_{recommended}-\overline{p}_{catalog}`,
    variables: { en: 'p is Spotify popularity; the two means cover recommended tracks and the catalog.', zh: 'p 是 Spotify popularity，两项均值分别来自推荐结果与全目录。' },
    intuition: { en: 'A positive difference favors popular tracks; a negative one leans toward less-popular tracks.', zh: '差值为正表示偏热门，为负表示结果更偏向非热门歌曲。' },
    businessMeaning: { en: 'A directional exposure audit, not proof of fairness or satisfaction.', zh: '它只做曝光方向审计，不能证明公平性或满意度。' },
  },
];

const fields = zh ? [
  ['acousticness', '原声乐器程度'], ['danceability', '适合舞动的程度'], ['energy', '强度与活力'],
  ['instrumentalness', '无歌词器乐的可能性'], ['liveness', '现场录音的可能性'], ['loudness', '整体响度'],
  ['speechiness', '口语内容程度'], ['tempo', '每分钟节拍数'], ['valence', '音乐情绪的积极程度'],
] : [
  ['acousticness', 'likelihood of acoustic sound'], ['danceability', 'rhythmic suitability for dancing'], ['energy', 'perceived intensity and activity'],
  ['instrumentalness', 'likelihood of having no vocals'], ['liveness', 'likelihood of a live recording'], ['loudness', 'overall volume in decibels'],
  ['speechiness', 'presence of spoken words'], ['tempo', 'estimated beats per minute'], ['valence', 'musical positivity'],
];
---

<nav class="case-nav" aria-label={zh ? '项目章节' : 'Case study sections'}>
  {copy.nav.map((item, index) => <a href={`#step-${index + 1}`}>{index + 1}. {item}</a>)}
</nav>

<div class="case-study">
  <section id="step-1" class="case-step">
    <p class="step-label">Step 1</p><h2>{copy.problemTitle}</h2><p>{copy.problemBody}</p>
    <aside><h3>{copy.conceptTitle}</h3><p>{copy.conceptBody}</p></aside>
    <aside class="cold-start"><h3>{copy.coldStartTitle}</h3><p>{copy.coldStartBody}</p></aside>
    <div class="output"><strong>{zh ? '系统目标' : 'System objective'}</strong><p>{copy.objective}</p></div>
  </section>

  <section id="step-2" class="case-step">
    <p class="step-label">Step 2</p><h2>{copy.dataTitle}</h2><p>{copy.dataBody}</p>
    <div class="code-block"><Code code={inspectCode} lang="python" theme="github-dark" /></div>
    <div class="output"><strong>{copy.dataResult}</strong><p>{copy.dataResultBody}</p></div>
    <h3>{copy.fieldTitle}</h3>
    <dl class="field-grid">{fields.map(([name, meaning]) => <div><dt>{name}</dt><dd>{meaning}</dd></div>)}</dl>
  </section>

  <section id="step-3" class="case-step">
    <p class="step-label">Step 3</p><h2>{copy.edaTitle}</h2><p>{copy.edaBody}</p>
    <div class="code-block"><Code code={edaCode} lang="python" theme="github-dark" /></div>
    <figure><img src={href('/artifacts/spotify/feature-trends.svg')} width="720" height="396" loading="lazy" alt={zh ? 'Spotify 歌曲按年代统计的平均音频特征折线图' : 'Line chart of average Spotify audio features by decade'} /><figcaption>{copy.edaAnalysis}</figcaption></figure>
  </section>

  <section id="step-4" class="case-step">
    <p class="step-label">Step 4</p><h2>{copy.featureTitle}</h2><p>{copy.featureBody}</p>
    <aside><h3>{copy.vectorTitle}</h3><p>{copy.vectorBody}</p></aside>
    <div class="scaling-formulas">
      <div class="formula-explanation"><h3>StandardScaler</h3><div class="formula" aria-label="StandardScaler formula" set:html={math(standardScalerLatex)}></div></div>
      <div class="formula-explanation"><h3>MinMaxScaler</h3><div class="formula" aria-label="MinMaxScaler formula" set:html={math(minMaxLatex)}></div></div>
    </div>
    <p class="symbol-guide">{copy.scaleSymbols}</p>
    <div class="code-block"><Code code={featureCode} lang="python" theme="github-dark" /></div>
    <aside><h3>{copy.normalizeTitle}</h3><p>{copy.normalizeBody}</p></aside>
    <div class="formula-explanation"><div class="formula" aria-label="L2 normalization formula" set:html={math(l2Latex)}></div><p>{copy.l2Symbols}</p></div>
  </section>

  <section id="step-5" class="case-step">
    <p class="step-label">Step 5</p><h2>{copy.algorithmTitle}</h2><p>{copy.algorithmBody}</p>
    <div class="formula-explanation"><h3>{copy.exactFormulaTitle}</h3><div class="formula" aria-label="Exact cosine similarity formula" set:html={math(exactCosineLatex)}></div><p>{copy.exactFormulaBody}</p></div>
    <div class="code-block"><Code code={cosineCode} lang="python" theme="github-dark" /></div>
    <div class="formula-explanation"><h3>{copy.weightedFormulaTitle}</h3><div class="formula" aria-label="Weighted cosine similarity formula" set:html={math(weightedCosineLatex)}></div><p>{copy.weightedFormulaBody}</p></div>
    <aside><h3>{copy.whyTitle}</h3><p>{copy.whyBody}</p></aside>
  </section>

  <section id="step-6" class="case-step">
    <p class="step-label">Step 6</p><h2>{copy.candidatesTitle}</h2><p>{copy.candidatesBody}</p>
    <div class="formula-explanation"><h3>{copy.knnFormulaTitle}</h3><div class="formula-stack"><div class="formula" aria-label="Euclidean distance formula" set:html={math(euclideanLatex)}></div><div class="formula" aria-label="K nearest neighbors selection formula" set:html={math(knnLatex)}></div></div><p>{copy.knnFormulaBody}</p></div>
    <div class="method-cards">
      {methodCards.map((method) => (
        <article class="method-card">
          <div class="method-copy"><h3>{method.title}</h3><p>{method.body}</p><p><strong>{zh ? '取舍：' : 'Trade-off: '}</strong>{method.tradeoff}</p><div class="method-result"><span>{zh ? '实验结果' : 'Observed result'}</span><p>{method.result}</p></div><small>{method.complexity}</small></div>
          <div class="code-block"><Code code={method.code} lang="python" theme="github-dark" /></div>
        </article>
      ))}
    </div>
    <h3>{copy.methodsTitle}</h3>
    <div class="method-table" role="region" tabindex="0"><table><thead><tr><th>{zh ? '方法' : 'Method'}</th><th>{zh ? '为什么加入' : 'Why included'}</th><th>{zh ? '主要限制' : 'Main limitation'}</th></tr></thead><tbody>
      <tr><th>Popularity</th><td>{zh ? '没有种子或行为信号时兜底' : 'Fallback when no seed or behavior exists'}</td><td>{zh ? '没有个性化' : 'No personalization'}</td></tr>
      <tr><th>Euclidean KNN</th><td>{zh ? '比较绝对特征距离' : 'Compare absolute feature distance'}</td><td>{zh ? '高度依赖特征缩放' : 'Highly sensitive to scaling'}</td></tr>
      <tr><th>Cosine</th><td>{zh ? '主精确内容相似基线' : 'Primary exact content baseline'}</td><td>{zh ? '目录扩大后全量扫描变慢' : 'Full scans slow as the catalog grows'}</td></tr>
      <tr><th>Weighted cosine</th><td>{zh ? '允许用户控制关注的特征' : 'Let users control important features'}</td><td>{zh ? '权重需要用户理解特征' : 'Controls require feature understanding'}</td></tr>
      <tr><th>K-Means + cosine</th><td>{zh ? '展示延迟与召回损失权衡' : 'Expose the latency–recall trade-off'}</td><td>{zh ? '聚类边界会漏掉近邻' : 'Cluster boundaries miss neighbors'}</td></tr>
    </tbody></table></div>
  </section>

  <section id="step-7" class="case-step wide-step">
    <p class="step-label">Step 7</p><h2>{copy.resultTitle}</h2><p>{copy.resultBody}</p>
    <div class="code-block narrow"><Code code={evaluateCode} lang="python" theme="github-dark" /></div>
    <MetricsPanel client:visible lang={lang} />
    <h3>{copy.metricDetailsTitle}</h3>
    <div class="metric-definitions">
      {metricDefinitions.map((metric) => (
        <article>
          <h4>{metric.label[lang]}</h4>
          {metric.latex && <div class="formula compact" set:html={math(metric.latex)}></div>}
          <dl>
            <div><dt>{zh ? '变量 / 定义' : 'Variables / definition'}</dt><dd>{metric.variables[lang]}</dd></div>
            <div><dt>{zh ? '直觉' : 'Intuition'}</dt><dd>{metric.intuition[lang]}</dd></div>
            <div><dt>{zh ? '业务意义与限制' : 'Business meaning and limit'}</dt><dd>{metric.businessMeaning[lang]}</dd></div>
          </dl>
        </article>
      ))}
    </div>
    <figure><img src={href('/artifacts/spotify/feature-space.svg')} width="720" height="432" loading="lazy" alt={zh ? '按 K-Means 聚类着色的 Spotify 音频特征 PCA 投影' : 'PCA projection of Spotify audio features colored by K-Means cluster'} /><figcaption><strong>{copy.pcaTitle}</strong> {copy.pcaBody}</figcaption></figure>
  </section>

  <section id="step-8" class="case-step">
    <p class="step-label">Step 8</p><h2>{copy.evaluationTitle}</h2><p>{copy.evaluationBody}</p>
    <h3>{copy.onlineTitle}</h3><ul>{copy.onlineItems.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section id="step-9" class="case-step">
    <p class="step-label">Step 9</p><h2>{copy.improveTitle}</h2><p>{copy.improveBody}</p>
  </section>

  <section class="case-step wide-step">
    <p class="step-label">Step 10</p><h2>{copy.labTitle}</h2><p>{copy.labBody}</p>
    <SpotifyLab client:visible lang={lang} />
  </section>

  <section class="case-step">
    <p class="step-label">Step 11</p><h2>{copy.reproduceTitle}</h2><p>{copy.reproduceBody}</p>
    <div class="code-block"><Code code={'uv run python research/spotify-music/run_experiment.py --data <path-to-data.csv>'} lang="bash" theme="github-dark" /></div>
    <p>{zh ? '代码与实验：Ricky Gong、Ziqi Xu。具体所有权通过 Issue 和 Pull Request 持续记录。' : 'Code and experiments: Ricky Gong and Ziqi Xu. Detailed ownership is tracked through Issues and Pull Requests.'}</p>
  </section>
</div>

<style>
  .case-nav { position: sticky; top: 68px; z-index: 5; display: flex; gap: .35rem; width: min(calc(100% - 2rem), var(--max)); margin: 0 auto 2rem; padding: .65rem; overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; background: rgba(7,17,31,.94); }
  .case-nav a { flex: 0 0 auto; padding: .35rem .55rem; color: var(--muted); font: .7rem 'IBM Plex Mono', monospace; text-decoration: none; }
  .case-nav a:hover { color: var(--starlight); }
  .case-study { width: min(calc(100% - 2rem), 880px); margin-inline: auto; }
  .case-step { display: grid; gap: 1.15rem; padding: 4.5rem 0; border-top: 1px solid var(--line); scroll-margin-top: 130px; }
  .case-step h2 { font-size: clamp(1.7rem, 4vw, 2.55rem); }
  .case-step h3 { margin-top: .8rem; font-size: 1.15rem; }
  .case-step > p, .case-step li { color: var(--muted); font-size: 1.02rem; }
  .step-label { color: var(--rec) !important; font: .72rem 'IBM Plex Mono', monospace !important; text-transform: uppercase; }
  aside, .output { padding: 1.1rem 1.2rem; border-left: 3px solid var(--search); background: rgba(53,208,226,.06); }
  aside h3, .output strong { display: block; margin: 0 0 .35rem; }
  aside p, .output p { color: var(--muted); }
  .output { border-left-color: var(--complete); background: rgba(85,217,139,.06); }
  .cold-start { border-left-color: var(--ads); background: rgba(247,185,85,.06); }
  .code-block { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; }
  .code-block :global(pre) { margin: 0 !important; padding: 1rem !important; overflow-x: auto; font-size: .83rem; }
  .formula { padding: 1.2rem; overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; color: var(--starlight); background: var(--deep); font: clamp(.92rem, 2vw, 1.18rem) 'IBM Plex Mono', monospace; text-align: center; }
  .formula :global(.katex-display) { margin: .25rem 0; }
  .formula-explanation { display: grid; gap: .75rem; }
  .formula-explanation > p { color: var(--muted); }
  .scaling-formulas, .formula-stack { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .symbol-guide { color: var(--muted); font-size: .92rem; }
  .field-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 0; border: 1px solid var(--line); background: var(--line); }
  .field-grid div { padding: .85rem; background: var(--deep); }
  .field-grid dt { color: var(--starlight); font: .76rem 'IBM Plex Mono', monospace; }
  .field-grid dd { margin: .35rem 0 0; color: var(--muted); font-size: .86rem; }
  figure { margin: .4rem 0 0; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: var(--deep); }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { padding: .9rem 1rem; color: var(--muted); border-top: 1px solid var(--line); font-size: .88rem; }
  .method-table { overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; }
  .method-cards { display: grid; gap: 1rem; }
  .method-card { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; padding: 1rem; border: 1px solid var(--line); border-radius: 16px; background: rgba(12,27,48,.6); }
  .method-card .code-block { width: 100%; min-width: 0; }
  .method-copy { display: grid; align-content: start; gap: .75rem; }
  .method-copy h3 { margin: 0; }
  .method-copy p { color: var(--muted); font-size: .94rem; }
  .method-copy strong { color: var(--starlight); }
  .method-copy > small { color: var(--search); font: .7rem 'IBM Plex Mono', monospace; }
  .method-result { padding: .8rem; border-left: 2px solid var(--complete); background: rgba(85,217,139,.05); }
  .method-result span { color: var(--complete); font: .66rem 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .method-result p { margin-top: .25rem; }
  .metric-definitions { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .metric-definitions > article { display: grid; align-content: start; gap: .8rem; padding: 1rem; border: 1px solid var(--line); border-radius: 14px; background: var(--deep); }
  .metric-definitions h4 { margin: 0; font-size: 1rem; }
  .formula.compact { padding: .75rem; font-size: .82rem; }
  .formula.compact :global(.katex) { font-size: .95em; }
  .metric-definitions dl { display: grid; gap: .65rem; margin: 0; }
  .metric-definitions dl div { display: grid; gap: .15rem; }
  .metric-definitions dt { color: var(--rec); font: .65rem 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .metric-definitions dd { margin: 0; color: var(--muted); font-size: .84rem; }
  table { width: 100%; min-width: 680px; border-collapse: collapse; }
  th, td { padding: .8rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; font-size: .85rem; }
  thead th { color: var(--muted); font: .68rem 'IBM Plex Mono', monospace; text-transform: uppercase; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  ul { margin: 0; padding-left: 1.2rem; }
  li + li { margin-top: .45rem; }
  @media (max-width: 760px) { .metric-definitions, .scaling-formulas, .formula-stack { grid-template-columns: 1fr; } }
  @media (max-width: 650px) { .field-grid { grid-template-columns: 1fr 1fr; } .case-step { padding-block: 3.5rem; } .formula { text-align: left; } }
  @media (max-width: 430px) { .field-grid { grid-template-columns: 1fr; } }
</style>
