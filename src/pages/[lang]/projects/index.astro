---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { copy, languages, projects, type Lang } from '../../../data/site';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang; const t = copy[lang];
---
<BaseLayout lang={lang} title={`${t.nav.projects} — ${t.siteName}`} description={t.projectsIntro} path="/projects/">
  <section class="section container"><div class="section-heading"><p class="eyebrow">Portfolio evidence</p><h1>{t.nav.projects}</h1><p class="muted">{t.projectsIntro}</p></div>{projects.map((project) => <ProjectCard project={project} lang={lang} />)}</section>
</BaseLayout>
<style>h1{font-size:clamp(2.5rem,7vw,5.5rem)}</style>
