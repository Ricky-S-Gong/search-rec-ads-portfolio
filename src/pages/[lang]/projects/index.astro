---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import { copy, languages, type Lang } from '../../../data/site';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang; const t = copy[lang];
---
<BaseLayout lang={lang} title={`${t.nav.projects} — ${t.siteName}`} description={t.projectsIntro} path="/projects/">
  <section class="section container"><div class="section-heading"><h1>{t.nav.projects}</h1><p class="muted">{t.projectsIntro}</p></div><ProjectTabs lang={lang} /></section>
</BaseLayout>
<style>h1{font-size:clamp(2.5rem,7vw,5.5rem)}</style>
