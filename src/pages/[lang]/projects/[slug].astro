---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SpotifyCaseStudy from '../../../components/SpotifyCaseStudy.astro';
import { copy, domainNames, languages, projects, type Lang } from '../../../data/site';
export const getStaticPaths = () => languages.flatMap((lang) => projects.filter((p) => p.status === 'complete').map((project) => ({ params: { lang, slug: project.slug }, props: { project } })));
const lang = Astro.params.lang as Lang;
const { project } = Astro.props;
const t = copy[lang];
---
<BaseLayout lang={lang} title={`${project.title[lang]} — ${t.siteName}`} description={project.summary[lang]} path={`/projects/${project.slug}/`}>
  <article>
    <header class="project-hero container">
      <div><p class="eyebrow">{domainNames[project.domain][lang]} / Content-based / CPU</p><h1>{project.title[lang]}</h1><p class="lede">{project.summary[lang]}</p></div>
      <dl><div><dt>{lang === 'en' ? 'Catalog' : '歌曲目录'}</dt><dd>170,653</dd></div><div><dt>{lang === 'en' ? 'Behavior signal' : '行为信号'}</dt><dd>{lang === 'en' ? 'None' : '无'}</dd></div><div><dt>{lang === 'en' ? 'GPU' : 'GPU'}</dt><dd>{lang === 'en' ? 'Not needed' : '不需要'}</dd></div></dl>
    </header>
    <SpotifyCaseStudy lang={lang} />
  </article>
</BaseLayout>
<style>
  .project-hero{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:3rem;align-items:end;padding-block:clamp(4rem,9vw,7rem)}.project-hero>div{display:grid;gap:1.2rem}.project-hero h1{font-size:clamp(2.4rem,6vw,5rem);white-space:nowrap}.lede{max-width:760px;color:var(--muted);font-size:1.15rem}.project-hero dl{margin:0;border-left:1px solid var(--line)}.project-hero dl div{padding:.85rem 1rem;border-bottom:1px solid var(--line)}dt{color:var(--muted);font:.68rem 'IBM Plex Mono',monospace;text-transform:uppercase}dd{margin:.25rem 0 0;font-weight:600}@media(max-width:780px){.project-hero{grid-template-columns:1fr}.project-hero h1{white-space:normal}.project-hero dl{border-left:0}}
</style>
