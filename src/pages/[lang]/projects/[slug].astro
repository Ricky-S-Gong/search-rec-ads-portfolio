---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SpotifyCaseStudy from '../../../components/SpotifyCaseStudy.astro';
import MovieLensCaseStudy from '../../../components/MovieLensCaseStudy.astro';
import { copy, domainNames, href, languages, projects, type Lang } from '../../../data/site';
import spotifyMetrics from '../../../../public/artifacts/spotify/metrics.json';
import movielensProfile from '../../../../public/artifacts/movielens/profile.json';
export const getStaticPaths = () => languages.flatMap((lang) => projects.filter((p) => p.status === 'complete').map((project) => ({ params: { lang, slug: project.slug }, props: { project } })));
const lang = Astro.params.lang as Lang;
const { project } = Astro.props;
const t = copy[lang];
const metrics = spotifyMetrics.evaluation;
const isMovieLens = project.slug === 'movielens-collaborative-filtering';
const starSummary = isMovieLens ? (lang === 'zh'
  ? `我们用 ${movielensProfile.profile.ratings.toLocaleString()} 条带时间的电影评分回答一个直观问题：相似的人，或相似的电影，能否帮助用户发现下一部喜欢的电影？实验严格隐藏每位用户较晚的评分再测试。结果不是单一“胜者”：热门榜在准确性上很强，个性化方法则把推荐扩展到更多电影。`
  : `We use ${movielensProfile.profile.ratings.toLocaleString()} time-stamped movie ratings to ask a simple question: can similar people—or similar movies—help someone discover what they may like next? Later ratings are hidden before testing. There is no single “winner”: popularity is strong on accuracy, while personalized methods spread recommendations across much more of the catalog.`) : (lang === 'zh'
  ? `当用户没有收听、点赞或跳过记录时，音乐目录很难提供个性化发现。核心业务问题是：给定一首种子歌曲，如何从 ${spotifyMetrics.dataset.deduplicatedRows.toLocaleString()} 首歌曲中找到可解释的内容相似候选？本项目用 9 项音频特征构建会话级冷启动方案；CPU 实验将查询延迟从 ${metrics.exactLatencyMs.toFixed(2)} ms 降至 ${metrics.clusterLatencyMs.toFixed(2)} ms，同时保留 ${(metrics.clusterRecallAt10 * 100).toFixed(1)}% 的 Exact Top-10，但不把该结果解释为真实用户偏好。`
  : `Without plays, likes, or skips, a music catalog cannot yet personalize discovery. The business question is narrower: given one seed track, how can the system find explainable content-similar candidates among ${spotifyMetrics.dataset.deduplicatedRows.toLocaleString()} tracks? This session-level cold-start approach uses nine audio features; on CPU, median query latency fell from ${metrics.exactLatencyMs.toFixed(2)} ms to ${metrics.clusterLatencyMs.toFixed(2)} ms while preserving ${(metrics.clusterRecallAt10 * 100).toFixed(1)}% of the exact Top-10, without treating that agreement as listener preference.`);
---
<BaseLayout lang={lang} title={`${project.title[lang]} — ${t.siteName}`} description={project.summary[lang]} path={`/projects/${project.slug}/`}>
  <article>
    <header class="project-hero container">
      <div class="hero-heading">
        <div class="hero-copy"><p class="eyebrow">{domainNames[project.domain][lang]} / {isMovieLens ? 'Collaborative filtering' : 'Content-based'} / CPU</p><div class="brand-title">{!isMovieLens && <img class="spotify-logo" src={href('/images/brands/spotify-icon-green.svg')} width="58" height="54" alt="Spotify" />}<h1>{project.title[lang]}</h1></div><p class="lede">{starSummary}</p></div>
      </div>
      <div class="hero-facts">
        <article><span>{lang === 'en' ? 'Dataset' : '数据集'}</span><strong>{isMovieLens ? `${movielensProfile.profile.ratings.toLocaleString()} ${lang === 'en' ? 'ratings' : '条评分'}` : `${spotifyMetrics.dataset.deduplicatedRows.toLocaleString()} ${lang === 'en' ? 'tracks' : '首歌曲'}`}</strong><p>{isMovieLens ? `${movielensProfile.profile.users.toLocaleString()} ${lang === 'en' ? 'users' : '位用户'} · ${movielensProfile.profile.ratedMovies.toLocaleString()} ${lang === 'en' ? 'rated movies' : '部有评分电影'}` : `${spotifyMetrics.dataset.yearRange.join('–')} · ${Object.keys(spotifyMetrics.dataset.featureProfile).length} ${lang === 'en' ? 'audio features' : '项音频特征'}`}</p></article>
        <article><span>{lang === 'en' ? 'Data source' : '数据来源'}</span><strong>{isMovieLens ? 'GroupLens MovieLens 1M' : 'Kaggle Spotify Dataset'}</strong>{project.sourceUrl && <a class="source-link" href={project.sourceUrl} target="_blank" rel="noreferrer">{isMovieLens ? 'GroupLens' : 'Kaggle'} Source <span aria-hidden="true">↗</span></a>}</article>
        <article><span>{lang === 'en' ? 'Core idea' : '核心思路'}</span><strong>{isMovieLens ? (lang === 'en' ? 'Learn from shared taste' : '从共同偏好中学习') : (lang === 'en' ? 'Exact cosine Top-10' : '精确余弦 Top-10')}</strong><p>{isMovieLens ? (lang === 'en' ? 'Compare similar users and similar movies, with a popularity fallback when history is thin.' : '分别比较相似用户与相似电影；历史不足时回退热门榜。') : (lang === 'en' ? 'Median fill → MinMax → L2. KNN and K-Means are comparisons.' : '中位数填补 → MinMax → L2；KNN 与 K-Means 仅作对照。')}</p></article>
      </div>
    </header>
    {isMovieLens ? <MovieLensCaseStudy lang={lang} /> : <SpotifyCaseStudy lang={lang} />}
  </article>
</BaseLayout>
<style>
  .project-hero{display:grid;gap:clamp(2rem,5vw,3.5rem);padding-block:clamp(4rem,9vw,7rem)}.hero-heading{display:block}.hero-copy{display:grid;gap:1.2rem}.brand-title{display:flex;align-items:center;gap:clamp(.8rem,1.5vw,1.2rem);min-width:0}.spotify-logo{flex:0 0 auto;width:clamp(46px,4.3vw,62px);height:auto}.project-hero h1{max-width:none;font-size:clamp(2.3rem,4.1vw,3.65rem);letter-spacing:-.035em;overflow-wrap:normal;white-space:nowrap}.lede{max-width:1050px;color:var(--muted);font-size:clamp(1rem,1.8vw,1.14rem)}.hero-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.hero-facts article{display:grid;align-content:start;gap:.55rem;min-height:180px;padding:1.2rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,rgba(16,36,61,.88),rgba(7,17,31,.94))}.hero-facts span{color:var(--rec);font:var(--meta-title-size) 'IBM Plex Mono',monospace;text-transform:uppercase}.hero-facts strong{font-size:1.05rem}.hero-facts p{color:var(--muted);font-size:.9rem}.source-link{justify-self:start;margin-top:.25rem;padding:.55rem .8rem;border:1px solid var(--line);border-radius:999px;color:var(--starlight);font:.72rem 'IBM Plex Mono',monospace;text-decoration:none}.source-link:hover,.source-link:focus-visible{border-color:var(--search);color:var(--search)}@media(max-width:780px){.brand-title{align-items:flex-start}.spotify-logo{width:48px;margin-top:.25rem}.project-hero h1{max-width:14ch;font-size:clamp(2.05rem,10vw,3.1rem);overflow-wrap:anywhere;white-space:normal}.hero-facts{grid-template-columns:1fr}.hero-facts article{min-height:0}}
</style>
