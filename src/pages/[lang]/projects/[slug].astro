---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SpotifyCaseStudy from '../../../components/SpotifyCaseStudy.astro';
import { copy, domainNames, href, languages, projects, type Lang } from '../../../data/site';
import spotifyMetrics from '../../../../public/artifacts/spotify/metrics.json';
export const getStaticPaths = () => languages.flatMap((lang) => projects.filter((p) => p.status === 'complete').map((project) => ({ params: { lang, slug: project.slug }, props: { project } })));
const lang = Astro.params.lang as Lang;
const { project } = Astro.props;
const t = copy[lang];
const metrics = spotifyMetrics.evaluation;
const starSummary = lang === 'zh'
  ? `在缺少用户行为的音乐目录中，我们需要从 ${spotifyMetrics.dataset.deduplicatedRows.toLocaleString()} 首歌曲中找到可解释的相似曲目。我们用 9 项音频特征构建内容推荐，并比较全量余弦与 K-Means 候选召回；CPU 实验将查询延迟从 ${metrics.exactLatencyMs.toFixed(2)} ms 降至 ${metrics.clusterLatencyMs.toFixed(2)} ms，同时保留 ${(metrics.clusterRecallAt10 * 100).toFixed(1)}% 的 Exact Top-10。`
  : `With no listener behavior, we needed explainable similar tracks from a catalog of ${spotifyMetrics.dataset.deduplicatedRows.toLocaleString()}. We built content retrieval from nine audio features and compared exact cosine with K-Means candidates; on CPU, median query latency fell from ${metrics.exactLatencyMs.toFixed(2)} ms to ${metrics.clusterLatencyMs.toFixed(2)} ms while preserving ${(metrics.clusterRecallAt10 * 100).toFixed(1)}% of the exact Top-10.`;
---
<BaseLayout lang={lang} title={`${project.title[lang]} — ${t.siteName}`} description={project.summary[lang]} path={`/projects/${project.slug}/`}>
  <article>
    <header class="project-hero container">
      <div class="hero-heading">
        <div class="hero-copy"><p class="eyebrow">{domainNames[project.domain][lang]} / Content-based / CPU</p><h1>{project.title[lang]}</h1><p class="lede">{starSummary}</p></div>
        <img class="spotify-logo" src={href('/images/brands/spotify-full-white.svg')} width="148" height="41" alt="Spotify" />
      </div>
      <div class="hero-facts">
        <article><span>{lang === 'en' ? 'Dataset' : '数据集'}</span><strong>{spotifyMetrics.dataset.deduplicatedRows.toLocaleString()} {lang === 'en' ? 'tracks' : '首歌曲'}</strong><p>{spotifyMetrics.dataset.yearRange.join('–')} · {Object.keys(spotifyMetrics.dataset.featureProfile).length} {lang === 'en' ? 'audio features' : '项音频特征'}</p></article>
        <article><span>{lang === 'en' ? 'Data source' : '数据来源'}</span><strong>Kaggle Spotify Dataset</strong>{project.sourceUrl && <a class="source-link" href={project.sourceUrl} target="_blank" rel="noreferrer">Kaggle Source <span aria-hidden="true">↗</span></a>}</article>
        <article><span>{lang === 'en' ? 'Core algorithm' : '核心算法'}</span><strong>{lang === 'en' ? 'Exact cosine Top-10' : '精确余弦 Top-10'}</strong><p>{lang === 'en' ? 'Median fill → MinMax → L2. KNN and K-Means are comparisons.' : '中位数填补 → MinMax → L2；KNN 与 K-Means 仅作对照。'}</p></article>
      </div>
    </header>
    <SpotifyCaseStudy lang={lang} />
  </article>
</BaseLayout>
<style>
  .project-hero{display:grid;gap:clamp(2rem,5vw,3.5rem);padding-block:clamp(4rem,9vw,7rem)}.hero-heading{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:2rem}.hero-copy{display:grid;gap:1.2rem}.spotify-logo{width:clamp(96px,11vw,148px);height:auto;margin-top:.2rem}.project-hero h1{max-width:18ch;font-size:clamp(2.25rem,5vw,4.35rem);overflow-wrap:anywhere}.lede{max-width:900px;color:var(--muted);font-size:clamp(1rem,1.8vw,1.14rem)}.hero-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.hero-facts article{display:grid;align-content:start;gap:.55rem;min-height:180px;padding:1.2rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,rgba(16,36,61,.88),rgba(7,17,31,.94))}.hero-facts span{color:var(--rec);font:var(--meta-title-size) 'IBM Plex Mono',monospace;text-transform:uppercase}.hero-facts strong{font-size:1.05rem}.hero-facts p{color:var(--muted);font-size:.9rem}.source-link{justify-self:start;margin-top:.25rem;padding:.55rem .8rem;border:1px solid var(--line);border-radius:999px;color:var(--starlight);font:.72rem 'IBM Plex Mono',monospace;text-decoration:none}.source-link:hover,.source-link:focus-visible{border-color:var(--search);color:var(--search)}@media(max-width:780px){.hero-heading{grid-template-columns:1fr}.spotify-logo{grid-row:1;margin-bottom:.2rem}.project-hero h1{max-width:14ch;font-size:clamp(2.1rem,11vw,3.25rem)}.hero-facts{grid-template-columns:1fr}.hero-facts article{min-height:0}}
</style>
