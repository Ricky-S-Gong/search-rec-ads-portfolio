---
import { Code } from 'astro:components';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import KatexMath from '../../../components/KatexMath.astro';
import { algorithms, copy, domainNames, href, languages, type Lang } from '../../../data/site';

export const getStaticPaths = () => {
  const algorithm = algorithms.find((item) => item.slug === 'content-based-filtering')!;
  return languages.map((lang) => ({ params: { lang, slug: algorithm.slug }, props: { algorithm } }));
};

const lang = Astro.params.lang as Lang;
const { algorithm } = Astro.props;
const zh = lang === 'zh';
const t = copy[lang];
const normalizeLatex = String.raw`\hat v_i=\frac{v_i}{\lVert v_i\rVert_2}`;
const profileLatex = String.raw`u=\frac{\sum_{i\in I_u}\alpha_{ui}\hat v_i}{\sum_{i\in I_u}\alpha_{ui}}`;
const cosineLatex = String.raw`s(u,\hat v_j)=\frac{u^\top\hat v_j}{\lVert u\rVert_2\lVert\hat v_j\rVert_2}`;
const code = `import numpy as np
from sklearn.preprocessing import MinMaxScaler, normalize

# One row per item; columns can describe text, category, image,
# audio, tags, or other structured attributes.
scaled_features = MinMaxScaler().fit_transform(feature_matrix)
item_vectors = normalize(scaled_features)

def build_user_profile(item_vectors, liked_item_indices, interaction_weights):
    liked_vectors = item_vectors[liked_item_indices]
    user = np.average(liked_vectors, axis=0, weights=interaction_weights)
    norm = np.linalg.norm(user)
    return user / norm if norm else user

def recommend(user, item_vectors, seen_item_indices, k=10):
    scores = item_vectors @ user
    scores[seen_item_indices] = -np.inf
    candidates = np.argpartition(-scores, k)[:k]
    return candidates[np.argsort(-scores[candidates])], scores[candidates]

user = build_user_profile(
    item_vectors,
    liked_item_indices,
    interaction_weights,
)
recommended_items, scores = recommend(
    user,
    item_vectors,
    seen_item_indices=liked_item_indices,
)`;

const page = zh ? {
  summary: '基于内容的推荐利用物品本身的属性建立向量，再把用户已经喜欢的物品聚合成画像，为每位用户寻找属性相近的新物品。',
  problemTitle: '问题',
  problem: '当系统拥有物品信息，却只有很少用户互动时，热门榜单无法表达个人偏好，协同过滤也缺少足够的共同使用记录。我们需要直接利用“物品是什么”来开始推荐。',
  intuitionTitle: '直觉',
  intuition: '先把书籍、商品、文章、电影或歌曲描述成一组可比较的属性。再把用户喜欢过的物品放在一起，形成一张临时兴趣地图。候选物品越靠近这张地图，越值得被召回。',
  dataTitle: '数据',
  data: '物品向量可以来自文本的 TF-IDF 或 embedding、类别与标签的 one-hot、图像或音频 embedding，以及价格、时长等结构化属性。不同来源必须清洗、编码和缩放，避免某个数值范围较大的特征无意中主导相似度。用户画像还需要点赞、收藏、长时间观看等正向互动，以及表示强弱的权重。',
  algorithmTitle: '算法',
  codeTitle: '代码',
  codeIntro: '下面是与具体行业无关的最小实现。feature_matrix 只要求“每行一个物品、每列一个特征”；liked_item_indices 和 interaction_weights 来自用户行为。代码先建立画像，再排除看过的物品并取 Top-K。',
  limitsTitle: '局限',
  limits: ['新物品只要有属性就能进入候选，但完全没有行为的新用户仍然没有画像。', '结果容易围绕既有兴趣反复推荐，过度相似会降低探索性。', '画像需要随时间更新；旧行为权重过高会掩盖兴趣变化。', '推荐上限受特征质量限制，未编码的语义、风格或社会影响不会自动出现。', '有足够用户—物品交互后，应加入协同过滤；同时需要内容冷启动与行为个性化时，应使用混合推荐。'],
  project: '查看 Spotify 物品到物品实例',
} : {
  summary: 'Content-based recommendation represents items with their own attributes, then aggregates items a user valued into a profile and retrieves new items with similar attributes.',
  problemTitle: 'Problem',
  problem: 'When item information is rich but user interaction is sparse, popularity lists are not personal and collaborative filtering lacks shared behavior. The system needs a way to start from what each item is.',
  intuitionTitle: 'Intuition',
  intuition: 'Describe books, products, articles, films, or tracks with comparable attributes. Combine the items a person valued into a temporary map of their interests. Candidate items closer to that map are stronger retrieval choices.',
  dataTitle: 'Data',
  data: 'Item vectors may combine TF-IDF or text embeddings, category and tag encodings, image or audio embeddings, and structured attributes such as price or duration. These sources need cleaning, encoding, and scaling so a large numeric range does not dominate accidentally. A user profile also needs positive actions—likes, saves, or long engagement—and weights that express their strength.',
  algorithmTitle: 'Algorithm',
  codeTitle: 'Code',
  codeIntro: 'This minimal implementation is domain-independent. feature_matrix only requires one item per row and one feature per column; liked_item_indices and interaction_weights come from behavior. It builds a profile, removes seen items, and returns Top-K.',
  limitsTitle: 'Limitations',
  limits: ['A new item can enter once it has attributes, but a new user with no action still has no profile.', 'Results can remain too close to known interests, reducing discovery and novelty.', 'Profiles need time-aware updates; old interactions can hide changing taste.', 'Quality is bounded by the features—missing meaning, style, or social influence does not appear automatically.', 'With sufficient user–item interaction, add collaborative filtering; use a hybrid when both content cold start and behavioral personalization matter.'],
  project: 'See the Spotify item-to-item example',
};
---

<BaseLayout lang={lang} title={`${algorithm.name[lang]} — ${t.siteName}`} description={page.summary} path={`/algorithms/${algorithm.slug}/`}>
  <article class="section reading-container algorithm-page">
    <header><p class="eyebrow">{domainNames[algorithm.domain][lang]} · {algorithm.family[lang]}</p><h1>{algorithm.name[lang]}</h1><p>{page.summary}</p></header>
    <section><span>01</span><h2>{page.problemTitle}</h2><p>{page.problem}</p></section>
    <section><span>02</span><h2>{page.intuitionTitle}</h2><p>{page.intuition}</p></section>
    <section><span>03</span><h2>{page.dataTitle}</h2><p>{page.data}</p></section>
    <section>
      <span>04</span><h2>{page.algorithmTitle}</h2>
      <p>{zh ? <>首先把第 <KatexMath latex="i" /> 个物品向量 <KatexMath latex="v_i" /> 归一化为单位长度。然后对用户 <KatexMath latex="u" /> 的物品集合 <KatexMath latex="I_u" /> 做加权平均；<KatexMath latex="\alpha_{ui}" /> 表示互动强度。最后用余弦相似度为候选排序。</> : <>First normalize item vector <KatexMath latex="v_i" /> to unit length. Then average the set <KatexMath latex="I_u" /> for user <KatexMath latex="u" />, weighted by interaction strength <KatexMath latex="\alpha_{ui}" />. Finally rank candidates with cosine similarity.</>}</p>
      <div class="formula-set"><KatexMath latex={normalizeLatex} display label={zh ? '物品向量 L2 归一化公式' : 'Item vector L2 normalization formula'} /><KatexMath latex={profileLatex} display label={zh ? '用户画像加权平均公式' : 'Weighted user profile formula'} /><KatexMath latex={cosineLatex} display label={zh ? '用户与候选物品余弦相似度公式' : 'User-to-item cosine similarity formula'} /></div>
    </section>
    <section><span>05</span><h2>{page.codeTitle}</h2><p>{page.codeIntro}</p><div class="code-block"><Code code={code} lang="python" theme="github-dark" /></div></section>
    <section><span>06</span><h2>{page.limitsTitle}</h2><ul class="card-points">{page.limits.map((limit) => <li>{limit}</li>)}</ul></section>
    <a class="button" href={href(`/${lang}/projects/spotify-content-recommender/`)}>{page.project}</a>
  </article>
</BaseLayout>

<style>
  .algorithm-page { display: grid; gap: 0; }
  header { display: grid; gap: 1.2rem; padding-bottom: 3.5rem; }
  h1 { font-size: var(--title-page-size); }
  header > p:last-child { max-width: 780px; color: var(--muted); font-size: clamp(1.05rem,1.5vw,1.22rem); }
  section { display: grid; gap: 1rem; padding: 3rem 0; border-top: 1px solid var(--line); }
  section > span { color: var(--rec); font: var(--meta-title-size) 'IBM Plex Mono', monospace; }
  section h2 { font-size: var(--title-step-size); }
  section p, li { max-width: 800px; color: var(--muted); font-size: clamp(1rem,1.2vw,1.08rem); }
  .formula-set { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .formula-set :global(.katex-math-block:last-child) { grid-column: 1 / -1; }
  .code-block { max-width: 100%; overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; background: var(--deep); }
  .code-block :global(pre) { margin: 0 !important; padding: 1.1rem !important; overflow-x: auto; font-size: .86rem; }
  .button { justify-self: start; margin-top: 2rem; }
  @media (max-width: 680px) { .formula-set { grid-template-columns: 1fr; }.formula-set :global(.katex-math-block:last-child) { grid-column: auto; } }
</style>
