---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { copy, href, languages, type Lang } from '../../data/site';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = copy[lang];
---
<BaseLayout lang={lang} title={`${t.siteName} — Ricky Gong & Ziqi Xu`} description={t.heroBody} path="/">
  <section class="hero container">
    <div class="orbit-map" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
    <div class="hero-copy">
      <h1>{t.heroTitle}</h1>
      <p class="lede">{t.heroBody}</p>
      <div class="button-row"><a class="button" href={href(`/${lang}/projects/spotify-content-recommender/`)}>{t.explore}</a><a class="button secondary" href={href(`/${lang}/compare/`)}>{t.compare}</a></div>
    </div>
  </section>
  <section class="projects-section container">
    <div class="section-heading"><h2>{t.projectsTitle}</h2><p class="muted">{t.projectsIntro}</p></div>
    <ProjectTabs lang={lang} />
  </section>
  <section class="section algorithm-link">
    <div class="container algorithm-link-inner">
      <div><h2>{t.decisionTitle}</h2><p class="muted">{t.decisionIntro}</p></div>
      <a class="button secondary" href={href(`/${lang}/compare/`)}>{t.compare}</a>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { position: relative; isolation: isolate; display: grid; align-content: center; min-height: min(780px, calc(100vh - 68px)); padding-block: clamp(5rem, 11vw, 8.5rem); }
  .hero::before { content: ''; position: absolute; z-index: -2; inset: 0 calc(50% - 50vw); background:
    radial-gradient(circle at 72% 35%, rgba(167,139,250,.3) 0 1px, transparent 2px),
    radial-gradient(circle at 16% 22%, rgba(237,245,255,.8) 0 1px, transparent 1.5px),
    radial-gradient(circle at 62% 70%, rgba(53,208,226,.7) 0 1px, transparent 1.5px),
    radial-gradient(circle at 92% 78%, rgba(247,185,85,.7) 0 1px, transparent 1.5px);
    background-size: 73px 79px, 113px 127px, 149px 139px, 191px 173px;
    mask-image: linear-gradient(to bottom, black 70%, transparent); opacity: .72; animation: star-drift 28s linear infinite;
  }
  .hero-copy { position: relative; z-index: 2; display: grid; gap: 1.35rem; max-width: 900px; }
  .hero h1 { max-width: 980px; font-size: clamp(3rem, 7vw, 6rem); }
  :global(html[lang='en']) .hero h1 { max-width: 18ch; font-size: clamp(2.75rem, 5.8vw, 5rem); line-height: .98; }
  .lede { max-width: 760px; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.35rem); }
  .orbit-map { position: absolute; z-index: -1; top: 50%; right: -10%; width: min(48vw, 590px); aspect-ratio: 1; translate: 0 -50%; opacity: .82; filter: drop-shadow(0 0 42px rgba(167,139,250,.18)); }
  .orbit-map::before { content: ''; position: absolute; inset: 18%; border-radius: 50%; background: radial-gradient(circle, rgba(237,245,255,.92) 0 1.5%, rgba(167,139,250,.42) 2%, rgba(167,139,250,.08) 18%, transparent 52%); box-shadow: 0 0 90px rgba(167,139,250,.28); }
  .orbit-map i { position: absolute; inset: 14%; border: 1px solid rgba(53,208,226,.45); border-radius: 50%; rotate: -18deg; }
  .orbit-map i:nth-child(2) { inset: 25% 4%; border-color: rgba(167,139,250,.5); rotate: 34deg; }
  .orbit-map i:nth-child(3) { inset: 4% 28%; border-color: rgba(247,185,85,.45); rotate: 72deg; }
  .orbit-map i::after { content: ''; position: absolute; top: 11%; left: 17%; width: 8px; aspect-ratio: 1; border-radius: 50%; background: currentColor; box-shadow: 0 0 18px currentColor; }
  .orbit-map i:first-child { color: var(--search); }.orbit-map i:nth-child(2) { color: var(--rec); }.orbit-map i:nth-child(3) { color: var(--ads); }
  .orbit-map span { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(ellipse at 60% 45%, rgba(53,208,226,.11), transparent 50%), radial-gradient(ellipse at 35% 60%, rgba(247,185,85,.08), transparent 48%); filter: blur(14px); }
  .projects-section { padding-bottom: clamp(4rem, 9vw, 8rem); }
  .algorithm-link { border-top: 1px solid var(--line); background: rgba(12,27,48,.38); }
  .algorithm-link-inner { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .algorithm-link-inner > div { display: grid; gap: 1rem; max-width: 760px; }
  @keyframes star-drift { to { background-position: 73px 79px, -113px 127px, 149px -139px, -191px -173px; } }
  @media (max-width: 700px) {
    .hero { min-height: 650px; overflow: hidden; }
    .hero h1, :global(html[lang='en']) .hero h1 { max-width: 16ch; font-size: clamp(2.3rem, 11vw, 3.25rem); }
    .orbit-map { top: 32%; right: -45%; width: 92vw; opacity: .48; }
    .algorithm-link-inner { align-items: start; flex-direction: column; }
  }
</style>
