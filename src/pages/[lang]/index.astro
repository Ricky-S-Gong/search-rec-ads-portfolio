---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import CosmicHero from '../../components/CosmicHero.astro';
import { copy, href, languages, type Lang } from '../../data/site';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = copy[lang];
---
<BaseLayout lang={lang} title={`${t.siteName} — Ricky Gong & Ziqi Xu`} description={t.heroBody} path="/">
  <section class="hero">
    <CosmicHero />
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{t.heroTitle}</h1>
        <p class="lede">{t.heroBody}</p>
        <div class="domain-buttons" aria-label={lang === 'en' ? 'Browse projects by domain' : '按方向浏览项目'}>
          <a class="domain-button search" href="#projects" data-home-domain="search">{t.domainCtas.search}</a>
          <a class="domain-button ads" href="#projects" data-home-domain="ads">{t.domainCtas.ads}</a>
          <a class="domain-button recommendation" href="#projects" data-home-domain="recommendation">{t.domainCtas.recommendation}</a>
        </div>
      </div>
    </div>
  </section>
  <section id="projects" class="projects-section container">
    <div class="section-heading"><h2>{t.projectsTitle}</h2><p class="muted">{t.projectsIntro}</p></div>
    <ProjectTabs lang={lang} />
  </section>
  <section class="section algorithm-link">
    <div class="container algorithm-link-inner">
      <div><h2>{t.decisionTitle}</h2><p class="muted">{t.decisionIntro}</p></div>
      <div class="algorithm-buttons" aria-label={lang === 'en' ? 'Browse algorithms by domain' : '按方向查看算法'}>
        <a class="algorithm-button search" href={href(`/${lang}/compare/?domain=search`)}>{t.algorithmCtas.search}</a>
        <a class="algorithm-button ads" href={href(`/${lang}/compare/?domain=ads`)}>{t.algorithmCtas.ads}</a>
        <a class="algorithm-button recommendation" href={href(`/${lang}/compare/?domain=recommendation`)}>{t.algorithmCtas.recommendation}</a>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-home-domain]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const domain = link.dataset.homeDomain;
      const tab = document.querySelector<HTMLButtonElement>(`[data-project-tabs] [data-domain="${domain}"]`);
      const projects = document.querySelector<HTMLElement>('#projects');
      if (!tab || !projects) return;
      event.preventDefault();
      tab.click();
      projects.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      tab.focus({ preventScroll: true });
    });
  });
</script>
<style>
  .hero { position: relative; isolation: isolate; display: grid; align-content: center; width: 100%; min-height: min(820px, calc(100vh - 68px)); overflow: clip; }
  .hero::after { content: ''; position: absolute; z-index: -1; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(7,17,31,.98) 0%, rgba(7,17,31,.9) 38%, rgba(7,17,31,.28) 76%, rgba(7,17,31,.58) 100%), linear-gradient(0deg, var(--void), transparent 30%); }
  .hero-inner { padding-block: clamp(5rem, 11vw, 8.5rem); }
  .hero-copy { position: relative; z-index: 2; display: grid; gap: 1.35rem; max-width: 900px; text-shadow: 0 2px 28px rgba(7,17,31,.9); }
  .hero h1 { max-width: 980px; font-size: clamp(3rem, 7vw, 6rem); }
  :global(html[lang='en']) .hero h1 { max-width: none; font-size: clamp(3rem, 6.2vw, 5.5rem); line-height: .98; white-space: nowrap; }
  .lede { max-width: 760px; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.35rem); }
  .domain-buttons { display: flex; flex-wrap: wrap; gap: .65rem; }
  .domain-button { --button-domain: var(--search); display: inline-flex; align-items: center; gap: .55rem; min-height: 46px; padding: .7rem 1rem; border: 1px solid color-mix(in srgb, var(--button-domain) 55%, var(--line)); border-radius: 999px; color: var(--starlight); background: color-mix(in srgb, var(--button-domain) 11%, rgba(7,17,31,.78)); box-shadow: inset 0 0 22px color-mix(in srgb, var(--button-domain) 6%, transparent); font-weight: 600; text-decoration: none; }
  .domain-button::before { content: ''; width: 7px; aspect-ratio: 1; border-radius: 50%; background: var(--button-domain); box-shadow: 0 0 12px var(--button-domain); }
  .domain-button:hover, .domain-button:focus-visible { color: white; background: color-mix(in srgb, var(--button-domain) 20%, rgba(7,17,31,.72)); translate: 0 -2px; }
  .domain-button.ads { --button-domain: var(--ads); }.domain-button.recommendation { --button-domain: var(--rec); }
  .projects-section { padding-bottom: clamp(4rem, 9vw, 8rem); }
  #projects { scroll-margin-top: 92px; }
  .algorithm-link { border-top: 1px solid var(--line); background: rgba(12,27,48,.38); }
  .algorithm-link { padding-block: clamp(2.8rem,5vw,4.6rem); }
  .algorithm-link-inner { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .algorithm-link-inner > div { display: grid; gap: 1rem; max-width: 760px; }
  .algorithm-buttons { display:flex!important;flex-wrap:wrap;justify-content:flex-end;gap:.65rem;max-width:560px!important; }
  .algorithm-button { --algorithm-color:var(--search);display:inline-flex;align-items:center;min-height:48px;padding:.7rem 1rem;border:1px solid color-mix(in srgb,var(--algorithm-color) 58%,var(--line));border-radius:999px;color:var(--starlight);background:color-mix(in srgb,var(--algorithm-color) 10%,rgba(7,17,31,.82));font-size:.9rem;font-weight:600;text-decoration:none;white-space:nowrap; }
  .algorithm-button::after { content:'→';margin-left:.55rem;color:var(--algorithm-color); }
  .algorithm-button.ads{--algorithm-color:var(--ads)}.algorithm-button.recommendation{--algorithm-color:var(--rec)}
  .algorithm-button:hover,.algorithm-button:focus-visible{background:color-mix(in srgb,var(--algorithm-color) 19%,rgba(7,17,31,.8));translate:0 -2px}
  @media (max-width: 700px) {
    .hero { min-height: 700px; }
    .hero h1, :global(html[lang='en']) .hero h1 { max-width: 16ch; font-size: clamp(2.3rem, 11vw, 3.25rem); white-space: normal; }
    .hero::after { background: linear-gradient(0deg, rgba(7,17,31,.98) 0%, rgba(7,17,31,.82) 46%, rgba(7,17,31,.24) 82%, rgba(7,17,31,.55) 100%); }
    .domain-buttons { display: grid; align-items: start; justify-items: start; }
    .algorithm-link-inner { align-items: start; flex-direction: column; }
    .algorithm-buttons { justify-content:flex-start; }
  }
</style>
