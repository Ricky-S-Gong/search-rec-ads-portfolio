---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, href, languages, profiles, type Lang } from '../../data/site';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = copy[lang];
---

<BaseLayout lang={lang} title={`${t.nav.about} — ${t.siteName}`} description={t.byline} path="/about/">
  <section class="section container about">
    <div class="section-heading">
      <h1>{t.nav.about}</h1>
      <p class="muted">{t.byline}</p>
    </div>

    <div class="crew">
      {profiles.map((profile, index) => (
        <article>
          <div class="portrait">
            <img src={href(profile.photo)} width={index === 0 ? 1365 : 1616} height={index === 0 ? 2048 : 1080} loading={index === 0 ? 'eager' : 'lazy'} alt={profile.photoAlt[lang]} />
          </div>
          <div class="profile-copy">
            <h2>{profile.name}</h2>
            <ul class="profile-details"><li>{profile.school[lang]} · {profile.major[lang]}</li><li>{profile.industryRole[lang]}</li></ul>
            <div class="contacts">
              <a href={profile.linkedin} target="_blank" rel="noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.5 8.2H3.2V21h3.3V8.2ZM4.9 3A1.9 1.9 0 1 0 5 6.8 1.9 1.9 0 0 0 5 3Zm8 5.2H9.8V21H13v-6.3c0-1.7.3-3.3 2.4-3.3 2 0 2.1 1.9 2.1 3.4V21h3.3v-7c0-3.5-.8-6.1-4.8-6.1-1.9 0-3.1 1-3.6 1.9h-.1V8.2h.6Z"/></svg>LinkedIn</a>
              <a href={profile.github} target="_blank" rel="noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.2 19.5v-2.3c-2.7.6-3.3-1.1-3.3-1.1-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.8.8.1-.6.4-1.1.7-1.3-2.1-.2-4.4-1.1-4.4-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.6 0 3.6-2.3 4.5-4.4 4.7.4.3.7.9.7 1.8v3.1A10 10 0 0 0 12 2Z"/></svg>GitHub</a>
              <a href={`mailto:${profile.email}`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5h18v14H3V5Zm9 7.1L5.4 7H18.6L12 12.1ZM5 17h14V8.9l-7 5.4-7-5.4V17Z"/></svg>{lang === 'en' ? 'Email' : '邮箱'}</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="license">{lang === 'en' ? 'Code: MIT · Original writing and charts: CC BY 4.0 · Third-party data retains its original terms.' : '代码：MIT · 原创文字与图表：CC BY 4.0 · 第三方数据遵循其原始许可。'}</p>
  </section>
</BaseLayout>

<style>
  .about { max-width: 1120px; }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); }
  .crew { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 3vw, 2rem); }
  .crew article { display:grid;justify-items:center;padding-top:clamp(1.4rem,3vw,2rem);overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(16,36,61,.92),rgba(7,17,31,.96)); }
  .portrait { width:clamp(150px,16vw,180px);aspect-ratio:1;overflow:hidden;border:1px solid var(--line);border-radius:50%;background:var(--deep);box-shadow:0 0 38px rgba(167,139,250,.12); }
  .portrait img { width:100%;height:100%;object-fit:cover; }
  .crew article:first-child .portrait img{object-position:50% 58%}.crew article:nth-child(2) .portrait img{object-position:62% 44%}
  .profile-copy { display: grid; gap: .55rem; padding: clamp(1.2rem, 3vw, 1.7rem); }
  .profile-copy h2 { font-size: clamp(1.55rem, 3vw, 2.2rem); }
  .profile-details{display:grid;gap:.5rem;margin:.35rem 0 0;padding-left:1.1rem;color:var(--muted);font-size:.92rem}
  .contacts { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .65rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .contacts a { display: inline-flex; align-items: center; justify-content: center; gap:.4rem;min-height:42px;padding:.58rem .85rem;border:1px solid var(--line);border-radius:999px;color:var(--starlight);background:rgba(7,17,31,.62);font:.72rem/1.2 'IBM Plex Mono',monospace;text-decoration:none}.contacts svg{width:16px;height:16px;fill:currentColor;flex:none}
  .contacts a:hover, .contacts a:focus-visible { border-color: var(--search); color: var(--search); background: rgba(53,208,226,.07); }
  .license { margin-top: 2.5rem; color: var(--muted); font: .76rem/1.6 'IBM Plex Mono', monospace; }
  @media (max-width: 720px) {
    .crew { grid-template-columns: 1fr; }
    .portrait { width:clamp(132px,38vw,150px); }
  }
</style>
