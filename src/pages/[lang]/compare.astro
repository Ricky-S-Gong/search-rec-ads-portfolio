---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlgorithmTabs from '../../components/AlgorithmTabs.astro';
import { copy, languages, type Lang } from '../../data/site';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang; const t = copy[lang];
---
<BaseLayout lang={lang} title={`${t.nav.compare} — ${t.siteName}`} description={t.decisionIntro} path="/compare/">
  <section class="section container"><div class="section-heading"><h1>{t.nav.compare}</h1><p class="muted">{t.decisionIntro}</p></div><AlgorithmTabs lang={lang} /></section>
</BaseLayout>
<style>
  h1{font-size:clamp(2.5rem,7vw,5.5rem)}
</style>
